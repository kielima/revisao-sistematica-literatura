@article{ WOS:000861258000011,
Author = {Araujo Prado, Julia Espindula and Fujiwara, Flora Lyn and Contreras,
   Francisco and Silva, Victor},
Title = {Analysis of greenhouse gas emissions from co-processing of solid waste
   in a cement industry},
Journal = {REVISTA TECNOLOGIA E SOCIEDADE},
Year = {2022},
Volume = {18},
Number = {53},
Month = {OCT-DEC},
Abstract = {Cement plants are responsible for approximately 3\% of the world's
   Greenhouse Gas (GHG) emissions and for approximately 5\% of carbon
   dioxide (CO2) emissions. One of the alternatives used to reduce GHG
   emissions in the cement industry is the use of alternative fuels through
   the co-processing of Solid Waste (RS) and the use of biomass. This study
   aims to analyze the mitigation of GHG emissions from a cement plant in
   the Federal District, based on the use of alternative fuels, focusing on
   the co-processing of RS in the cement production process. The
   methodology used was the Life Cycle Assessment (LCA) with the impact
   category climate change. It was concluded that, among the analyzed
   scenarios, the one corresponding to the use of 70\% of petroleum coke
   and 30\% of Solid Waste Agrossilvopastoral (RSA) is the best alternative
   for generating heat in clinker kilns from the point of view of
   emissions. of GHG.},
