@article{ WOS:000411490000017,
Author = {Lu, Junfu and Xue, Xiaoqiang},
Title = {RESEARCH ON THE CLASSIFICATION OF LIFE-CYCLE SAFETY MONITORING LEVELS OF
   SUBSEA TUNNELS},
Journal = {POLISH MARITIME RESEARCH},
