@article{ WOS:000721045200004,
Author = {Teixeira, E. R. and Camoes, A. and Branco, F. G.},
Title = {Synergetic effect of biomass fly ash on improvement of high-volume coal
   fly ash concrete properties},
Journal = {CONSTRUCTION AND BUILDING MATERIALS},
Year = {2022},
Volume = {314},
Number = {A},
Month = {JAN 3},
Abstract = {Sustainable construction is high on the agenda, especially regarding
   building materials. Using of by-products or waste materials from other
   economic sectors as cement replacement material in concrete production
   seems to be a more sustainable option than applying ordinary Portland
   cement concrete. The main aim of this work was to evaluate the
   performance of biomass fly ash (BFA) when used as cement replacement
   material and as an alkalinity reserve material in high-volume fly ash
   concrete (HVFAC). Therefore, several compositions of concrete including
   BFA were tested for compressive strength, water absorption, accelerated
   carbonation, and chloride penetration resistance. It was noted that when
   small amounts of BFA were used, HVFAC properties were improved, compared
   with a high-volume coal fly ash concrete. These new concrete mixtures
   showed a positive contribution to the quality, durability and
   sustainability of HVFAC.},
