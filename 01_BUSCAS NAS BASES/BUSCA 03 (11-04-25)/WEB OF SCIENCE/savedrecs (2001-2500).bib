Title = {Incremental Modal Pushover Analysis (IMPA) for bridges},
Booktitle = {BRIDGE MAINTENANCE, SAFETY, MANAGEMENT, LIFE-CYCLE SUSTAINABILITY AND
   INNOVATIONS},
Year = {2021},
