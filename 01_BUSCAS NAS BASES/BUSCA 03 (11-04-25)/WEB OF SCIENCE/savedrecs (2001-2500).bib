Title = {Eco-efficiency assessment of conventional OPC/PPC replacement by LC3 in
   Cuban residential buildings},
Booktitle = {SUSTAINABLE BUILT ENVIRONMENT D-A-CH CONFERENCE 2019 (SBE19 GRAZ)},
