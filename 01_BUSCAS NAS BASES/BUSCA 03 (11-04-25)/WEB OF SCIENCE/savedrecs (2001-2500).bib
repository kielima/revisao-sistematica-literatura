@article{ WOS:000513232100001,
Author = {Oumnih, Safae and Bekkouch, Nadia and Gharibi, El Khadir and Fagel,
   Nathalie and Elhamouti, Kamal and El Ouahabi, Meriam},
Title = {Phosphogypsum waste as additives to lime stabilization of bentonite},
