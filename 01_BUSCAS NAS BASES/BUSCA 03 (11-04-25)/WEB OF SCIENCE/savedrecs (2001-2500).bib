   and Somodikova, Martina and Lipowczan, Martin and Slowik, Ondrej and
   Dolezel, Jiri and Pukl, Radomir and Sattler, Fabian and Apostolidi,
   Eftychia},
Editor = {Strauss, A and Bergmeister, K},
Title = {Nonlinear probabilistic structural assessment: Findings from Austrian
   and Czech bridges},
Booktitle = {EUROPEAN ASSOCIATION ON QUALITY CONTROL OF BRIDGES AND STRUCTURES,
   EUROSTRUCT 2023, VOL 6, ISS 5},
