@article{ WOS:000291802000010,
Author = {Kayo, Chihiro and Hashimoto, Seiji and Numata, Atsunori and Hamada,
   Masanori},
Title = {Reductions in greenhouse gas emissions by using wood to protect against
   soil liquefaction},
Journal = {JOURNAL OF WOOD SCIENCE},
