   Purnell, Phil, Univ Leeds, Sch Civil Engn, Leeds LS2 9JT, W Yorkshire, England.},
DOI = {10.1016/j.enpol.2019.02.019},
ISSN = {0301-4215},
EISSN = {1873-6777},
Keywords = {Biomass; Carbon accounting; Circular economy; Coal ash; Concrete;
   Resource recovery},
Keywords-Plus = {LIFE-CYCLE ASSESSMENT; RESOURCE RECOVERY; COCOMBUSTION; BIOENERGY;
