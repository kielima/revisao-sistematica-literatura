@inproceedings{ WOS:000280762001313,
Author = {Mendes, J. Marco and Restivo, Francisco and Leitao, Paulo and Colombo,
   Armando W.},
Book-Group-Author = {IEEE},
Title = {Customizable Service-oriented Petri Net Controllers},
Booktitle = {IECON: 2009 35TH ANNUAL CONFERENCE OF IEEE INDUSTRIAL ELECTRONICS, VOLS
   1-6},
