Title = {A HOLISTIC APPROACH FOR INSPECTION OF CIVIL INFRASTRUCTURES BASED ON
   COMPUTER VISION TECHNIQUES},
Booktitle = {XXIII ISPRS CONGRESS, COMMISSION V},
