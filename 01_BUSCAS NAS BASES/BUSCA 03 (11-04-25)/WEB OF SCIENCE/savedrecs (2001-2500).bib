@inproceedings{ WOS:001175738300002,
Author = {Selway, Matt and Stumptner, Markus and Mayer, Wolfgang},
Editor = {Neuhaus, F and Brodaric, B},
Title = {Towards Formalisation of Concept Descriptions and Constraints},
Booktitle = {FORMAL ONTOLOGY IN INFORMATION SYSTEMS},
