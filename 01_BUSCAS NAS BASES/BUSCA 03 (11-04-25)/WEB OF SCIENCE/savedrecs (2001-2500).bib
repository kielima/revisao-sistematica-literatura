Title = {Towards autonomous control in maintenance and spare part logistics -
   challenges and opportunities for preacting maintenance concepts},
Booktitle = {2ND INTERNATIONAL CONFERENCE ON SYSTEM-INTEGRATED INTELLIGENCE:
   CHALLENGES FOR PRODUCT AND PRODUCTION ENGINEERING},
