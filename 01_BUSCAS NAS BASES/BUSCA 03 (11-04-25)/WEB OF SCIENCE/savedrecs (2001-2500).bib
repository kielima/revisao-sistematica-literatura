@article{ WOS:000424303300007,
Author = {Goj, Karl and Hennecke, Markus},
Title = {Restoration of the Echelsbacher Bridge in Germany},
Journal = {PROCEEDINGS OF THE INSTITUTION OF CIVIL ENGINEERS-ENGINEERING HISTORY
   AND HERITAGE},
Year = {2017},
Volume = {170},
