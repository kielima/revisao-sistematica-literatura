@article{ WOS:000391899400023,
Author = {Mulder, Karel F.},
Title = {Strategic competences for concrete action towards sustainability: An
   oxymoron? Engineering education for a sustainable future},
Journal = {RENEWABLE \& SUSTAINABLE ENERGY REVIEWS},
Year = {2017},
Volume = {68},
Number = {2},
Pages = {1106-1111},
