Note = {23rd CIRP Conference on Life Cycle Engineering, Berlin, GERMANY, MAY
   22-24, 2016},
Organization = {CIRP},
Abstract = {Components of automation technology have a special position in the area
   of sustainability. Each component has limited impact on sustainability
   indicators and business-to-business customers only have a small physical
   and emotional involvement with the product. However, interesting
   leverage might be given since the components are sold in large numbers
   and influence the system they are built in. Based on this background
   information, this paper provides a framework to consider all
   stakeholders perspectives in order to avoid trade-offs between them and
   to push ``win-win-win-situations{''}. Concrete measures for automation
   technology are allocated to the sustainability strategies and quantified
   through a product example. (C) 2016 The Authors. Published by Elsevier
   B.V.},
