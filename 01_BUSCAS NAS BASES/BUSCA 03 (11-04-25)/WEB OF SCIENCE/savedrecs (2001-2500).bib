@article{ WOS:000852492800001,
Author = {Gomes, Augusto M. and Azevedo, Goncalo and Sampaio, Alcinia Zita and
   Sanchez Lite, Alberto},
Title = {BIM in Structural Project: Interoperability Analyses and Data Management},
