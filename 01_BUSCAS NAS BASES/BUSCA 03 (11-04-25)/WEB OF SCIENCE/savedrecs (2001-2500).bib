@article{ WOS:000296512100010,
Author = {Zhang, Dawei and Ueda, Tamon and Furuuchi, Hitoshi},
Title = {Average Crack Spacing of Overlay-Strengthened RC Beams},
Journal = {JOURNAL OF MATERIALS IN CIVIL ENGINEERING},
