@article{ WOS:000451754200027,
Author = {Gamez-Garcia, Diana C. and Saldana-Marquez, Hector and Gomez-Soberon,
   Jose M. and Corral-Higuera, Ramon and Arredondo-Rea, Susana P.},
Title = {Life Cycle Assessment of residential streets from the perspective of
