@article{ WOS:000916003800001,
Author = {Linkevicius, Edgaras and Zemaitis, Povilas and Aleinikovas, Marius},
Title = {Sustainability Impacts of Wood- and Concrete-Based Frame Buildings},
Journal = {SUSTAINABILITY},
Year = {2023},
