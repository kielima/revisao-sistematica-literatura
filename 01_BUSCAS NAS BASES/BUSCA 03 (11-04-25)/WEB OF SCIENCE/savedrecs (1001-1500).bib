@article{ WOS:000859865400001,
Author = {Vashistha, Prabhat and Park, Sungwoo and Pyo, Sukhoon},
Title = {A Review on Sustainable Fabrication of Futuristic Cementitious Binders
   Based on Application of Waste Concrete Powder, Steel Slags, and Coal
   Bottom Ash},
