@article{ WOS:000466551600168,
Author = {Cen, Xiaoqian and Wang, Qingyuan and Shi, Xiaoshuang and Su, Yan and
   Qiu, Jingsi},
Title = {Optimization of Concrete Mixture Design Using Adaptive Surrogate Model},
Journal = {SUSTAINABILITY},
Year = {2019},
