@article{ WOS:001046362900001,
Author = {Maury-Ramirez, Anibal and De Belie, Nele},
Title = {Environmental and Economic Assessment of Eco-Concrete for Residential
   Buildings: A Case Study of Santiago de Cali (Colombia)},
Journal = {SUSTAINABILITY},
Year = {2023},
