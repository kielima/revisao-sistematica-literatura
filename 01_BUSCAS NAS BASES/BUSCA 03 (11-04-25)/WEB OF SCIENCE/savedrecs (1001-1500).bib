@article{ WOS:000290121900003,
Author = {Capo-Vicedo, Josep},
Title = {Life cycle analysis and corporate cluster development policies},
Journal = {EURE-REVISTA LATINOAMERICANA DE ESTUDIOS URBANO REGIONALES},
