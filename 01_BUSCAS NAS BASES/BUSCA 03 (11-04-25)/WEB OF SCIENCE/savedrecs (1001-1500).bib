@article{ WOS:000502086900008,
Author = {Calama-Gonzalez, C. M. and Canas Palop, C.},
Title = {A comparative life cycle assessment of four different constructive
   solutions for the rehabilitation of planked timber floors with heritage
   value},
Journal = {INFORMES DE LA CONSTRUCCION},
Year = {2019},
Volume = {71},
Number = {556},
Month = {OCT-DEC},
Abstract = {The Spanish construction sector is a huge consumer of natural and energy
   resources, being responsible for 50\%f of the total generated waste. Due
   to current regulations for sustainable development, Life Cycle
   Assessment (LCA) is a fundamental tool to approach environmental
   criteria and assess interventions prior to construction. This paper
   evaluates the environmental impacts of four sohitions for rehabilitating
   timber floors, with pieces between beams in curved form, in heritage
   buildings from the 1700s to 1900s, in Seville. Three of the proposed
   rehabilitation solutions are widely used in these type of interventions
   and the fourth uses prefabricated pieces made from a recycled ceramic
   mortar, as elements between beams. Results show a better environmental
   performance of the recycled solution, also being compatible with
   patrimonial criteria.},
