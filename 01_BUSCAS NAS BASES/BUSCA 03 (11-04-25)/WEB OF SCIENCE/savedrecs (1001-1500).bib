   Munoz, Luis Felipe Lopez, BASE Bahay Innovat Ctr, Makati 1231, Philippines.},
DOI = {10.3390/su14127409},
Article-Number = {7409},
EISSN = {2071-1050},
Keywords = {bamboo; CO2; design; environmental impact; LCA},
Keywords-Plus = {ENVIRONMENTAL IMPACTS},
Research-Areas = {Science \& Technology - Other Topics; Environmental Sciences \& Ecology},
Web-of-Science-Categories  = {Green \& Sustainable Science \& Technology; Environmental Sciences;
   Environmental Studies},
