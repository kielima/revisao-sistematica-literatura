Title = {Identifying damage in a bridge by analysing rotation response to a
   moving load},
Booktitle = {BRIDGE MAINTENANCE, SAFETY, MANAGEMENT, LIFE-CYCLE SUSTAINABILITY AND
   INNOVATIONS},
Year = {2021},
