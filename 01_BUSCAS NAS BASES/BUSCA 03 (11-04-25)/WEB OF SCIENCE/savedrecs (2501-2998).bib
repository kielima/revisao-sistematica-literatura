@inproceedings{ WOS:000404873600019,
Author = {Teh, Soo Huey and Wiedmann, Thomas and Schinabeck, Judith and Moore,
   Stephen},
Editor = {Ding, L and Fiorito, F and Osmond, P},
Title = {Replacement scenarios for construction materials based on economy-wide
   hybrid LCA},
Booktitle = {INTERNATIONAL HIGH-PERFORMANCE BUILT ENVIRONMENT CONFERENCE - A
   SUSTAINABLE BUILT ENVIRONMENT CONFERENCE 2016 SERIES (SBE16), IHBE 2016},
