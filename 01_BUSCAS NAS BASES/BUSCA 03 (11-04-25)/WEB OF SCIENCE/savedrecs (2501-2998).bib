@article{ WOS:000898245100001,
Author = {Karamoozian, Masood and Hong, Zhang},
Title = {Using a decision-making tool to select the optimal industrial housing
   construction system in Tehran},
Journal = {JOURNAL OF ASIAN ARCHITECTURE AND BUILDING ENGINEERING},
