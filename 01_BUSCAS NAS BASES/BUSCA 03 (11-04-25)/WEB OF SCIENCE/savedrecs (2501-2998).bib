@article{ WOS:000933428400001,
Author = {Verga, Matteo and Vigano, Gian Luca and Capuzzo, Martina and Duri,
   Claudia and Ignoti, Lucia Maria and Picozzi, Paola and Cimolin, Veronica},
Title = {The digitization process and the evolution of Clinical Risk Management
   concept: The role of Clinical Engineering in the operational management
   of biomedical technologies},
Journal = {FRONTIERS IN PUBLIC HEALTH},
Year = {2023},
Volume = {11},
Month = {FEB 2},
Abstract = {IntroductionDigital transformation and technological innovation which
   have influenced several areas of social and productive life in recent
   years, are now also a tangible and concrete reality in the vast and
   strategic sector of public healthcare. The progressive introduction of
   digital technologies and their widespread diffusion in many segments of
   the population undoubtedly represent a driving force both for the
   evolution of care delivery methods and for the introduction of new
   organizational and management methods within clinical structures.
   MethodsThe CS Clinical Engineering of the ``Spedali Civili Hospital in
   Brescia{''} decided to design a path that would lead to the development
   of a software for the management of biomedical technologies within its
   competence inside the hospital. The ultimate aim of this path stems from
   the need of Clinical Engineering Department to have up-to-date,
   realistic, and systematic control of all biomedical technologies present
   in the company. ``Spedali Civili Hospital in Brescia{''} is not just one
   of the most important corporate realities in the city, but it is also
   the largest hospital in Lombardy and one of the largest in Italy. System
   development has followed the well-established phases: requirement
   analysis phase, development phase, release phase and evaluating and
   updating phase. ResultsFinally, cooperation between the various figures
   involved in the multidisciplinary working group led to the development
   of an innovative management software called ``SIC Brescia{''}.
   DiscussionThe contribution of the present paper is to illustrate the
   development of a complex implementation model for the digitization of
   processes, information relating to biomedical technologies and their
   management throughout the entire life cycle. The purpose of sharing this
   path is to highlight the methodologies followed for its realization, the
   results obtained and possible future developments. This may enable other
   realities in the healthcare context to undertake the same type of
   pathway inspired by an accomplished model. Furthermore, future
   implementation and data collection related to the proposed Key
   Performance Indicators, as well as the consequent development of new
   operational management models for biomedical technologies and
   maintenance processes will be possible. In this way, the Clinical Risk
   Management concept will also be able to evolve into a more controlled,
   safe, and efficient system for the patient and the user.},
Publisher = {FRONTIERS MEDIA SA},
Address = {AVENUE DU TRIBUNAL FEDERAL 34, LAUSANNE, CH-1015, SWITZERLAND},
Type = {Article},
Language = {English},
