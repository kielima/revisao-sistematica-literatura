@article{ WOS:000987053200001,
Author = {Chen, Yuheng and Wu, Yanming and Sun, Xueyun and Ali, Naubada and Zhou,
   Qi},
Title = {Digital Documentation and Conservation of Architectural Heritage
   Information: An Application in Modern Chinese Architecture},
Journal = {SUSTAINABILITY},
Year = {2023},
