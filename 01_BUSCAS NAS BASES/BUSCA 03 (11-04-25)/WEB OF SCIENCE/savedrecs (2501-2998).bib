Title = {Comparison of Different Roof Types in Housing Projects in Turkey: Cost
   Analysis},
Booktitle = {SELECTED PAPERS FROM THE 27TH IPMA (INTERNATIONAL PROJECT MANAGEMENT
   ASSOCIATION)},
Series = {Procedia Social and Behavioral Sciences},
Year = {2014},
