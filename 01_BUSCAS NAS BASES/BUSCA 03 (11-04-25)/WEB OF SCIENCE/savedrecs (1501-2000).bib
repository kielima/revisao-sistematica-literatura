Title = {Identification of Correlation between Demand Performances to Damage of
   Lining Concrete for Tunnel Management},
Booktitle = {PROCEEDINGS OF THE TWELFTH EAST ASIA-PACIFIC CONFERENCE ON STRUCTURAL
   ENGINEERING AND CONSTRUCTION (EASEC12)},
Series = {Procedia Engineering},
Year = {2011},
