   Ovad, Elena; Barisic, Ivana; Zagvozda, Martina, Josip Juraj Strossmayer Univ Osijek, Fac Civil Engn Osijek, Osijek, Croatia.},
DOI = {10.13167/2014.9.5},
ISSN = {1847-8948},
Keywords = {freeze-thaw resistance; cement-bound aggregate; pavement structure;
   standards},
Research-Areas = {Engineering},
Web-of-Science-Categories  = {Engineering, Civil},
Author-Email = {ivana@gfos.hr},
