   Oller, Eva, Univ Politecn Cataluna, Dept Civil \& Environm Engn, Barcelona, Spain.
   Univ Girona, Dept Mech Engn \& Ind Construction, Inst Ciencias Construcc Eduardo Torroja IETCC, CSIC, Girona, Spain.},
DOI = {10.33586/hya.2022.3098},
ISSN = {0439-5689},
EISSN = {2605-1729},
