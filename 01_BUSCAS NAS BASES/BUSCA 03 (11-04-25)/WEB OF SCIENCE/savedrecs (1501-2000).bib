@article{ WOS:001258341400001,
Author = {San Vicente-Navarro, Alejandro and Los Santos-Ortega, Jorge and
   Fraile-Garcia, Esteban and Ferreiro-Cabello, Javier},
Title = {Methodology for Sustainability Assessment for the Use of Ground Olive
   Stones in Mortar Bricks for Facades},
Journal = {APPLIED SCIENCES-BASEL},
Year = {2024},
Volume = {14},
Number = {8},
Month = {APR},
Abstract = {The addition of ground olive stones in the manufacture of mortar bricks
   reduces their thermal conductivity coefficient and increases heat
   exchange insulation. So, it can improve energy efficiency and reduce the
   energy demand of buildings. This research analyzes, from other points of
   view, the economic, social and environmental impacts of the doping of
   GERO mortar bricks with ground olive stone in a percentage between 5\%
   and 15\% by volume of fine aggregate for use in building construction.
   The study focuses mainly on the region of Andalusia, Spain, where large
   quantities of olive stones are collected as waste from olive oil
   production. The economic analysis shows how the use of ground olive
   stones as a partial replacement of fine aggregate in mortar can generate
   significant savings and economic returns in the medium term (10-20
   years) by reducing conventional energy consumption in heating and air
   conditioning installations. Finally, the Environmental Life Cycle
   Analysis shows that the use of ground olive stones in GERO perforated
   bricks reduces environmental impacts in the medium term. In summary, the
   research concludes that the doping of mortar bricks with ground olive
   stones can have a positive impact on the economy, society and the
   environment, and represents a sustainable and cost-effective alternative
   for the construction industry.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Ferreiro-Cabello, J (Corresponding Author), Univ La Rioja, Dept Mech Engn, SCoDIP Grp, Logrono 26004, La Rioja, Spain.
   San Vicente-Navarro, Alejandro; Los Santos-Ortega, Jorge; Fraile-Garcia, Esteban; Ferreiro-Cabello, Javier, Univ La Rioja, Dept Mech Engn, SCoDIP Grp, Logrono 26004, La Rioja, Spain.},
DOI = {10.3390/app14083388},
Article-Number = {3388},
EISSN = {2076-3417},
Keywords = {ground olive stone; doped mortar; circular economy; sustainable
   construction; Social Life Cycle Analysis; Environmental Life Cycle
   Analysis},
