@article{ WOS:001225183200001,
Author = {Kanagaraj, Balamurali and Anand, N. and Raj, R. Samuvel and Andrushia,
   Diana and Lubloy, Eva},
Title = {Practicability and environmental impact assessment of synthetic fibre
   reinforced polymer (SFRP) stirrups in reinforced concrete beams},
