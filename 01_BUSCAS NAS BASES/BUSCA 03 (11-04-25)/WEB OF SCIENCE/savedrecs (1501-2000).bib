@article{ WOS:001365276900001,
Author = {Chen, Xiaoyang and Wang, Yajun and Yang, Tao and Bai, Yang},
Title = {Marine Geo-Polymer Cement Treated with Seawater, Alkaline Activators,
   Recycled Particles from Paste, and Recycled Particles from Glass},
Journal = {MATERIALS},
Year = {2024},
Volume = {17},
Number = {22},
Month = {NOV},
Abstract = {This study aims to develop the marine geo-polymer cement that was
   produced with seawater, recycled particles from paste, recycled
   particles from glass, and alkaline activators, including NaOH or
   Na2O<middle dot>3.3SiO2. The physicochemical properties and strength of
   MGPC were investigated with a Uniaxial Compression Test, Particle Size
   Analysis, Energy Dispersive Spectrometer, X-ray Diffraction, and
   Thermal-field Emission Scanning Electron Microscopy. The results
   indicated that the main hydration products in MGPC were calcium
   carbonate (CaCO3), silica (SiO2), sodium aluminosilicate hydrate
   (Na2O<middle dot>Al2O3<middle dot>xSiO2<middle dot>2H2O, N-A-S-H), and
   aluminum calcium silicate hydrate (CaO<middle dot>Al2O3<middle
   dot>2SiO2<middle dot>4H2O, C-A-S-H). The calcium carboaluminate
   (3CaO<middle dot>Al2O3<middle dot>CaCO3<middle dot>32H2O, CO3-AFm) in
   MGPC was converted into CaCO3 and Friedel's salt (3CaO<middle
   dot>Al2O3<middle dot>CaCl2<middle dot>10H2O), which prompted the carbon
   sequestration. The microstructure of MGPC prepared using Na2O<middle
   dot>3.3SiO2 was based on RPG as the matrix, with N-A-S-H, C-A-S-H, and
   fibrous AFt growing on the periphery. This structure reduces the impact
   of the alkali-silica reaction on the material and improves its
   compressive strength. Therefore, the MGPC developed in this study shows
   the exact benefits of freshwater and natural minerals saving, carbon
   sequestration, and damage resistance.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
