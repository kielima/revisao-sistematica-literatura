@inproceedings{ WOS:000416786300014,
Author = {Fortuna, Stefano and Dalla Mora, Tiziano and Peron, Fabio and Romagnoni,
   Piercarlo},
Editor = {Valtere, S and Gusca, J},
Title = {Environmental performances of a timber-concrete prefabricated composite
   wall system},
