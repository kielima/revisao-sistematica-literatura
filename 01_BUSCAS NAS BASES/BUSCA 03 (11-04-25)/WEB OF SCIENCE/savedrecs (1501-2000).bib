@article{ WOS:001160050200001,
Author = {Bideci, Ozlem Salli and Bideci, Alper and Ashour, Ashraf},
Title = {Utilization of Recycled Brick Powder as Supplementary Cementitious
   Materials-A Comprehensive Review},
