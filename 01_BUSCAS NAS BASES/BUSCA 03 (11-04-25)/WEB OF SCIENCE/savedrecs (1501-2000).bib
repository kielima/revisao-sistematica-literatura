@inproceedings{ WOS:001223393000005,
Author = {Masanet, Claudio and Navarro, Ignacio and Collado, Maria and Yepes,
   Victor},
Editor = {Nejad, AR},
Title = {SUSTAINABLE DESIGN OF ONSHORE WIND TURBINE FOUNDATIONS},
Booktitle = {WINDEUROPE ANNUAL EVENT 2024},
