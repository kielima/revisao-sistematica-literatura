@inproceedings{ WOS:000304040400036,
Author = {Marinoski, A. K. and Ghisi, E.},
Editor = {Brebbia, CA and Zubir, SS},
Title = {Assessment of the environmental impact and investment feasibility
   analysis of rainwater use in houses},
Booktitle = {MANAGEMENT OF NATURAL RESOURCES, SUSTAINABLE DEVELOPMENT AND ECOLOGICAL
   HAZARDS III},
Series = {WIT Transactions on Ecology and the Environment},
