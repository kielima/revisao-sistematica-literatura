@inproceedings{ WOS:000323486600023,
Author = {Berkowski, Piotr and Dmochowski, Grzegorz and Kosior-Kazberuk, Marta},
Editor = {Juozapaitis, A and Vainiunas, P and Zavadskas, EK},
Title = {Analysis of Structural and Material Degradation of a Car-Park's RC
   Bearing Structure Due to City Environmental Influences},
Booktitle = {MODERN BUILDING MATERIALS, STRUCTURES AND TECHNIQUES},
