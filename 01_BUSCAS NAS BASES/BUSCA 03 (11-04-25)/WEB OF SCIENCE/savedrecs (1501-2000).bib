@article{ WOS:000960891000001,
Author = {Adetona, Adekunbi B. B. and Nhuchhen, Daya R. R. and Layzell, David B.
   B.},
Title = {Climate impact of diverting residual biomass to cement production},
Journal = {GLOBAL CHANGE BIOLOGY BIOENERGY},
Year = {2023},
Volume = {15},
Number = {5},
Pages = {710-730},
Month = {MAY},
Abstract = {Co-firing residual lignocellulosic biomass with fossil fuels is often
   used to reduce greenhouse gas (GHG) emissions, especially in processes
   like cement production where fuel costs are critical and residual
   biomass can be obtained at a low cost. Since plants remove CO(2 )from
   the atmosphere, CO2 emissions from biomass combustion are often assumed
   to have zero global warming potential (GWP(bCO2) = 0) and do not
   contribute to climate forcing. However, diverting residual bio-mass to
   energy use has recently been shown to increase the atmospheric CO(2
   )load when compared to business-as-usual (BAU) practices, resulting in
   GWP(bCO2) values between 0 and 1. A detailed process model for a natural
   gas-fired cement plant producing 4200 megagrams of clinker per day was
   used to calculate the material and energy flows, as well as the
   lifecycle emissions associated with cement production without and with
   diverted biomass (supplying 50\% of precalciner energy demand) from
   forestry and landfill sources. Biomass co-firing reduced natural gas
   demand in the precalciner of the cement plant by 39\% relative to the
   reference scenario (100\% natural gas), but the total demands for
   thermal, electrical, and diesel (transportation) energy increased by at
   least 14\%. Assuming GWP(bCO2) values of zero for biomass combustion,
   cement's lifecycle GHG inten-sity changed from the reference (natural
   gas only) plant by -40, -23, and - 89 kg CO2/Mg clinker for diverted
   biomass from slash burning, forest floor and landfill biomass,
   respectively. However, using the calculated GWP(bCO2) values for
   diverted biomass from these same fuel sources, the lifecycle GHG
   intensities changes were -37, +20 and +28 kg CO2/Mg clinker,
   respectively. The switch from decreasing to increasing cement plant GHG
   emissions (i.e., forest floor or landfill feedstocks scenarios)
   highlights the importance of calculating and using the GWP(bCO2) factor
   when quantifying lifecycle GHG impacts associated with diverting
   residual biomass to bioenergy use.},
