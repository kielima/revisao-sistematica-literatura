@article{ WOS:001453091000001,
Author = {Poudel, Sushant and Bhetuwal, Utkarsha and Kharel, Prabin and Khatiwada,
   Sudip and Diwakar, K. C. and Dhital, Subash and Lamichhane, Bipin and
