@article{ WOS:001307141500001,
Author = {Li, Xiaoyu and Liu, Huiyang and Xing, Jinxin and Gan, Min and Ji, Zhiyun
   and Fan, Xiaohui and Sun, Zengqing},
Title = {Seawater Mixed with One Part Alkali Activated Material: An Environmental
   and Cost Evaluation},
Journal = {MATERIALS},
Year = {2024},
Volume = {17},
Number = {16},
Month = {AUG},
Abstract = {Concrete production is associated with extensive energy consumption and
   significant CO2 emissions. In addition, tremendous amounts of freshwater
   are used as a mixing agent. Urgency is increasing to develop sustainable
   cementitious materials and promote freshwater-saving strategies. An
   environmentally friendly alternative binder, seawater mixed with one
   part alkali activated material, is studied. In this work, a
   cradle-to-gate life cycle assessment was applied to study the equivalent
   CO2 emission and cost properties of the clinker-free binder. The
   seawater mixed mortar possesses comparable mechanical properties to
   Portland cement, with 3 d flexural and compressive strengths of 5.3 MPa
   and 25.2 MPa. In addition, the mortar developed in this work is of
   similar cost as commercial cement, but reduces CO2 emissions by 44.8\%.},
