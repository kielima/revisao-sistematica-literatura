@article{ WOS:001189175000001,
Author = {Sravani, Tata and Ramani, Prasanna Venkatesan and Anbu, Madhumathi},
Title = {Comparative analysis of cement-based bricks in India: a cradle-to-gate
   life cycle assessment},
Journal = {ENGINEERING RESEARCH EXPRESS},
Year = {2024},
Volume = {6},
Number = {1},
Month = {MAR 1},
Abstract = {The main aim of this study is to quantify the environmental impact
   caused by different types of bricks used in the Indian construction
   field. This study considered four brick types: Autoclave Aerated
   Concrete, Fly ash, and Cellular Foam bricks. The prime objectives of the
   investigation are to evaluate and compare the embodied energy and
   resource depletion by modelling the environmental impact of the bricks
   by Global Warming Potential (GWP) with the LCA software SimaPro. The
   study's use of a cradle-to-gate approach provides a comprehensive
   understanding of the environmental implications associated with four
   types of bricks. Moreover, the analysis conducted using SimaPro 8.1
   software with the life cycle ReCiPe 2016 v1.1 and IMPACT 2002 + v2.15
   demonstrates the rigour and accuracy of the findings. The results
   indicate that cement bricks have the lowest Global Warming Potential,
   specific heat, and cost, making them a more environmentally and
   economically friendly option than other bricks. Furthermore, weight,
   water absorption, density, thermal conductivity, and compressive
   strength were also analyzed and showed other better-performing bricks.},
