@inproceedings{ WOS:000435193600006,
Author = {Octavia, Caesara and Laurence and Hartono, Natalia},
Book-Group-Author = {IOP},
Title = {Water footprint and life cycle assessment of concrete roof tile and
   brick products at PT. XYZ},
