Title = {Comparative Life Cycle Analysis of Materials in Wastewater Piping
   Systems},
Booktitle = {DEFINING THE FUTURE OF SUSTAINABILITY AND RESILIENCE IN DESIGN,
   ENGINEERING AND CONSTRUCTION},
