@article{ WOS:000527913700021,
Author = {Marsh, Alastair T. M. and Heath, Andrew and Walker, Pete and Reddy, B.
   V. Venkatarama and Habert, Guillaume},
Title = {Discussion of ``Earth concrete. Stabilization revisited{''}},
Journal = {CEMENT AND CONCRETE RESEARCH},
Year = {2020},
Volume = {130},
Month = {APR},
Abstract = {Using metrics is an informative approach to compare the effectiveness of
   cement use in material systems, but does not necessarily consider all
   factors needed to determine which system is most sustainable. To make a
   fair comparison, it is necessary to consider the functions cement
   performs in each system. In this discussion, suggestions are given for
   how to assess the use of cement as a binding agent in stabilised earth
   construction. Consideration of structural requirements and durability,
   life cycle analysis and moisture buffering shows that the effectiveness
   of cement use depends on more than just embodied carbon and dry
   compressive strength.},
