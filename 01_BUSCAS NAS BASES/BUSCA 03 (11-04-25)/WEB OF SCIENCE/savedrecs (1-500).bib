@article{ WOS:000481678600009,
Author = {Cadenazzi, Thomas and Dotelli, Giovanni and Rossini, Marco and Nolan,
   Steven and Nanni, Antonio},
Title = {Life-Cycle Cost and Life-Cycle Assessment Analysis at the Design Stage
   of a Fiber-Reinforced Polymer-Reinforced Concrete Bridge in Florida},
