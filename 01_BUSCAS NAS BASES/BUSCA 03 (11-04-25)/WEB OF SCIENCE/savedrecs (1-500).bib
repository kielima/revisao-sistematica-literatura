@article{ WOS:000597597500001,
Author = {Alabduljabbar, Hisham and Huseien, Ghasan Fahim and Sam, Abdul Rahman
   Mohd and Alyouef, Rayed and Algaifi, Hassan Amer and Alaskar, Abdulaziz},
Title = {Engineering Properties of Waste Sawdust-Based Lightweight
   Alkali-Activated Concrete: Experimental Assessment and Numerical
   Prediction},
