	correspondence_address = {A.L. Herrera-May; Facultad de Ingeniería de la Construcción y el Hábitat, Universidad Veracruzana, Boca del Río, Veracruz, Calzada Ruiz Cortines 455, 94294, Mexico; email: leherrera@uv.mx},
