	author = {Ferronato, Navarro and Giaquinta, Chiara and Conti, Fabio and Torretta, Vincenzo},
	title = {When solid recovered fuel (SRF) production and consumption maximize environmental benefits? A life cycle assessment},
	year = {2024},
	journal = {Waste Management},
