	author = {Younsi, Akli and Turcry, Philippe and Aït-Mokhtar, Abdelkarim},
	title = {Quantification of CO2 uptake of concretes with mineral additions after 10-year natural carbonation},
	year = {2022},
	journal = {Journal of Cleaner Production},
