@ARTICLE{Kane2025,
	author = {Kane, Seth and Bin Thaneya, Ahmad and Gursel, Aysegul Petek and Fan, Jin and Bose, Baishakhi and Hendrickson, Thomas P and Nordahl, Sarah L and Scown, Corinne D and Miller, Sabbie A and Horvath, Arpad},
	title = {Uncertainty in determining carbon dioxide removal potential of biochar},
	year = {2025},
	journal = {Environmental Research Letters },
	volume = {20},
	number = {1},
	doi = {10.1088/1748-9326/ad99e9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85219571752&doi=10.1088%2f1748-9326%2fad99e9&partnerID=40&md5=231c7475700d4615f25526bb4242c34b},
	abstract = {A quantitative and systematic assessment of uncertainty in life-cycle assessment is critical to informing sustainable development of carbon dioxide removal (CDR) technologies. Biochar is the most commonly sold form of CDR to date and it can be used in applications ranging from concrete to agricultural soil amendments. Previous analyses of biochar rely on modeled or estimated life-cycle data and suggest a cradle-to-gate range of 0.20-1.3 kg CO2 net removal per kg of biomass feedstock, with the range reported driven by differences in energy consumption, pyrolysis temperature, and feedstock sourcing. Herein, we quantify the distribution of CDR possible for biochar production with a compositional life-cycle inventory model paired with scenario-aware Monte Carlo simulation in a ‘best practice’ (incorporating lower transportation distances, high pyrolysis temperatures, high energy efficiency, recapture of energy for drying and pyrolysis energy requirements, and co-generation of heat and electricity) and ‘poor practice’ (higher transportation distances, lower pyrolysis temperatures, low energy efficiency, natural gas for energy requirements, and no energy recovery) scenarios. In the best-practice scenario, cradle-to-gate CDR (which is representative of the upper limit of removal across the entire life cycle) is highly certain, with a median removal of 1.4 kg of CO2e/kg biomass and results in net removal across the entire distribution. In contrast, the poor-practice scenario results in median net emissions of 0.090 kg CO2e/kg biomass. Whether this scenario emits (66% likelihood) or removes (34% likelihood) carbon dioxide is highly uncertain. The emission intensity of energy inputs to the pyrolysis process and whether the bio-oil co-product is used as a chemical feedstock or combusted are critical factors impacting the net carbon dioxide emissions of biochar production, together responsible for 98% of the difference between the best- and poor-practice scenarios. © 2024 The Author(s). Published by IOP Publishing Ltd.},
	author_keywords = {carbon sequestration; greenhouse gas emissions; life-cycle assessment (LCA); Monte Carlo simulation; pyrolysis},
	keywords = {Carbon capture and storage; Carbon sequestration; Catalytic cracking; Direct air capture; Feedstocks; Kyoto Protocol; Life cycle assessment; Low emission; Low temperature production; Natural gas transportation; Petroleum transportation; Zero-carbon; Best practices; Biochar; Carbon dioxide removal; Carbon sequestration; Greenhouse gas emissions; Life-cycle assessment; Monte Carlo's simulation; Pyrolysis temperature; Transportation distance; Uncertainty; biochar; carbon dioxide; carbon emission; carbon sequestration; concentration (composition); greenhouse gas; life cycle analysis; Monte Carlo analysis; pollutant removal; pyrolysis; spatiotemporal analysis; sustainable development; Carbon capture and utilization},
	correspondence_address = {S. Kane; Department of Civil and Environmental Engineering, University of California, Davis, 95616, United States; email: skane@ucdavis.edu},
	publisher = {Institute of Physics},
