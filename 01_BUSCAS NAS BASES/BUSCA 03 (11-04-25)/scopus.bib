@CONFERENCE{Kelley2022290,
	author = {Kelley, Shana},
	title = {EXPANSION OF SUSTAINABILITY IN THE ACI 318 BUILDING CODE},
	year = {2022},
	journal = {Acta Polytechnica CTU Proceedings},
