@CONFERENCE{Bohne2024,
	author = {Bohne, R.A. and Rasmussen, F.N. and Kvande, T.},
	title = {Experiences from teaching graduate students how to design net Zero Emission Buildings in Norway},
	year = {2024},
	journal = {IOP Conference Series: Earth and Environmental Science},
	volume = {1363},
	number = {1},
	doi = {10.1088/1755-1315/1363/1/012116},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198465286&doi=10.1088%2f1755-1315%2f1363%2f1%2f012116&partnerID=40&md5=a3ff56a23d0d2b1cec825365678c389c},
	abstract = {The ambition of the Paris agreement is “carbon neutrality” by 2050. But what is “carbon neutrality”? How do we design a “carbon neutral” building? And how to teach this concept to engineering students? TBA4171 is an advanced course in Building Technology, given as the last course before the final thesis for the master students in building technology at NTNU. This paper describes how we use flipped-classroom and problem-based-learning to teach these concepts, and presents the results from the student projects. TBA4171 is targeting students specializing in building materials, building physics or fire safety in buildings. But the course also attracts students specializing in building processes and real estate management. In the course, the project of the students is to redesign five different current state-of-art Norwegian single-family houses to net Zero Emission Buildings. The students are given full access to BIM drawings, bill of quantities, EPD of materials and an LCA of each building. The students engage in an iteratively optimized design process, investigating the influence of geometry layout, material selection, energy performance, technical installations, and implementation of renewable energy sources. Life cycle based GHGe accounting are done for each design iteration to investigate where the biggest emission savings are obtained, and how the final building design complies with the Norwegian approach to net zero GHGe performance. The results show that graduate students are capable of designing net Zero Emission Buildings. They achieve this, primarily by optimizing material use (e.g. reduced use of concrete and steel) and geometrical layout (solar heat gains during winter/shading during summer and space for PVs). The results show that is possible to design net Zero Emission Buildings if provided with data on material and energy mix. The results also show that problem-based-learning is a powerful method of teaching these concepts to graduate students. © 2024 Institute of Physics Publishing. All rights reserved.},
	correspondence_address = {R.A. Bohne; Department of Civil- and Environmental Engineering, Norwegian University of Science and Technology, Trondheim, Norway; email: rolf.bohne@ntnu.no},
	publisher = {Institute of Physics},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access, Gold Open Access}
}

@CONFERENCE{Russo20241752,
	author = {Russo, Federica and Maselli, Gabriella and Nesticò, Antonio},
	title = {Life Cycle Sustainability Assessment of industrial flooring},
	year = {2024},
	journal = {Procedia Structural Integrity},
	volume = {64},
	pages = {1752 – 1758},
	doi = {10.1016/j.prostr.2024.09.180},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217023662&doi=10.1016%2fj.prostr.2024.09.180&partnerID=40&md5=2111e0b74901b4570e3270bacbb30258},
	abstract = {The use of fibre-reinforced concrete for industrial floors makes it possible to significantly contain the phenomenon of crack formation and propagation, which is the cause of degradation in traditional concrete floors. In fact, the structural fibres in place of the welded mesh form a homogeneous and omnidirectional reinforcement throughout the screed layer and, as a result, increase the load-bearing capacity of the structure due to a high residual tensile strength after cracking. This study aims to establish a methodological framework useful for comparing the environmental and economic performance of two alternative technological solutions for large span industrial floors: on the one hand, the traditional concrete solution; on the other hand, the innovative fiber-reinforced concrete solution, specifically tensofloor with post-tensioned reinforcement. To this end, an evaluation approach based on the integrated use of Life Cycle Costing (LCC) and Life Cycle Assessment (LCA) is proposed. The methodology makes it possible to assess (i) the financial sustainability of technological solutions by considering the costs related to the entire life cycle, from implementation to disposal; (ii) the environmental impacts generated by design alternatives in a cradle-to-grave perspective. © 2024 The Authors. Published by ELSEVIER B.V.},
	author_keywords = {Economic evaluation; Industrial flooring; Life Cycle Assessment; Life Cycle Costing; Technological solutions},
