	correspondence_address = {M.A. Khan; Department of Structural Engineering, Military College of Engineering (MCE), National University of Science and Technology (NUST), Islamabad, 44000, Pakistan; email: moak.pg18mce@student.nust.edu.pk; M.F. Javed; Department of Civil Engineering, COMSATS University Islamabad, Abbottabad Campus, Abbottabad, 22060, Pakistan; email: arbab_faisal@yahoo.com},
	publisher = {MDPI},
