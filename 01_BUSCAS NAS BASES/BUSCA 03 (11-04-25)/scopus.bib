	correspondence_address = {M. Huskinson; Department of Architectural Constructions, University of Alicante, San Vicente del Raspeig, Alicante, 03690, Spain; email: mh65@alu.ua.es; A. Galiano-Garrigós; Department of Architectural Constructions, University of Alicante, San Vicente del Raspeig, Alicante, 03690, Spain; email: antonio.galiano@ua.es},
