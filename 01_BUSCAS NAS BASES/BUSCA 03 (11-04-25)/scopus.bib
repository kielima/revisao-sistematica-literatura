@ARTICLE{Palumbo2020,
	author = {Palumbo, Elisabetta and Soust-Verdaguer, Bernardette and Llatas, Carmen and Traverso, Marzia},
	title = {How to obtain accurate environmental impacts at early design stages in BIM when using environmental product declaration. A method to support decision-making},
	year = {2020},
	journal = {Sustainability (Switzerland)},
	volume = {12},
	number = {17},
	doi = {10.3390/SU12176927},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85090756922&doi=10.3390%2fSU12176927&partnerID=40&md5=36ffc8be5ee033c76d4dae1a2dc2b035},
	abstract = {The construction sector plays an important role in moving towards a low-carbon economy. Life cycle assessment (LCA) is considered one of the most effective methods of analytically evaluating environmental profiles and an efficient tool for calculating the environmental impacts in building design-oriented methodologies, such as building information modelling (BIM). At early design stages, generic LCA databases are used to conduct the life cycle inventory (LCI), while detailed stages require more detailed data, such as environmental product declarations (EPDs), namely documents that provide accurate results and precise analyses based on LCA. Limitations are recognized when using EPDs in BIM elements at different levels of development (LOD) in the design stages, especially related to the data consistency and system boundaries of the LCA. This paper presents a method of achieving accurate LCA results, that helps with decision-making and provides support in the selection of building products and materials. The method is validated by its application in the structural concrete of an office building located in Germany. The method defines a safety factor adopted for embodied impacts ("cradle-to-gate"), based on EPD results to predict the environmental impact of BIM elements at different LODs. The results obtained show that by integrating the method to conduct the LCA, the range of errors and possible inconsistencies in the LCA results can be reduced. © 2020 by the authors.},
	author_keywords = {BIM (building information modelling); Building sustainability; Early design stages; Environmental product declaration (EPD); From cradle to gate; LCA (life cycle assessment); LOD (level of development)},
	keywords = {Germany; construction industry; decision making; design method; emission inventory; environmental assessment; environmental impact; life cycle analysis; methodology; product development},
