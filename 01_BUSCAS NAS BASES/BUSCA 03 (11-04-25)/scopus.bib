}

@ARTICLE{Nicula2023,
	author = {Nicula, Liliana Maria and Manea, Daniela Lucia and Simedru, Dorina and Cadar, Oana and Dragomir, Mihai Liviu and Ardelean, Ioan and Corbu, Ofelia},
	title = {Potential Role of GGBS and ACBFS Blast Furnace Slag at 90 Days for Application in Rigid Concrete Pavements},
	year = {2023},
	journal = {Materials},
	volume = {16},
	number = {17},
