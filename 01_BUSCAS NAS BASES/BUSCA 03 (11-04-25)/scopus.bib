	author = {Rajagopalan, Neethi and Bilec, Melissa M. and Landis, Amy E.},
	title = {Residential life cycle assessment modeling: Comparative case study of insulating concrete forms and traditional building materials},
	year = {2010},
	journal = {Journal of Green Building},
