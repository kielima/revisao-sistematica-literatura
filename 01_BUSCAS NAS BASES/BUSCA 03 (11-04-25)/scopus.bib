@ARTICLE{Sovacool20161623,
	author = {Sovacool, Benjamin K. and Munoz Perea, Mario Alberto and Matamoros, Alfredo Villa and Enevoldsen, Peter},
	title = {Valuing the manufacturing externalities of wind energy: assessing the environmental profit and loss of wind turbines in Northern Europe},
