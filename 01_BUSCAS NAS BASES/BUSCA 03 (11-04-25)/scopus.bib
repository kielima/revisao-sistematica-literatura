@ARTICLE{Arvizu-Montes2025,
	author = {Arvizu-Montes, A. and Martinez-Echevarria, M.J.},
	title = {Vegetable Fibers in Cement Composites: A Bibliometric Analysis, Current Status, and Future Outlooks},
	year = {2025},
