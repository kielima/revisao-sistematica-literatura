	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85185710854&doi=10.3390%2fbuildings14020386&partnerID=40&md5=fca3439bd279afa64850656d3caba343},
	abstract = {The ecological landscape design of urban rivers plays a crucial role in mitigating the urban heat island effect and preserving urban ecology. This study focuses on the construction process data of key landscape nodes along Nanjing’s urban rivers. By employing a whole life cycle emergy approach and carbon emission method, the sustainable changes in the landscape system are quantitatively assessed. Furthermore, artificial neural networks have been used to conduct long-term sustainability analysis and predictions for the landscape system. The research findings reveal that over time, the maintenance investment in landscape projects gradually becomes dominant, increasing from 2% in the first year to approximately 75% after 30 years. This phenomenon signifies a decline in the efficiency of the landscape system. Sustaining the ecological balance of the landscape system necessitates continuous inputs of material flow, energy flow, and information flow. The major contributors to carbon emissions in the landscape engineering system are diesel fuel, cement, and steel. This highlights opportunities for sustainable improvement from a low-carbon perspective. To enhance the ecological sustainability of urban waterfront landscapes, three measures are proposed: sponge city construction concepts, coupled sewage treatment systems, and information flow monitoring systems. The effectiveness of these measures was preliminarily validated. © 2024 by the authors.},
	author_keywords = {artificial neural network method; LCA–Emergy–Carbon footprint analysis; sustainability; water landscape system},
	keywords = {Emission control; Investments; Life cycle; Neural networks; Sustainable development; Artificial neural network methods; Carbon emissions; Environmental sustainability; Footprint analysis; Information flows; Landscape design; LCA–emergy–carbon footprint analyse; Urban Heat Island Effects; Urban river; Water landscape system; Carbon footprint},
