@ARTICLE{Berg Oppedal2024,
	author = {Berg Oppedal, Line and Kvande, Tore},
	title = {Carbon Footprints of a Conventional Norwegian Detached House Exposed to Flooding},
	year = {2024},
	journal = {Buildings},
	volume = {14},
	number = {7},
	doi = {10.3390/buildings14071967},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199600454&doi=10.3390%2fbuildings14071967&partnerID=40&md5=01e918c8fe52aa496f377331277201bc},
	abstract = {Rehabilitating water-damaged structures in buildings results in increased material extraction and energy use, and, consequently, a higher carbon footprint of the housing industry. Despite its prevalence, quantifying the carbon footprint caused by water damage or flooding has not gained much attention. Thus, this study investigated the quantitative carbon footprint associated with rehabilitating flooding in a detached house caused by torrential rain. Three different construction methods of the house were looked at; a timber frame construction, a masonry variant made by concrete blocks of Lightweight Expanded Clay Aggregate (LECA), and an alternative with exterior walls composed of concrete-moulded Expanded Polystyrene (EPS) foam boards. A life-cycle assessment according to NS 3720 was used to investigate the carbon footprint (CO2eq.) of typical flooding in a detached building. Rehabilitating the flooding in a house with concrete-moulded boards resulted in a lower carbon footprint (2.45 × 103 CO2eq.) than rehabilitating the same flooding in a house with LECA masonry (7.56 × 103 CO2eq.) and timber frames (2.49 × 103 CO2eq.). However, the timber-frame house had the lowest total carbon footprint (2.95 × 104 CO2eq.) owing to their original low footprint. This study found that flooding significantly contributed to the carbon footprint of buildings and, therefore, the topic should be given attention when choosing a construction method and moisture safety strategy. © 2024 by the authors.},
	author_keywords = {carbon footprint; construction methods; global warming potential; life-cycle assessment; moisture; torrential rain},
	keywords = {Construction industry; Energy utilization; Floods; Global warming; Houses; Life cycle; Light weight concrete; Moisture; %moisture; Construction method; Damaged structures; Detached house; Expanded clay aggregates; Exposed to; Floodings; Global warming potential; Life-cycle assessment; Torrential rain; Carbon footprint},
