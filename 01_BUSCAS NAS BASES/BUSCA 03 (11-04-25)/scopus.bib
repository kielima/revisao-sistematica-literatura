	title = {Linking Life Cycle and Integrated Assessment Modeling to Evaluate Technologies in an Evolving System Context: A Power-to-Hydrogen Case Study for the United States},
	year = {2023},
	journal = {Environmental Science and Technology},
	volume = {57},
	number = {6},
	pages = {2464 – 2473},
	doi = {10.1021/acs.est.2c04246},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85147452370&doi=10.1021%2facs.est.2c04246&partnerID=40&md5=f4f11b337d35c8cffbcd8c317af880ee},
	abstract = {Carbon-neutral hydrogen (H2) can reduce emissions from hard-to-electrify sectors and contribute to a net-zero greenhouse gas economy by 2050. Power-to-hydrogen (PtH2) technologies based on clean electricity can provide such H2, yet their carbon intensities alone do not provide sufficient basis to judge their potential contribution to a sustainable and just energy transition. Introducing a prospective life cycle assessment framework to decipher the non-linear relationships between future technology and energy system dynamics over time, we showcase its relevance to inform research, development, demonstration, and deployment by comparing two PtH2 technologies to steam methane reforming (SMR) across a series of environmental and resource-use metrics. We find that the system transitions in the power, cement, steel, and fuel sectors move impacts for both PtH2 technologies to equal or lower levels by 2100 compared to 2020 per kg of H2 except for metal depletion. The decarbonization of the United States power sector by 2035 allows PtH2 to reach parity with SMR at 10 kg of CO2e/kg H2 between 2030 and 2050. Updated H2 radiative forcing and leakage levels only marginally affect these results. Biomass carbon removal and storage power technologies enable carbon-negative H2 after 2040 at about −15 kg of CO2e/kg H2. Still, both PtH2 processes exhibit higher impacts across most other metrics, some of which are worsened by the decarbonization of the power sector. Observed increases in metal depletion and eco- and human toxicity levels can be reduced via PtH2 energy and material use efficiency improvements, but the power sector decarbonization routes also warrant further review and cradle-to-grave assessments to show tradeoffs from a systems perspective. © 2023 The Authors. Published by American Chemical Society.},
	author_keywords = {decarbonization; hydrogen; integrated assessment modeling; LiAISON; open-source code; power-to-X; prospective life cycle assessment},
	keywords = {Animals; Carbon; Greenhouse Gases; Humans; Hydrogen; Life Cycle Stages; Methane; Steam; Technology; United States; United States; Atmospheric radiation; Carbon; Decarbonization; Environmental impact; Environmental technology; Gas emissions; Greenhouse gases; Open source software; Open systems; Steam reforming; carbon; cement; fossil fuel; hydrogen; methane; steel; Decarbonisation; Integrated assessment models; LiAISON; Life cycle assessment model; Open-source code; Power; Power sector; Power-to-X; Prospective life cycle assessment; Prospectives; biomass; carbon emission; hydrogen; integrated approach; life cycle analysis; methane; radiative forcing; resource use; Article; atmosphere; biomass; carbon dioxide equivalent; combustion; controlled study; electricity; electrolysis; environmental impact; greenhouse effect; groundwater depletion; human; integrated health care system; life cycle assessment; parity; particulate matter exposure; photosynthesis; radiative forcing; technology; United States; water vapor; animal; greenhouse gas; life cycle stage; technology; Life cycle},
	correspondence_address = {P. Lamers; Strategic Energy Analysis Center, National Renewable Energy Laboratory, Golden, 80401, United States; email: patrick.lamers@nrel.gov},
	publisher = {American Chemical Society},
	language = {English},
