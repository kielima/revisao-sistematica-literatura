@CONFERENCE{Al-Furaiji2022,
	author = {Al-Furaiji, Mushtaq A. and Baranenko, A.V. and Zakharova, V.Y. and Malinina, O.S.},
	title = {Phase Change Material of (100-200) C: Review and Taxonomy},
	year = {2022},
	journal = {IOP Conference Series: Earth and Environmental Science},
	volume = {1029},
	number = {1},
	doi = {10.1088/1755-1315/1029/1/012014},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85132041330&doi=10.1088%2f1755-1315%2f1029%2f1%2f012014&partnerID=40&md5=6339f1b81a23f8087ee4d1d9d097f923},
	abstract = {Phase Change Material (PCM) is the material where its properties changed with the temperature change. If the application is heating, the process is called Latent Thermal Energy (LTE) and it can be stored. In practical application especially for the 100 C to 200 C, where the material is converted from solid to liquid, the energy management can be efficient and the energy storage is applicable. When the material is melted, the energy can be stored in heating operation and the inverse operation which means that the material can lose the energy stored when cooling or when stored in constant temperature. To overcome this, using PCM in medium temperatures (100-200 C) becomes important in many fields such as greenhouses, solar panels, thermal management in concrete, and so on. This paper discusses the recent developments in PCM such as using nanomaterials that keep the temperature for more times and encapsulation to enhance the heating operation. The taxonomy for the use of PCM is proposed in this paper based on the material requirements and types that can be used in this temperature range, and the measurement techniques in the physical form of material and thermal conductivity enhancement. A case study of 10 materials used in the required range is also discussed based on their temperature on the different life cycles of operations. At the end of this paper, a discussion of thermal energy management especially for solar applications is illustrated. Some possible future works are also proposed.  © Published under licence by IOP Publishing Ltd.},
	author_keywords = {encapsulation; LTE; Nanomaterials; PCM; Thermal conductivity},
	publisher = {Institute of Physics},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access, Gold Open Access}
}

