	title = {Recycled concrete-based technosols: Effects of the source of organic matter, biochar, and inoculation with plant growth promoting bacteria; [TECNOSUELOS A BASE DE CONCRETO RECICLADO: EFECTOS DE LA FUENTE DE MATERIA ORGÁNICA, BIOCARBÓN E INOCULACIÓN CON BACTERIAS PROMOTORAS DE CRECIMIENTO VEGETAL]},
	year = {2024},
	journal = {Revista Internacional de Contaminacion Ambiental},
	volume = {40},
