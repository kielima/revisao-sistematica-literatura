	title = {Formation of geopolymeric materials properties depending on the molar modules of SiO2/Al2O3 and SiO2/Na2O; [Kształtowanie właściwości materiałów geopolimerowych w zależności od modułów molowych SiO2/Al2O3 oraz SiO2/Na2O]},
	year = {2022},
	journal = {Cement, Wapno, Beton},
	volume = {27},
