	author = {Al-Hasan Mohammed, Eman Abdul and Mohamad, Safaa A. and Khaled, Teba Tariq and Alzubaidi, Ayar},
	title = {Study the effect of mineral filler on the mechanical properties of hot mix asphalt},
	year = {2020},
	journal = {IOP Conference Series: Materials Science and Engineering},
	volume = {870},
