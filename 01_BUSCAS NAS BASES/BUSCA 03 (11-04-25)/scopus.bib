	author = {Bayat, Hamid and Banar, Rasoul and Nikravan, Morteza and Farnood, Pedram and Ramezanianpour, Amir Mohammad and Kashani, Alireza},
	title = {Durability, mechanical, workability, and environmental assessment of self-consolidating concrete containing blast furnace slag and natural zeolite},
	year = {2024},
