	keywords = {ABAQUS; Concrete buildings; Concrete construction; Concrete mixtures; Cracks; Digital storage; Life cycle; Numerical methods; Numerical models; Structural design; Expansive agents; Expansive strengthening band; Magnesia expansive agent; Numerical calculation methods; Numerical simulation method; Raft structure; Seamless construction; Seamless construction for super-length concrete structure; Simulation and calculations; Structure-based; Magnesia},
