	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10; All Open Access, Gold Open Access}
}

@ARTICLE{Nasr2023,
	author = {Nasr, Mohammed Salah and Salman, Awham Jumah and Ghayyib, Rusul Jaber and Shubbar, Ali and Al-Mamoori, Shahad and Al-khafaji, Zainab and Hashim, Tameem Mohammed and Hasan, Zaid Ali and Sadique, Monower},
	title = {Effect of Clay Brick Waste Powder on the Fresh and Hardened Properties of Self-Compacting Concrete: State-of-the-Art and Life Cycle Assessment},
	year = {2023},
	journal = {Energies},
	volume = {16},
	number = {12},
	doi = {10.3390/en16124587},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85163892182&doi=10.3390%2fen16124587&partnerID=40&md5=e45cd0e7d2ef6b86479f128f27523a66},
	abstract = {Sustainability and reducing environmental damage caused by CO2 emissions have become issues of interest to researchers in the construction sector around the world. Reducing the cement content in concrete by partially substituting it with by-products or waste falls within this field as the cement industry is responsible for 7% of global CO2 emissions. On the other hand, self-compacting concrete (SCC) is one of the special types of concrete that contains a large amount of powder (most of which is cement) to ensure its flow under the influence of its weight without separating its components. Therefore, to produce eco-friendly SCC, many researchers have replaced part of the cement with clay brick waste powder (CBWP) since brick units are among the most widely used building materials after concrete. Accordingly, this study aims to review previous research that included using CBWP in SCC. The effect of these wastes on the fresh, mechanical, durability and microstructural properties of cement was reviewed. Additionally, a comparison between the environmental impacts of SCCs with different CBWP contents has been conducted using the life cycle assessment (LCA) approach. It was found that the highest value of CBWP that can be used without negatively affecting the different properties of concrete is 10% by weight of cement. Moreover, regarding environmental impact, using CBWP as a substitute for cement reduces environmental damage, and the lowest environmental impact that can be achieved per strength unit (MPa) is 37.5%. © 2023 by the authors.},
	author_keywords = {clay brick waste powder; fresh properties; hardened properties; life cycle assessment; SCC},
	keywords = {Brick; Carbon dioxide; Cements; Construction industry; Environmental impact; Hardening; Self compacting concrete; Sustainable development; Clay brick waste powder; Clay-brick wastes; CO 2 emission; Concrete state; Environmental damage; Fresh and hardened properties; Fresh properties; Hardened properties; Life cycle assessment; State of the art; Life cycle},
	correspondence_address = {A. Shubbar; School of Civil Engineering and Built Environment, Liverpool John Moores University, Liverpool, L3 5UX, United Kingdom; email: a.a.shubbar@ljmu.ac.uk},
	publisher = {MDPI},
	language = {English},
