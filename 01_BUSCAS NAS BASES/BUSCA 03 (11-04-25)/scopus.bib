	author = {Stoiber, Nadine and Hammerl, Mathias and Kromoser, Benjamin},
	title = {ENVIRONMENTAL ASSESSMENT OF NON-METALLIC REINFORCEMENT FOR CONCRETE STRUCTURES AS AN ALTERNATIVE TO STEEL REINFORCEMENT},
	year = {2022},
	journal = {Acta Polytechnica CTU Proceedings},
