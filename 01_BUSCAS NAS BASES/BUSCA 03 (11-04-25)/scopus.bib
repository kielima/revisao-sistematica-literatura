	correspondence_address = {B. Zegardło; Research Team of Quantitative Methods and Spatial Management, Institute of Agriculture and Horticulture, Faculty of Agricultural Sciences, University of Siedlce, Siedlce, B. Prusa 14, 08-110, Poland; email: bartosz.zegardlo@uws.edu.pl},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	language = {English},
