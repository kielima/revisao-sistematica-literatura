@CONFERENCE{Kumar2022,
	author = {Kumar, Rahul and Sharma, Sunil},
	title = {Perpetual Flexible Pavement vs. Rigid Pavement: An Economic and Environmental Cost Comparison},
	year = {2022},
	journal = {IOP Conference Series: Earth and Environmental Science},
	volume = {1084},
	number = {1},
