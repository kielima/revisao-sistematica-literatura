	note = {Cited by: 18; All Open Access, Gold Open Access}
}

@ARTICLE{Ventura2022,
	author = {Ventura, Heura and Álvarez, María Dolores and Gonzalez-Lopez, Laura and Claramunt, Josep and Ardanuy, Monica},
