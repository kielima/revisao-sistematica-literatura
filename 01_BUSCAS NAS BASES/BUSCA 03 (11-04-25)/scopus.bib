@CONFERENCE{Yang20192119,
	author = {Yang, Yichao and Madarshahian, Ramin and Todd, Michael D.},
	title = {A kriging surrogate model for structural health monitoring of miter gates in navigation locks},
	year = {2019},
	journal = {Structural Health Monitoring 2019: Enabling Intelligent Life-Cycle Health Management for Industry Internet of Things (IIOT) - Proceedings of the 12th International Workshop on Structural Health Monitoring},
	volume = {2},
	pages = {2119 – 2126},
	doi = {10.12783/shm2019/32347},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85074268291&doi=10.12783%2fshm2019%2f32347&partnerID=40&md5=3b671d8e216b9aa77bb2cca50544e82a},
	abstract = {Structural health monitoring (SHM) plays a significant role in monitoring the performance of the inland waterways civil infrastructure such as navigation locks. The United States has s $500B replacement value of its inland waterway infrastructure. Unexpected shutdowns of miter gates in navigation locks caused by any kind of damage produces tremendous economic loss, particularly if the shutdown is unplanned. Sensing is the first step in any process of damage detection strategy that collects data from sensing network. Lock gates are normally instrumented with strain gauges. A missing contact (or gap) between the concrete supporting wall and gate, one of the most common failure modes of lock gates, creates undesirable overloads and produces different levels of damage. An inverse model is needed to map the data extracted from the strain gauges to damage-sensitive features that are used to build degradation models and make decisions. An inverse Bayesian analysis is performed to identify damage by using strain gauge data. Although the posterior distribution estimations could provide probabilistic solutions to the damage identification, these models usually have high computational cost, and thus they are not suitable of performing real-time health monitoring. In this preliminary work, a Kriging or Gaussian process regression (GPR) inverse model is designed as a surrogate model of the finite element model of the Greenup lock miter gate, to map the strain gauge data to the damage size (i.e. gap length in miter gate contact). Hydrostatic loading scenarios governed by upstream and downstream heights with varying gap length are considered in the design of the Kriging model. Both training and testing data sets are predicted using the designed model. Overfitting problem caused by high nonlinear behavior of the data are solved. The results illustrated that Kriging, as a surrogate model, is a fairly reliable replacement to the computationally expensive inverse finite element model in damage identification. In addition, prediction performances using other Kriging models with different basic covariance functions and sizes of the training data set are compared. © 2019 by DEStech Publications, Inc. All rights reserved.},
	keywords = {Damage detection; Finite element method; Inland waterways; Internet of things; Interpolation; Inverse problems; Life cycle; Locks (fasteners); Locks (on waterways); Losses; Monitoring; Navigation; Probability distributions; Strain gages; Damage-detection strategy; Damage-sensitive features; Gaussian process regression; Inverse finite elements; Kriging surrogate model; Posterior distributions; Real-time health monitoring; Structural health monitoring (SHM); Structural health monitoring},
	correspondence_address = {M.D. Todd; Department of Structural Engineering, University of California at San Diego, San Diego, 9500 Gilman Drive, 92093, United States; email: md-todd@eng.ucsd.edu},
	publisher = {DEStech Publications Inc.},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access, Green Open Access}
}

