}

@ARTICLE{Gao2024,
	author = {Gao, Jiangjun and Shen, Zhengliang and Shao, Zerui and Pan, Xinyu and Tang, Deshuang and Zhao, Kun and Chen, Yao and Lv, Hengzhu},
	title = {Carbon Emission Analysis of RC Core Wall-Steel Frame Structures},
	year = {2024},
