@ARTICLE{Deng2023,
	author = {Deng, Bing and Meng, Wei and Advincula, Paul A. and Eddy, Lucas and Ucak-Astarlioglu, Mine G. and Wyss, Kevin M. and Chen, Weiyin and Carter, Robert A. and Li, Gang and Cheng, Yi and Nagarajaiah, Satish and Tour, James M.},
	title = {Heavy metal removal from coal fly ash for low carbon footprint cement},
	year = {2023},
	journal = {Communications Engineering},
	volume = {2},
	number = {1},
	doi = {10.1038/s44172-023-00062-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85173679924&doi=10.1038%2fs44172-023-00062-7&partnerID=40&md5=8c32373d9234535c40baf93dfb0918e6},
	abstract = {Development of cementitious materials with low carbon footprint is critical for greenhouse gas mitigation. Coal fly ash (CFA) is an attractive diluent additive in cement due to its widespread availability and ultralow cost, but the heavy metals in CFA could leach out over time. Traditional acid washing processes for heavy metal removal suffer from high chemical consumption and high-volume wastewater streams. Here, we report a rapid and water-free process based on flash Joule heating (FJH) for heavy metals removal from CFA. The FJH process ramps the temperature to ~3000 °C within one second by an electric pulse, enabling the evaporative removal of heavy metals with efficiencies of 70–90% for arsenic, cadmium, cobalt, nickel, and lead. The purified CFA is partially substituted in Portland cement, showing enhanced strength and less heavy metal leakage under acid leaching. Techno-economic analysis shows that the process is energy-efficient with the cost of ~$21 ton−1 in electrical energy. Life cycle analysis reveals the reuse of CFA in cement reduces greenhouse gas emissions by ~30% and heavy metal emissions by ~41%, while the energy consumption is balanced, when compared to landfilling. The FJH strategy also works for decontamination of other industrial wastes such as bauxite residue. © The Author(s) 2023.},
	correspondence_address = {B. Deng; Department of Chemistry, Rice University, Houston, 6100 Main Street, 77005, United States; email: bingdeng@rice.edu; J.M. Tour; Department of Chemistry, Rice University, Houston, 6100 Main Street, 77005, United States; email: tour@rice.edu; S. Nagarajaiah; Department of Civil and Environmental Engineering, Rice University, Houston, 6100 Main Street, 77005, United States; email: satish.nagarajaiah@rice.edu},
	publisher = {Springer Nature},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 19; All Open Access, Gold Open Access, Green Open Access}
