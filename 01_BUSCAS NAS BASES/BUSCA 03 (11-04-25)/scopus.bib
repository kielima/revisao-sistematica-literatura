	author = {Rasheed, Rizwan and Javed, Hajra and Rizwan, Asfra and Afzaal, Muhammad and Ahmad, Sajid Rashid},
	title = {Eco-sustainability analysis of precast-concrete utility poles manufacturing–A case study from Pakistan},
	year = {2023},
