@CONFERENCE{Fang2023195,
	author = {Fang, H.},
	title = {Behavior of bolted shear connectors for demountable and reusable UHPC-formed composite beams},
	year = {2023},
	journal = {Life-Cycle of Structures and Infrastructure Systems - Proceedings of the 8th International Symposium on Life-Cycle Civil Engineering, IALCCE 2023},
	pages = {195 – 202},
	doi = {10.1201/9781003323020-21},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186668625&doi=10.1201%2f9781003323020-21&partnerID=40&md5=69c4bf7a4f744ff563df53d4d7e29cf2},
	abstract = {Steel-concrete composite beams are widely applied in the design and construction of bridges and buildings. Due to the urgent need for the transformation towards sustainability and net-zero, developments of innovative composite systems with improved life-cycle sustainability such as lower embodied carbon and the potential for reuse after the end-of-life stage are required. To address this challenge, this study aims to contribute to the development of the composite beams with the ultra-high performance concrete (UHPC) proven with lower life-cycle embodied carbon than conventional concrete and the high-strength steel (HSS) bolts as the shear connection that facilitates demountability and reuse to reduce the production of new materials and the associated carbon footprint. The behavior of HSS bolts embedded in UHPC slabs is investigated experimentally. The resistance, load-slip responses and failure modes of the HSS bolts are presented and discussed. The suitability of design approaches for shear connection in conventional concrete slab for the HSS bolt shear connection in UHPC slab is also assessed and discussed. © 2023 The Author(s).},
	keywords = {Bolts; Bridges; Carbon footprint; Composite beams and girders; High performance concrete; High strength steel; Life cycle; Sustainable development; Composite beam; Conventional concrete; Design and construction; Embodied carbons; End of lives; High strength steel bolts; Reuse; Shear connections; Shear connector; Steel concrete composite beam; Concrete slabs},
