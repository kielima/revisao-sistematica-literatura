@ARTICLE{Margallo20191016,
	author = {Margallo, M. and Cobo, S. and Laso, J. and Fernandez, A. and Muñoz, E. and Santos, E. and Aldaco, R. and Irabien, A.},
	title = {Environmental performance of alternatives to treat fly ash from a waste to energy plant},
	year = {2019},
	journal = {Journal of Cleaner Production},
	volume = {231},
	pages = {1016 – 1026},
	doi = {10.1016/j.jclepro.2019.05.279},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85067010726&doi=10.1016%2fj.jclepro.2019.05.279&partnerID=40&md5=d950e0d3addd91fcf16e79caa8ede160},
	abstract = {Incineration has been adopted by many developed countries as an alternative to treat municipal solid waste due to its capacity to reduce the amount of waste and recover energy. Waste to energy plants produce two waste streams: bottom ashes and fly ashes (FA). FA are classified as hazardous waste, and they cannot be utilised or landfilled without prior treatment. Stabilisation with cement solidification is the most used method to treat FA because it achieves the immobilisation of pollutants at a relatively low cost. However, the accelerated carbonation of FA, which allows the encapsulation of certain mobile metals under alkaline conditions, has recently been proposed as an alternative to the solidification/stabilisation process. To determine the environmental performance of FA stabilisation and carbonation, a life cycle assessment (LCA) was conducted. The LCA results of the carbonation and stabilisation processes were compared, and multiple carbonation scenarios were analysed: carbonation with different CO2 sources (incineration flue gas and flue gas from the combustion of natural gas), and different pressures (1–5 bar) and percentages of CO2 excess (10%, 55% and 100%) in the flue gas stream. Stabilisation had higher environmental impacts than carbonation due mainly to cement production and consumption. The best operating conditions of the carbonation process were found at flue gas pressures between 3 and 5 bar, since the total energy consumption decreases as the pressure increases. Moreover, the environmental benefits associated with the substitution of electricity from the grid mix made the scenarios based on the combustion of natural gas perform better than those that use the incineration gases as a CO2 source. © 2019 Elsevier Ltd},
	author_keywords = {Carbonation; Fly ash; Incineration; Life cycle assessment; Municipal solid waste},
	keywords = {Artificial life; Ash handling; Carbon dioxide; Carbonation; Cements; Energy utilization; Environmental management; Flue gases; Flues; Fly ash; Gases; Incineration; Life cycle; Municipal solid waste; Natural gas; Natural gasoline plants; Solidification; Stabilization; Waste treatment; Accelerated carbonation; Cement solidifications; Different pressures; Environmental benefits; Environmental performance; Life Cycle Assessment (LCA); Total energy consumption; Waste-to-energy plants; Waste incineration},
	correspondence_address = {M. Margallo; Departamento de Ingenierías Química y Biomolecular, Universidad de Cantabria, Santander, Avda. de Los Castros, s.n, 39005, Spain; email: margallom@unican.es},
	publisher = {Elsevier Ltd},
