	keywords = {Article; climate change; environmental factor; environmental impact; environmental sustainability; life cycle assessment; renewable energy; surface property},
	correspondence_address = {J.G. Backes; Institute of Sustainability in Civil Engineering, RWTH Aachen University, Aachen, Mies-Van-Der-Rohe-Str. 1, 52074, Germany; email: jana.backes@inab.rwth-aachen.de},
	publisher = {Springer Science and Business Media Deutschland GmbH},
