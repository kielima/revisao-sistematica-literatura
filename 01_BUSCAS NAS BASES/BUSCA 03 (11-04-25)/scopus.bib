}

@ARTICLE{Yang2023,
	author = {Yang, Huanyu and Shao, Lian and Ou, Jinping and Zhou, Zhi},
	title = {A Novel Smart CFRP Cable Based on Optical Electrical Co-Sensing for Full-Process Prestress Monitoring of Structures},
	year = {2023},
	journal = {Sensors},
	volume = {23},
	number = {11},
	doi = {10.3390/s23115261},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85161500792&doi=10.3390%2fs23115261&partnerID=40&md5=b54e41b8878684fd54b9bceb124a9563},
	abstract = {Carbon-fiber-reinforced polymer (CFRP) is a type of composite material with many superior performances, such as high tensile strength, light weight, corrosion resistance, good fatigue, and creep performance. As a result, CFRP cables have great potential to replace steel cables in prestressed concrete structures. However, the technology to monitor the stress state in real-time throughout the entire life cycle is very important in the application of CFRP cables. Therefore, an optical–electrical co-sensing CFRP cable (OECSCFRP cable) was designed and manufactured in this paper. Firstly, a brief description is outlined for the production technology of the CFRP-DOFS bar, CFRP-CCFPI bar, and CFRP cable anchorage technology. Subsequently, the sensing and mechanical properties of the OECS-CFRP cable were characterized by serious experiments. Finally, the OECS-CFRP cable was used for the prestress monitoring of an unbonded prestressed RC beam to verify the feasibility of the actual structure. The results show that the main static performance indexes of DOFS and CCFPI meet the requirements of civil engineering. In the loading test of the prestressed beam, the OECS-CFRP cable can effectively monitor the cable force and the midspan defection of the beam so as to obtain the stiffness degradation of the prestressed beam under different loads. © 2023 by the authors.},
	author_keywords = {anchorage system; CFRP cable; coaxial cable fabry–perot interferometer (CCFPI); distributed optical fiber sensor (DOFS); optical–electrical co-sensing; prestress monitoring},
	keywords = {Carbon Fiber; Commerce; Polymers; Stimuli Responsive Polymers; Anchorages (foundations); Carbon fiber reinforced plastics; Life cycle; Optical fibers; Prestressed concrete; Tensile strength; carbon fiber; plastic, carbon fiber reinforced; polymer; stimuli responsive polymer; Anchorage systems; Carbon fibre reinforced polymer; Carbon fibre reinforced polymer cables; CO sensing; Coaxial cable fabry–perot interferometer; Distributed optical fiber sensor; Distributed optical fibers sensor; Optical-; Optical–electrical co-sensing; Prestress monitoring; commercial phenomena; Corrosion resistance},
