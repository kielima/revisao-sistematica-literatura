}

@CONFERENCE{Bhakar2020449,
	author = {Bhakar, Vikrant and Sangwan, Kuldip Singh and Digalwar, Abhijeet K.},
	title = {Readiness self-assessment of cement industry for sustainable manufacturing implementation: A case study of India},
