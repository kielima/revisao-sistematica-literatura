@ARTICLE{Amitani2024,
	author = {Amitani, Asahi and Miller, Sabbie A},
	title = {Varying aggregate sizes, plasticizers, and supplementary cementitious materials to efficiently use Portland clinker in concrete},
	year = {2024},
	journal = {Environmental Research: Infrastructure and Sustainability},
	volume = {4},
	number = {4},
	doi = {10.1088/2634-4505/ad9d76},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85214660167&doi=10.1088%2f2634-4505%2fad9d76&partnerID=40&md5=b3c9e673203e1a863d6c5dbc6ebb1b03},
	abstract = {Mitigating greenhouse gas (GHG) emissions from the production of concrete, a critical infrastructure material around the world, has been highlighted as necessary to meet climate change goals. Concrete is made of water, aggregates (e.g. crushed rocks), and Portland cement (PC), a hydraulic binder. PC is the primary source of GHG emissions from concrete, a function of the emissions derived from the production of its clinker, a kilned, quenched material composed of calcium silicates that, by mass, makes up the majority of PC. While considerable attention has been given to reducing the GHG emissions from PC manufacture, better utilization of other resources used in concrete can lower the demand for the level of clinker necessary in any given mixture. In this work, we examine how changing the size of aggregates, the use of a superplasticizer (SP), and the use of supplementary cementitious materials (SCMs) can lower GHG emissions from concrete. We derive a system of equations based fundamentally on standard mixture proportioning guidelines to determine the most efficient use of PC in a concrete mixture for specified strength and workability, and we quantify GHG emissions using life cycle assessment methods. Findings show that the use of reactive SCMs can contribute to reduced GHG emissions, as can the use of a higher maximum aggregate diameter and higher SP dosage. Our models also suggest that a concrete producer could follow standard mixture proportioning guidelines and yield a mixture that has over 2 times the PC content needed. The efficient use of PC within concrete mixtures by appropriately selecting other constituents can lower GHG emissions, contributing to climate change goals. © 2025 The Author(s). Published by IOP Publishing Ltd.},
	author_keywords = {aggregate gradation; cement content; greenhouse gas emissions; material efficiency; prescriptive design},
	correspondence_address = {A. Amitani; Department of Civil and Environmental Engineering, University of California, Davis, United States; email: aamitani@ucdavis.edu},
	publisher = {Institute of Physics},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access, Gold Open Access}
}

@ARTICLE{Cooper2024,
	author = {Cooper, Jasmin and Hawkes, Adam},
	title = {Life cycle environmental trade-off of decarbonising UK industrial clusters — A cradle to gate approach},
	year = {2024},
	journal = {Science of the Total Environment},
	volume = {954},
	doi = {10.1016/j.scitotenv.2024.176101},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85203622637&doi=10.1016%2fj.scitotenv.2024.176101&partnerID=40&md5=9d4a1b0b977d2962e69229990b8902df},
	abstract = {The industrial sector is a major source of greenhouse gas (GHG) emissions due to process emissions and a heavy reliance on fossil fuels for heat and power. Methods exist to produce low carbon versions of products made in industrial clusters, including hydrogen, carbon capture and storage and alternative production methods, but these could increase burdens to other areas of the environment, such as resource depletion and water scarcity. This study compares different decarbonisation pathways for ammonia, cement, methanol and steel produced in the UK, to determine whether decarbonising could result in unintended environmental consequences. To determine this, life cycle assessment was applied to compare 267 different pathways to the conventional (fossil fuel) baseline. We find that most pathways lead to GHG emission reductions (43 to 78 % on average) but would increase impacts to other areas of the environment, including metal resources and ecotoxicity (8 % to 5-fold and 19 % to 24-fold, on average respectively). This study is the first to assess decarbonisation pathways for unintended environmental impacts and is of interest to industry, policy makers and anyone modelling industrial lifecycle emissions. © 2024 The Authors},
	author_keywords = {Decarbonisation; Environmental impacts; Environmental sustainability; Industrial clusters; Life cycle assessment},
	keywords = {United Kingdom; Carbon capture and utilization; Carbon sequestration; Greenhouse gas emissions; Life cycle assessment; ammonia; biomethanol; carbon; carbon dioxide; cement; coal; coke; ethanolamine; fossil fuel; fresh water; fuel; hydrogen; limestone; methanol; natural gas; potassium hydroxide; steel; unclassified drug; ammonia; Decarbonisation; Decarbonising; Environmental sustainability; Greenhouse gas emissions; Heat and power; Industrial cluster; Industrial sector; Low carbon; Process emissions; Trade off; carbon emission; environmental impact; greenhouse gas; industry; life cycle analysis; sustainability; trade-off; ammonia formation; aquatic environment; Article; belite ye elimite  ferrite binder  technology; bioenergy; bioenergy with carbon capture and storage; biomass; calcination temperature; carbon emission; chemical phenomena; climate change; decarbonisation; ecotoxicity; electricity electrolysis; electrolysis; electrolyte membrane; energy consumption; environmental change; environmental impact; eutrophication; freshwater consumption; gasification; greenhouse effect; Haber Bosch process; health care policy; heat; human; human health; industrial flue gas; industrial sector; industry and industrial phenomena; life cycle; ozone depletion; power analysis; resource depletion; sensitivity analysis; steam methane reforming; steel production; straw gasification; terrestrial acidification; terrestrial ecotoxicity; toxicity testing; United Kingdom; water insecurity; wood pulp; woodchip biomass; article; carbon capture and storage; controlled study; environmental impact; environmental sustainability; fossil fuel; greenhouse gas; greenhouse gas emission; life cycle assessment; Low emission},
