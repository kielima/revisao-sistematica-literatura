	author = {Zhai, Pei and Isaacs, Jacqueline A. and Eckelman, Matthew J.},
	title = {Net energy benefits of carbon nanotube applications},
	year = {2016},
	journal = {Applied Energy},
	volume = {173},
	pages = {624 – 634},
	doi = {10.1016/j.apenergy.2016.04.001},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84963800725&doi=10.1016%2fj.apenergy.2016.04.001&partnerID=40&md5=4c49ed994237255a2b0320a85878ff14},
	abstract = {Implementation of carbon nanotubes (CNTs) in various applications can reduce material and energy requirements of products, resulting in energy savings. However, processes for the production of carbon nanotubes (CNTs) are energy-intensive and can require extensive purification. In this study, we investigate the net energy benefits of three CNT-enabled technologies: Multi-walled CNT (MWCNT) reinforced cement used as highway construction material, single-walled CNT (SWCNT) flash memory switches used in cell phones and CNT anodes and cathodes used in lithium-ion batteries used in electric vehicles. We explore the avoided or additional energy requirement in the manufacturing and use phases and estimate the life cycle net energy benefits for each application. Additional scenario analysis and Monte Carlo simulation of parameter uncertainties resulted in probability distributions of net energy benefits, indicating that net energy benefits are dependent on the application with confidence intervals straddling the breakeven line in some cases. Analysis of simulation results reveals that SWCNT switch flash memory and MWCNT Li-ion battery cathodes have statistically significant positive net energy benefits (α = 0.05) and SWCNT Li-ion battery anodes tend to have negative net energy benefits, while positive results for MWCNT-reinforced cement were significant only under an efficient CNT production scenario and a lower confidence level (α = 0.1). © 2016 Elsevier Ltd.},
	author_keywords = {Carbon nanotube; Environmental analysis; Life cycle assessment; Lithium ion battery; Net energy analysis; Uncertainty analysis},
	keywords = {Anodes; Cathodes; Cellular telephone systems; Cements; Electric batteries; Electric switches; Electrodes; Energy conservation; Flash memory; Highway engineering; Intelligent systems; Ions; Life cycle; Lithium; Lithium alloys; Lithium compounds; Lithium-ion batteries; Mobile phones; Monolithic microwave integrated circuits; Monte Carlo methods; Multiwalled carbon nanotubes (MWCN); Nanotubes; Probability distributions; Reinforcement; Secondary batteries; Uncertainty analysis; Yarn; Analysis of simulations; Confidence interval; Confidence levels; Energy requirements; Environmental analysis; Life Cycle Assessment (LCA); Net energy analysis; Parameter uncertainty; carbon; cement; electrode; electronic equipment; energy conservation; environmental assessment; life cycle analysis; lithium; manufacturing; Monte Carlo analysis; nanoparticle; nanotechnology; purification; uncertainty analysis; Carbon nanotubes},
