@ARTICLE{Khan2023348,
	author = {Khan, Md. Musharof Hussain and Havukainen, Jouni and Niini, Arvo and Leminen, Ville and Horttanainen, Mika},
	title = {Consequential life-cycle assessment of treatment options for repulping reject from liquid packaging board waste treatment},
	year = {2023},
	journal = {Waste Management},
	volume = {155},
	pages = {348 – 356},
	doi = {10.1016/j.wasman.2022.10.026},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85142330110&doi=10.1016%2fj.wasman.2022.10.026&partnerID=40&md5=a124a9ac1c8946cc766b0322104e36a4},
	abstract = {Liquid packaging board is one of the highly demanded packaging mediums for liquid food and beverages, generating substantial waste each year. Even though the fibre part of the liquid packaging board is recycled through a repulping process, the plastic and aluminium are usually used for energy recovery and as alternative raw materials in cement factories. This practice reduces the life span and economic value of plastic and aluminium, which does not fit within a circular economy. The plastic and aluminium from liquid packaging board waste can be recycled mechanically and chemically. This study used the consequential life-cycle assessment method to compare the environmental impact of the recovery options of rejected materials from liquid packaging board waste treatment. Four scenarios were established: (1) energy recovery by waste incineration, (2) composite pallet production by mechanical recycling, (3) plastic pallet production by mechanical recycling, and (4) plastic pallet production by chemical recycling. The study showed that when the consumed energy was supplied from renewable sources, plastic pallet production by mechanical recycling process had the lowest environmental impact, and energy recovery by waste incineration had the highest impact. A sensitivity analysis revealed that composite pallet production by mechanical recycling process showed the best impact if the energy was sourced from the average production mix, and plastic pallet production by chemical recycling had the lowest impact when mechanically recycled plastic substituted for 0%, 30%, and 50% of virgin plastic. These results should be of interest to liquid packaging board manufacturers and other related stakeholders. © 2022 The Author(s)},
	author_keywords = {Chemical treatment; Consequential life cycle assessment; Liquid packaging board; Mechanical treatment; Plastic-fibre composite material; Pyrolysis; Waste to energy},
	keywords = {Aluminum; Incineration; Plastics; Product Packaging; Recycling; Aluminum; Chemical analysis; Liquids; Packaging; Packaging materials; Pallets; Sensitivity analysis; Waste incineration; Waste treatment; plastic; aluminum; Chemical treatments; Consequential life-cycle assessment; Fibre composite materials; Liquid packaging board; Mechanical recycling; Mechanical treatments; Plastic fibers; Plastic pallets; Plastic-fiber composite material; Waste to energy; comparative study; composite; environmental impact; life cycle analysis; plastic waste; pyrolysis; waste treatment; Article; beverage; energy recovery; environmental impact; environmental impact assessment; incineration; life cycle assessment; liquid packaging board; nonhuman; packaging; recycling; repulping; sensitivity analysis; waste management; waste-to-energy; recycling; Life cycle},
