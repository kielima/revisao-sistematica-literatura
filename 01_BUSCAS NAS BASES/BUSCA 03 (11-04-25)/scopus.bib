	title = {A materials life cycle assessment of a net-zero energy building},
	year = {2013},
	journal = {Energies},
	volume = {6},
	number = {2},
	pages = {1125 – 1141},
	doi = {10.3390/en6021125},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84874727040&doi=10.3390%2fen6021125&partnerID=40&md5=858d427c089b2ea442b8feffc42298c0},
	abstract = {This study analyzed the environmental impacts of the materials phase of a net-zero energy building. The Center for Sustainable Landscapes (CSL) is a three-story, 24,350 square foot educational, research, and administrative office in Pittsburgh, PA, USA. This net-zero energy building is designed to meet Living Building Challenge criteria. The largest environmental impacts from the production of building materials is from concrete, structural steel, photovoltaic (PV) panels, inverters, and gravel. Comparing the LCA results of the CSL to standard commercial structures reveals a 10% larger global warming potential and a nearly equal embodied energy per square feet, largely due to the CSL's PV system. As a net-zero energy building, the environmental impacts associated with the use phase are expected to be very low relative to standard structures. Future studies will incorporate the construction and use phases of the CSL for a more comprehensive life cycle perspective. © 2013 by the authors.},
	author_keywords = {Green buildings; Life cycle assessment; Living building challenge},
