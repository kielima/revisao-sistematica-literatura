	author = {Qadourah, Jenan Abu and Al-Falahat, Ala'a M. and Alrwashdeh, Saad S.},
	title = {INVESTIGATE THE CARBON FOOTPRINTS OF THREE INTERMEDIATE FLOORING SYSTEMS: CROSS-LAMINATED TIMBER, SOLID CONCRETE, AND HOLLOW-CORE PRECAST CONCRETE},
