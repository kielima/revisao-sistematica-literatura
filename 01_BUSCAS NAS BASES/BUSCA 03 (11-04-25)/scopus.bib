	title = {The greenway for bridge column rehabilitation: a comparison between different techniques based on multi-criteria decision analysis; [O caminho verde para pilares de pontes: uma comparação entre as operações de retrofitting e substituição com análise de decisão multicritério]},
	year = {2022},
