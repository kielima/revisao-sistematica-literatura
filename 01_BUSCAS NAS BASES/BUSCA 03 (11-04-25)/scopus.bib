	note = {Cited by: 2; All Open Access, Gold Open Access, Green Open Access}
}

@ARTICLE{Asghari202465,
	author = {Asghari, Nima and Memari, Ali M.},
	title = {State of the Art Review of Attributes and Mechanical Properties of Hempcrete},
	year = {2024},
	journal = {Biomass (Switzerland)},
