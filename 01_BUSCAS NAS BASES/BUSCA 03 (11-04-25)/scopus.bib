}

@ARTICLE{Santos2024,
	author = {Santos, F.C. and Rohden, A.B. and Palu, S.M.K. and Garcez, M.R.},
	title = {Sustainability-oriented assessment of pavement technologies: A case study of a heavy-traffic highway in Brazil},
	year = {2024},
	journal = {Case Studies in Construction Materials},
	volume = {20},
	doi = {10.1016/j.cscm.2024.e03337},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85194422326&doi=10.1016%2fj.cscm.2024.e03337&partnerID=40&md5=bef1df553c39fca1caa184dfd84b449f},
	abstract = {The paper proposes a sustainability-oriented assessment through a case study based on the duplication project of one of the most critical federal highways for cargo transport in Southern Brazil, considering the most common pavement technologies used in the country. The framework consists of concatenating life cycle impacts determined through life cycle assessment, the corresponding social effects regarding the population's health and well-being, and the life cycle cost. Results show that while hot mix asphalt contributed 30% more to the damage of natural resources, the Portland cement concrete contributed 16% more to harming ecosystem quality and 27% to harming human health. The photochemical oxidation and climate change potential of Portland cement concrete was 33% and 68% higher than those of hot mix asphalt. The toxic substances potentially released in ecosystems were 27% (freshwater), 15% (marine), and 11% (terrestrial) higher for Portland cement concrete. In contrast, ozone layer depletion potential, cumulative energy demand, and net present value were 36%, 29%, and 89% higher for hot mix asphalt, and the acidification and eutrophication impacts surpassed those of Portland cement concrete by 10% and 8%. Maintenance services are the hotspots for both pavement technologies throughout the life cycle. The significance of the proposed framework relies on guiding local strategic initiatives at the government and agency levels, assisting decision-making processes, and designing business models that meet sustainability requirements for road infrastructure in emerging countries where sustainability-oriented practices are not yet consolidated. © 2024 The Authors},
	author_keywords = {Asphalt concrete; Portland cement concrete; Road transport; Sustainability},
	keywords = {Asphalt concrete; Climate change; Concrete pavements; Concretes; Decision making; Ecosystems; Eutrophication; Ozone layer; Portland cement; Sustainable development; Cargo transport; Case-studies; Heavy traffics; Hot mix asphalt; Life cycle impacts; Pavement technology; Population health; Portland cement concretes; Road transports; Southern Brazil; Life cycle},
	correspondence_address = {M.R. Garcez; Civil Engineering Post‑Graduation Program: Construction and Infrastructure, Federal University of Rio Grande do Sul, Rio Grande do Sul, 99 Osvaldo Aranha St. 7th floor, Porto Alegre, 90035-190, Brazil; email: monica.garcez@ufrgs.br},
	publisher = {Elsevier Ltd},
	language = {English},
