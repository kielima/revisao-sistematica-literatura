@ARTICLE{Keyhani20245370,
	author = {Keyhani, Maryam and Bahadori-Jahromi, Ali and Fu, Changfeng and Godfrey, Paulina and Zhang, Hexin},
	title = {Whole-Life Embodied Carbon Reduction Strategies in UK Buildings: A Comprehensive Analysis},
	year = {2024},
	journal = {Energy Science and Engineering},
