@CONFERENCE{Zucca20232497,
	author = {Zucca, M. and Puppio, M.L. and Mistretta, F. and Landi, F. and Formichi, P. and Croce, P.},
	title = {Corrosion effects of RC bridges considering the climate change impact},
	year = {2023},
	journal = {Life-Cycle of Structures and Infrastructure Systems - Proceedings of the 8th International Symposium on Life-Cycle Civil Engineering, IALCCE 2023},
	pages = {2497 – 2504},
	doi = {10.1201/9781003323020-304},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186738910&doi=10.1201%2f9781003323020-304&partnerID=40&md5=fdb69e206e299fb00bc1fe961f496037},
	abstract = {Climate change is associated with significant variations of temperature, atmospheric humidity, and carbon dioxide concentration levels. These changes potentially produce a double negative effect on the safety and the life cycle of civil engineering structures: increased climatic actions and rate of material degradation. In fact, changes in these variables affect the service life of reinforced concrete and steel structures by acting on the rate of carbonation and corrosion. Corrosion has a detrimental effect especially on the seismic vulnerability influencing strength, ductility and affecting the dynamic response and consequently the failure of reinforced concrete structures. Particularly bridges, as structures directly exposed to the weather effects, are more susceptible to these phenomena. In this paper, a framework to quantitatively account for the effects of climate change on carbonation-induced corrosion is proposed, focusing on the loss of concrete passivity, and thus widespread corrosion. Different scenarios for the expected variations in CO2 concentrations and temperature are analyzed and seismic risk indexes are evaluated through a real case study of bridge located in the province of Massa-Carrara (Italy). © 2023 The Author(s).},
	keywords = {Atmospheric corrosion; Atmospheric humidity; Carbon dioxide; Carbonation; Climate change; Concrete buildings; Concrete construction; Corrosive effects; Life cycle; Reinforced concrete; Risk perception; Steel corrosion; Carbon dioxide concentrations; Civil engineering structures; Climate change impact; Concentration levels; Corrosion effects; Double negatives; Materials degradation; RC bridges; Reinforced concrete structures; Seismic vulnerability; Seismology},
