	keywords = {Concrete buildings; Concrete construction; Concretes; Decision making; Office buildings; Project management; Case-studies; Circular economy; Decision support framework; End of life managements; End-of-life managements; Energy demands; Multicriteria decision-making; Multicriterion decision makings; Performance based; Resource efficiencies},
