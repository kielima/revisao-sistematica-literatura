}

@ARTICLE{Cho20201049,
	author = {Cho, Namho and El Asmar, Mounir and Underwood, Shane and Kamarianakis, Yiannis},
	title = {Long-Term Performance Benefits of the Design-Build Delivery Method Applied to Road Pavement Projects in the U.S.},
	year = {2020},
