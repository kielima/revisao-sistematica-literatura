	author = {Zhang, Xiaoyue and Huang, Wanru and Khajehpour, Mehdi and Asgari, Mehrdad and Tannert, Thomas},
	title = {STRUCTURAL AND LIFE CYCLE ANALYSES FOR A TIMBER-CONCRETE HYBRID BUILDING},
	year = {2023},
	journal = {13th World Conference on Timber Engineering, WCTE 2023},
