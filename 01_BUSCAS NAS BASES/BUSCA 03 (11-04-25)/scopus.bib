@CONFERENCE{Ryklová2019,
	author = {Ryklová, P. and Mančík, S. and Lupíšek, A.},
	title = {Environmental Benefits of Timber-Concrete Prefabricated Construction System for Apartment Buildings- A Simplified Comparative LCA Study},
	year = {2019},
	journal = {IOP Conference Series: Earth and Environmental Science},
