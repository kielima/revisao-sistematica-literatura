	doi = {10.1016/j.heliyon.2023.e21399},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85174970948&doi=10.1016%2fj.heliyon.2023.e21399&partnerID=40&md5=293908508fb537285272b9e8e708c514},
	abstract = {As a new construction form, modular integrated construction (MiC) can effectively improve the construction quality and productivity, especially for the construction of high-density and high-rise buildings. However, the current MiC quality inspection relies on manual inspection, which is inefficient and unreliable. Systematic research on digital inspection techniques (DITs) is fragmented and unable to fully realize the potential of the MiC industry. This study aims to explore the current state of DIT applications in MiC and to summarize the knowledge in the field through an analysis of 248 relevant literatures. Accordingly, this study combines bibliometric analysis, and a system engineering evaluation approach based on 3D structures (time, knowledge, and logic) to provide an overview of the current state of DIT development. The overview includes the application of DITs from a whole life cycle perspective, the DIT knowledge structure, specific DIT applications, as well as current challenges and future prospects. © 2023 The Authors},
