}

@ARTICLE{Ujaczki20182498,
	author = {Ujaczki, Éva and Feigl, Viktória and Molnár, Mónika and Cusack, Patricia and Curtin, Teresa and Courtney, Ronan and O'Donoghue, Lisa and Davris, Panagiotis and Hugi, Christoph and Evangelou, Michael WH and Balomenos, Efthymios and Lenz, Markus},
	title = {Re-using bauxite residues: benefits beyond (critical raw) material recovery},
