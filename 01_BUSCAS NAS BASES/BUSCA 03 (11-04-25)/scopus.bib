}@ARTICLE{Kriskova2025,
	author = {Kriskova, Lubica and Ducman, Vilma and Loncnar, Mojca and Tesovnik, Anže and Žibret, Gorazd and Skentzou, Dimitra and Georgopoulos, Christos},
	title = {Alkali-Activated Mineral Residues in Construction: Case Studies on Bauxite Residue and Steel Slag Pavement Tiles},
	year = {2025},
	journal = {Materials},
	volume = {18},
	number = {2},
