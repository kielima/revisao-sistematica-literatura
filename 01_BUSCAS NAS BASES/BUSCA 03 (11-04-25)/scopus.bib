@ARTICLE{Du Plooy20172,
	author = {Du Plooy, R.F. and Gräbe, P.J.},
	title = {Characterisation of rigid polyurethane foam-reinforced ballast through cyclic loading box tests},
	year = {2017},
	journal = {Journal of the South African Institution of Civil Engineering},
	volume = {59},
	number = {2},
	pages = {2 – 10},
	doi = {10.17159/2309-8775/2017/v59n2a1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85026385337&doi=10.17159%2f2309-8775%2f2017%2fv59n2a1&partnerID=40&md5=5cc110d556c129eff766d8f8ad0c299b},
	abstract = {As train speeds and heavy haul axle loads constantly increase due to market demands, so do the stresses and strains experienced by track structures. This is especially true for track transitions that generate high dynamic forces on both the track and vehicles because of poor vertical track geometry and/or differing track stiffness values on either side of the track transition. Reducing differential settlement between the two track structures at a track transition is one method of improving the life of the track, and increasing maintenance intervals. In this study, rigid polyurethane foam was used to reinforce ballast. Tests were conducted using a dynamic hydraulic load frame and a single sleeper in a large ballast box subjected to heavy haul axle loads. Unreinforced, reinforced and 50% reinforced ballast layers of 300 mm depth were tested to approximately 5 000 000 load cycles. The results showed that rigid polyurethane foamreinforced ballast exhibited in the order of 60% less settlement for a fully reinforced layer, and 42% less settlement for a half reinforced layer. The use of rigid polyurethane foam (RPF) to reinforce ballast has a number of benefits that could result in better track geometry and longer maintenance cycles, in turn resulting in lower life cycle costs.},
	author_keywords = {Ballast; Ballast breakdown; Ballast settlement; Concrete sleepers; Cyclic loading; Rigid polyurethane foam},
	keywords = {Axles; Ballast (railroad track); Cyclic loads; Elasticity; Polyurethanes; Railroad tracks; Reinforcement; Rigid foamed plastics; Structural design; Ballast settlement; Concrete sleeper; Maintenance cycles; Maintenance intervals; Reinforced layers; Rigid polyurethane foams; Track stiffness; Track structure; Loads (forces)},
	publisher = {South African Institute of Civil Engineers},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 28; All Open Access, Gold Open Access, Green Open Access}
