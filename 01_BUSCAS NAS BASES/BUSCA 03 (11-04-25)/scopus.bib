@CONFERENCE{Nasser20212927,
	author = {Nasser, H. and van Steen, C. and Vrijdaghs, R. and Vandewalle, L. and Verstrynge, E.},
	title = {Experimental investigation of corrosion damage on reinforced concrete beams to correlate crack width and mass loss},
	year = {2021},
	journal = {Bridge Maintenance, Safety, Management, Life-Cycle Sustainability and Innovations - Proceedings of the 10th International Conference on Bridge Maintenance, Safety and Management, IABMAS 2020},
