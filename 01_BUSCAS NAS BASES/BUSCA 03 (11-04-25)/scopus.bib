	title = {Evaluating Carbon Emissions during Slurry Shield Tunneling for Sustainable Management Utilizing a Hybrid Life-Cycle Assessment Approach},
	year = {2024},
	journal = {Sustainability (Switzerland) },
	volume = {16},
	number = {7},
