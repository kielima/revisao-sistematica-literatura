@ARTICLE{Palacios-Munoz2019,
	author = {Palacios-Munoz, Beatriz and Peuportier, Bruno and Gracia-Villa, Luis and López-Mesa, Belinda},
	title = {Sustainability assessment of refurbishment vs. new constructions by means of LCA and durability-based estimations of buildings lifespans: A new approach},
	year = {2019},
	journal = {Building and Environment},
	volume = {160},
	doi = {10.1016/j.buildenv.2019.106203},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85067868776&doi=10.1016%2fj.buildenv.2019.106203&partnerID=40&md5=8b9d1b4211fd9bd480e60aae1d18950c},
	abstract = {A common practice in Life Cycle Assessment (LCA) of buildings is to consider a default value for their lifespans. However, statistical data show longer lifespans and it is proved that the higher they are the lower the environmental impacts. Therefore, the common practice of considering a default value for lifespans in buildings LCA involves a high risk of programmed obsolescence in the building sector. This paper addresses a new approach to estimate buildings lifespans based on their structures durability. We use a comparative case study of refurbishment vs. new construction to illustrate its use. The lifespans of the refurbished and the new buildings are estimated by applying degradation models of reinforced concrete structures. Two thermal performance levels are evaluated: standard and passive, in both alternatives, the refurbished and the new building. Comparisons are also made with other approaches to determine buildings lifespans based on default value and statistical data. Results show that a new building can have a lifespan more than six times longer than a refurbished one. A strong dependence of LCA results on the lifespan is revealed. Its value can alter the order of preference of the solutions when comparing alternatives and therefore default value approaches are unadvisable. There is in our case study a 11% potential of environmental improvement for new buildings behaviour by changing current practices and extending buildings’ lifespan up to their physical limit. © 2019 Elsevier Ltd},
	author_keywords = {Energy consumption; Life cycle assessment; Lifespan; New construction; Refurbishment; Reinforced concrete},
	keywords = {Buildings; Durability; Energy utilization; Environmental impact; Obsolescence; Reinforced concrete; Restoration; Statistics; Sustainable development; Environmental improvements; Life Cycle Assessment (LCA); Life span; New constructions; Refurbishment; Strong dependences; Sustainability assessment; Thermal Performance; building construction; concrete structure; durability; energy use; life cycle analysis; refurbishment; reinforced concrete; Life cycle},
	correspondence_address = {B. López-Mesa; University of Zaragoza, School of Engineering and Architecture, Department of Architecture, Zaragoza, María de Luna 3, C.P. 50018, Spain; email: belinda@unizar.es},
	publisher = {Elsevier Ltd},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 65; All Open Access, Green Open Access}
}

