	note = {Cited by: 4; All Open Access, Gold Open Access}
}

@ARTICLE{Tomatis2020,
	author = {Tomatis, Marco and Jeswani, Harish Kumar and Stamford, Laurence and Azapagic, Adisa},
	title = {Assessing the environmental sustainability of an emerging energy technology: Solar thermal calcination for cement production},
	year = {2020},
	journal = {Science of the Total Environment},
	volume = {742},
	doi = {10.1016/j.scitotenv.2020.140510},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85087331371&doi=10.1016%2fj.scitotenv.2020.140510&partnerID=40&md5=b2d6e68e5a235a6e665020ea737c7f71},
	abstract = {Cement production is a highly energy-intensive process, contributing 7% to global CO2 emissions. Over 80% of the energy used in cement production is consumed by the calcination process. This paper considers a novel solar thermal technology for calcination, to investigate if it could help mitigate the climate change and other environmental impacts from cement production on a life cycle basis. The following three solar options are compared to conventional fossil-fuel calcination via life cycle assessment: a full solar system, which provides all the required thermal energy, and two hybrid systems, where the solar system provides 14% and 33% of the thermal energy, respectively. The results show that all three solar options have lower impacts than conventional calcination in 14 out of 17 categories. The full solar system is the best alternative, with major reductions in climate change (48%), fossil depletion (75%), photochemical ozone formation (92%) and terrestrial ecotoxicity (79%). Based on insolation levels in different parts of the world, the solar systems could be applied to 26% of current global cement production. This would reduce the climate change impact by 15–40%, as well as most other impacts by 14–87%, depending on the fuel mix. However, a limiting factor might be two times greater land occupation than by the conventional process. Furthermore, the solar system has higher human toxicity-cancer (102%) and metals and minerals depletion (6%) due to the construction of solar facilities. Coupling conventional calcination with carbon capture and storage (CCS) is more efficient in reducing the climate change impact (63%) than the solar system (48%) relative to conventional calcination without CCS. However, adding CCS to the solar calciner would still be a better option, decreasing the impact by 81% relative to conventional calcination without CCS. These findings will be of interest to the solar and cement industries as well as other industrial sectors using high-temperature processes. © 2018 Elsevier B.V.},
	author_keywords = {Cement production; Climate change; Environmental sustainability; Life cycle assessment; Solar calcination; Solar energy},
	keywords = {Artificial life; Calcination; Carbon capture; Cement industry; Cements; Climate change; Environmental impact; Environmental technology; Fossil fuels; Hybrid systems; Solar heating; Solar system; Sustainable development; Thermal energy; ammonia; antimony; arsenic; beryllium; cadmium; carbon dioxide; carbon monoxide; chromium; copper; dioxin; hydrochloric acid; lead; mercury; nickel; nitrogen oxide; selenium; sulfur dioxide; thallium; tin; vanadium; volatile organic compound; zinc; Carbon capture and storages (CCS); Climate change impact; Emerging energy technologies; Environmental sustainability; High temperature process; Life Cycle Assessment (LCA); Photochemical ozone; Solar thermal technology; alternative energy; carbon dioxide; cement (construction material); environmental planning; high temperature; life cycle analysis; renewable resource; solar power; sustainability; acidification; Article; cement industry; climate change; controlled study; ecotoxicity; energy technology; environmental impact; environmental impact assessment; environmental sustainability; eutrophication; fossil; human; ionizing radiation; land use; life cycle assessment; malignant neoplasm; ozone depletion; particulate matter; photochemical ozone formation; priority journal; renewable energy; solar thermal energy; technology; two hybrid system; Life cycle},
	correspondence_address = {A. Azapagic; Sustainable Industrial Systems, Department of Chemical Engineering and Analytical Science, The University of Manchester, Manchester, M13 9PL, United Kingdom; email: adisa.azapagic@manchester.ac.uk},
	publisher = {Elsevier B.V.},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
