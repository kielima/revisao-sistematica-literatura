@ARTICLE{Varona2020,
	author = {Varona, Francisco B. and Baeza-Brotons, Francisco and Tenza-Abril, Antonio J. and Baeza, F. Javier and Bañón, Luis},
	title = {Residual compressive strength of recycled aggregate concretes after high temperature exposure},
	year = {2020},
	journal = {Materials},
	volume = {13},
	number = {8},
	doi = {10.3390/MA13081981},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084845970&doi=10.3390%2fMA13081981&partnerID=40&md5=c860e0259fa7a0924e29314f0ed54902},
	abstract = {Sustainability requirements are gaining importance in the construction industry, which needs to take specific measures in the design and construction of concrete structures. The use of recycled aggregates in concrete may be of special interest. Recycling a construction waste will close the life cycle of the original materials (e.g., concrete). Thus, environmental benefits would come from the lower waste generation, and from a lower necessity of raw materials for new structures. The current Spanish code for structural concrete considers the use of recycled aggregates in replacement rates up to 20% by aggregate mass, assimilating their properties with those of concretes without aggregate replacement. Higher substitution percentages would require further testing. In this work, substitution of coarse aggregate for recycled aggregates (with replacement percentages of 25%, 50% and 100%) has been studied, and the concrete's residual properties after exposure to high temperatures (between 350 °C and 850 °C) have been assessed. Compressive strength and capillary water absorption tests were made after heating, and the experiments showed higher residual strength in concretes with the greatest content of recycled aggregates. However, a statistical analysis made with additional data available in the literature seemed to predict otherwise, and the recycled aggregate replacement would have a negative effect on the residual strength. © 2020 by the authors.},
	author_keywords = {Fire engineering; High temperature; Mechanical properties; Recycled concrete; Sustainability},
	keywords = {Aggregates; Compressive strength; Concrete aggregates; Concrete industry; Construction industry; Life cycle; Recycling; Sustainable development; Water absorption; After high temperature; Capillary water absorption; Construction wastes; Design and construction; Environmental benefits; Recycled aggregate concrete; Residual compressive strength; Structural concretes; Concretes},
	correspondence_address = {F.B. Varona; Department of Civil Engineering, University of Alicante, Alicante, 03690, Spain; email: borja.varona@ua.es},
	publisher = {MDPI AG},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
