	author = {Platz, S. and Ahrens, F. and Bendel, J. and Meyer, H.H.D. and Erhard, M.H.},
	title = {What happens with cow behavior when replacing concrete slatted floor by rubber coating: A case study},
	year = {2008},
	journal = {Journal of Dairy Science},
