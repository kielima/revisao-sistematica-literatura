@ARTICLE{Dobaj2023,
	author = {Dobaj, Jürgen and Macher, Georg and Ekert, Damjan and Riel, Andreas and Messnarz, Richard},
	title = {Towards a security-driven automotive development lifecycle},
	year = {2023},
	journal = {Journal of Software: Evolution and Process},
	volume = {35},
