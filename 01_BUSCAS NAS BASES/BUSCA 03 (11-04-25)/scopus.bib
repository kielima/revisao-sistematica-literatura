@ARTICLE{Volk2023,
	author = {Volk, Rebekka and Steins, Justus J. and Kreft, Oliver and Schultmann, Frank},
	title = {Life cycle assessment of post-demolition autoclaved aerated concrete (AAC) recycling options},
	year = {2023},
	journal = {Resources, Conservation and Recycling},
	volume = {188},
	doi = {10.1016/j.resconrec.2022.106716},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140480433&doi=10.1016%2fj.resconrec.2022.106716&partnerID=40&md5=457e96b9e14dc7a836ed6a19c24e502c},
	abstract = {Autoclaved aerated concrete (AAC) is a widely used building material for masonry units, prefabricated reinforced components, and lightweight mineral insulation boards. Its low thermal conductivity and good fire resistance increase its popularity in residential buildings. Thus, post-demolition wastes are expected to increase in the future. However, post-demolition AAC (pd-AAC) is mainly disposed in landfills while landfill capacities decrease and legal framework conditions in Europe are tightening. This study performed life cycle assessments (LCA) of different pd-AAC recycling options and compared them to each other and to current landfilling to identify the best end-of-life handling of pd-AAC from an ecological perspective. The functional unit was 1 kg pd-AAC, and the system boundaries included pd-AAC at the demolition site, transports, pd-AAC treatment, and secondary production processes. Final products of the recycling process gained environmental credits/rewards for avoiding primary production using system expansion. Providing primary resources, primary production, and use phase were not in the scope of this study. Results show that especially closed-loop recycling of pd-AAC in AAC production has a high potential of improving environmental impacts. In the best recycling option (high substitution in AAC-0.35), potential savings per kg pd-AAC compared to landfilling reach up to 0.5 kg CO2-Eq, 7 MJ fossil resources, 0.005 mol H+-Eq (acidification), 0.17 CTU (freshwater ecotoxicity), 0.2 g P-Eq (freshwater eutrophication), 5.2 × 10-9 CTUh (carcinogenic effects), 4.4 × 10-8 CTUh (non-carcinogenic effects), 2.5 × 10-5 g CFC-11-Eq (ozone layer depletion), and 1.6 g NMVOC-Eq (photochemical ozone creation). Despite data uncertainties, recycling of pd-AAC is advantageous for several recycling options, including the production of AAC, light mortar, lightweight aggregate concrete, and shuttering blocks made from concrete without fine fractions (no-fines concrete). In Germany, up to 280,000 t CO2-Eq could have been saved in 2022 by pd-AAC recycling using different recycling options instead of landfilling. © 2022},
	author_keywords = {Circular economy; Environmental accounting; Industrial ecology; Life cycle assessment; Post-demolition autoclaved aerated concrete (pd-AAC); Recycling options},
	keywords = {Carbon dioxide; Concrete aggregates; Demolition; Eutrophication; Fire resistance; Land fill; Light weight concrete; Ozone; Ozone layer; Recycling; Water; Water absorption; autoclaved aerated concrete; concrete; unclassified drug; Autoclaved aerated concrete; Circular economy; Concrete recycling; Environmental accountings; Industrial ecology; Landfilling; Life cycle assessment; Post-demolition autoclaved aerated concrete; Primary production; Recycling options; comparative study; concrete; demolition; industrial ecology; landfill; life cycle analysis; recycling; acidification; Article; carcinogenicity; construction and demolition waste; controlled study; ecological procedures; ecotoxicity; environmental accounting; environmental aspects and related phenomena; environmental impact; eutrophication; fossil; freshwater ecotoxicity; landfill; life cycle assessment; Monte Carlo method; ozone layer; photochemistry; recycling; sensitivity analysis; uncertainty; Life cycle},
	correspondence_address = {R. Volk; Karlsruhe Institute of Technology (KIT), Institute for Industrial Production (IIP), Karlsruhe, Hertzstraße 16; email: rebekka.volk@kit.edu},
	publisher = {Elsevier B.V.},
