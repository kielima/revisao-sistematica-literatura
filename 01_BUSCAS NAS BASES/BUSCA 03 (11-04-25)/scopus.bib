	title = {Sustainable Concrete Pavements: A Comparative Analysis of Biochar-Supplemented and Conventional Concrete in terms of Strength, Carbon Emissions, and Cost},
	year = {2024},
	journal = {Journal of Physics: Conference Series},
	volume = {2779},
