@ARTICLE{Giresini2021,
	author = {Giresini, Linda and Stochino, Flavio and Sassu, Mauro},
	title = {Economic vs environmental isocost and isoperformance curves for the seismic and energy improvement of buildings considering Life Cycle Assessment},
	year = {2021},
	journal = {Engineering Structures},
	volume = {233},
	doi = {10.1016/j.engstruct.2021.111923},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85101157124&doi=10.1016%2fj.engstruct.2021.111923&partnerID=40&md5=3c6cb90f5c814d8c7ccd6f17d7e9f578},
	abstract = {A methodology to quantitatively assess the improvement of seismic and energy performance of masonry buildings through retrofitting interventions is here proposed. The approach is developed at mesoscale level, considering entire façades with openings and taking into account Life Cycle Assessment (LCA). The costs of retrofitting interventions that couple effects of seismic and thermal improvement (called integrated interventions/approaches) are different whether only the construction phase or the entire life cycle of the building is considered. Therefore, it is necessary to estimate at what extent it is correct to neglect LCA in the analysis of integrated approaches. In this paper, the analysis of three masonry façades is performed with and without LCA. Traditional (insulating panels, diatons, ferro-cement) and more innovative interventions (carbon and glass fiber reinforced polymer composites) are considered. For the comparison, isocost and isoperformance curves, which determine both the economic (Euros) and environmental costs (kg CO2eq) for each intervention, are discussed. The comparison shows the necessity of always considering LCA for a reliable assessment: some retrofitting interventions are the most expensive in the construction phase but they result the most convenient in economic terms and in the amount of CO2eq emissions. © 2021 Elsevier Ltd},
	author_keywords = {Global warming; Greenhouses gases; Integrated intervention; Isocost curves; Isoperformance curves; Life Cycle Assessment; Masonry buildings; Seismic vulnerability assessment; Sustainable buildings},
	keywords = {Fiber reinforced plastics; Masonry materials; Retrofitting; Seismology; Construction phase; Energy performance; Entire life cycles; Environmental costs; Glass-fiber reinforced polymer composites; Integrated approach; Life Cycle Assessment (LCA); Reliable assessment; building; earthquake engineering; global warming; greenhouse gas; life cycle analysis; masonry; performance assessment; seismic response; seismic retrofit; Life cycle},
	correspondence_address = {L. Giresini; Largo Lucio Lazzarino 1, Pisa, 56100, Italy; email: linda.giresini@unipi.it},
