@ARTICLE{El Mendili2022760,
	author = {El Mendili, Yassine and Benzaama, Mohammed-Hichem},
	title = {Investigation of Mechanical and Thermal Performance of Concrete with Scallop Shells as Partial Cement Replacement: Alternative Binder and Life Cycle Assessment},
	year = {2022},
	journal = {CivilEng},
	volume = {3},
	number = {3},
