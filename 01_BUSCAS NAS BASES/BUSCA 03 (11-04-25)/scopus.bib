	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 37; All Open Access, Green Open Access}
}

@ARTICLE{Ji2022,
	author = {Ji, Chenyuan and Wu, Yitong and Zhao, Zengfeng and Chen, Chen and Yao, Lei},
