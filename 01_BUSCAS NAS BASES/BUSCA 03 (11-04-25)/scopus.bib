@CONFERENCE{Capacci20241008,
	author = {Capacci, L.},
	title = {Stationary proposal importance sampling for structural reliability of aging RC bridges},
	year = {2024},
	journal = {Bridge Maintenance, Safety, Management, Digitalization and Sustainability - Proceedings of the 12th International Conference on Bridge Maintenance, Safety and Management, IABMAS 2024},
	pages = {1008 – 1018},
	doi = {10.1201/9781003483755-117},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85200336415&doi=10.1201%2f9781003483755-117&partnerID=40&md5=6ef734d793b530630a0402da545f1d7c},
	abstract = {Safety assessment of aging bridges may require the modeling of complex deterioration processes, further exacerbating in time the uncertainties involved in the mechanical response of critical members. Simulation-based techniques applied to life-cycle reliability problems may rely on time-consuming structural analyses, leading to untenable computational efforts and impairing the accuracy of the numerical estimates. This paper discusses an efficient computational framework for time-variant failure probability based on Importance Sampling (IS) with Stationary Proposal (SP) distribution. This novel methodology exploits numerical approaches traditionally developed for time-invariant structural reliability problems and extends them into a life-cycle context. Specifically, the simulation density is adaptively selected by minimizing the Kullback-Leibler Cross-Entropy from a chosen family of parametric distributions. The numerical procedure is applied to lifetime structural reliability of a reinforced concrete bridge exposed to chloride-induced corrosion. © 2024 The Author(s).},
	keywords = {Chlorine compounds; Corrosion; Deterioration; Importance sampling; Probability distributions; Reinforced concrete; Reliability; Uncertainty analysis; Computational effort; Computational framework; Deterioration process; Mechanical response; RC bridges; Reliability problems; Safety assessments; Structural reliability; Time variant; Uncertainty; Life cycle},
