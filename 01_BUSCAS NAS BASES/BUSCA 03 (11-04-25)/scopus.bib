@ARTICLE{Kim2016,
	author = {Kim, Tae Hyoung and Tae, Sung Ho},
	title = {Proposal of environmental impact assessment method for concrete in South Korea: An application in LCA (life cycle assessment)},
	year = {2016},
	journal = {International Journal of Environmental Research and Public Health},
	volume = {13},
	number = {11},
	doi = {10.3390/ijerph13111074},
