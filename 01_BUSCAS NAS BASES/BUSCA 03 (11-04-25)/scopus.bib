@ARTICLE{Pešta2020,
	author = {Pešta, Jan and Pavlů, Tereza and Fortová, Kristina and Koĉí, Vladimír},
	title = {Sustainable masonry made from recycled aggregates: LCA case study},
	year = {2020},
