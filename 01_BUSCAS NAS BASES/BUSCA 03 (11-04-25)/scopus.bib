@ARTICLE{Mussabayev2023,
	author = {Mussabayev, Turlybek Turkpenovich and Nuguzhinov, Zhmagul Smagulovich and Nemova, Darya and Kayupov, Tabyldy and Tolkynbaev, Temirkhan Anapiyaevich and Akmakanova, Assel Zhanalykovna and Khafizova, Gulzhan Sailaubekovna},
	title = {Creep of Concrete in Shell Structures: Nonlinear Theory},
	year = {2023},
	journal = {Materials},
	volume = {16},
	number = {16},
	doi = {10.3390/ma16165587},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85168778930&doi=10.3390%2fma16165587&partnerID=40&md5=0c3fd78189fc78e8bbd93c76d56e6755},
	abstract = {The creep of concrete is one of the main problems threatening concrete structural development and the stability and safety of structures. However, the nonlinear theory is the key to solving the problem of taking into account the physical and mechanical properties of concrete creep in shell structures. To create such a theory, the original shell is replaced by a continuous equivalent elastic shell. To determine the stress–strain state of the structure, the equations of nonlinear creep and crack growth are derived, and a deformation model of the section is created. The behavior of the structure at all stages of the life cycle is investigated by solving the solving systems of differential equations of equilibrium, motion, and perturbation of the equivalent shell. The values of the ratios of dependence of long-term and short-term critical loads on deformations, forces, cracks, etc., are given. The accuracy of the solution of the developed nonlinear theory is compared with the linear theory of concrete creep as well as experimental data. The results show that, according to the linear theory, for the values for the short term and long term, up to 56% and up to 39% of critical loads are overestimated, respectively. The creep process in practical engineering can be effectively controlled by the results of the proposed theory. © 2023 by the authors.},
	author_keywords = {building codes; concrete creep; nonlinear theory of calculation of structures; theory of cracks},
	keywords = {Concretes; Creep; Differential equations; Ductile fracture; Life cycle; Nonlinear equations; Concrete creep; Critical load; In-shell; Linear theory; Nonlinear theory; Nonlinear theory of calculation of structure; Shell structure; Structural development; Structure nonlinear; Theory of crack; Shells (structures)},
	correspondence_address = {T.T. Mussabayev; Construction Department, L.N. Gumilyov Eurasian National University, Astana, Kazhymukan 13, 010000, Kazakhstan; email: eti.enu@mail.ru; D. Nemova; Laboratory of Protected and Modular Structures, Peter the Great St. Petersburg Polytechnic University, Saint Petersburg, 195251, Russian Federation; email: nemova_dv@spbstu.ru},
