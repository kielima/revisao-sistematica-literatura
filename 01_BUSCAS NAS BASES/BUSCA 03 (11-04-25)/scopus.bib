	title = {Applicability of Value Stream Mapping and Work Sampling in an industrial project in India},
	year = {2018},
	journal = {IGLC 2018 - Proceedings of the 26th Annual Conference of the International Group for Lean Construction: Evolving Lean Construction Towards Mature Production Management Across Cultures and Frontiers},
	volume = {1},
