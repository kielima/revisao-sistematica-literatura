	author = {Robayo-Salazar, Rafael and Valencia-Saavedra, William and Mejía de Gutiérrez, Ruby},
	title = {Reuse of Powders and Recycled Aggregates from Mixed Construction and Demolition Waste in Alkali-Activated Materials and Precast Concrete Units},
	year = {2022},
	journal = {Sustainability (Switzerland)},
	volume = {14},
