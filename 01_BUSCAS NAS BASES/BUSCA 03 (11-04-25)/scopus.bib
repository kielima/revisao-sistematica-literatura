	author = {Shahin, Mojtaba and Hussain, Waqar and Nurwidyantoro, Arif and Perera, Harsha and Shams, Rifat and Grundy, John and Whittle, Jon},
	title = {Operationalizing Human Values in Software Engineering: A Survey},
	year = {2022},
