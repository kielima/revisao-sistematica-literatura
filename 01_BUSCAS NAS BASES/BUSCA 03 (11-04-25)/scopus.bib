@ARTICLE{Pham2021,
	author = {Pham, Andrew and Moussavi, Sussan and Thompson, Matthew and Dvorak, Bruce},
	title = {Environmental life cycle impacts of small wastewater treatment plants: Design recommendations for impact mitigation},
	year = {2021},
	journal = {Water Research},
	volume = {207},
	doi = {10.1016/j.watres.2021.117758},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85118175298&doi=10.1016%2fj.watres.2021.117758&partnerID=40&md5=33f54fdde7967a01c8a5c94771b2f76f},
	abstract = {The objective of this study was to quantify potential mitigation of environmental impacts from the operation and construction of wastewater treatment plants (WWTP) from implementing specific design recommendations. The study investigated small WWTPs, many of which are serving slow growing or declining populations. Life Cycle Assessment methodology was used to evaluate and compare the inventory and environmental impacts of nine small WWTP case studies. Detailed inventory data was collected from the facilities’ engineering design plans and utility bills. One recommended practice was to avoid significant overdesign by planning for no lower than a 75% capacity utilization by the facilities’ end-of-life. A theoretical correction to a 75% capacity utilization was estimated to mitigate 0.4% of lifetime electricity usage and 1% of secondary process concrete for every 1% reduction in design average flow rate. Relatedly, a 0.4% mitigation in the Carcinogenic and Global Warming impacts could be achieved for every 1% reduction in design average flow toward a 75% capacity utilization. Other suggested practices were focused on conveyance, namely, to minimize non-process facility area and to use polyvinyl chloride pipe instead of ductile iron pipe where possible. The latter practice was estimated to mitigate between 1.1 and 4.8% of the Carcinogenic impact in the nine case studies. © 2021 Elsevier Ltd},
	author_keywords = {Civil works; Construction materials; Life cycle assessment; Overdesign; Small communities; Wastewater treatment plant design},
	keywords = {Animals; Environment; Life Cycle Stages; Waste Disposal, Fluid; Waste Water; Water Purification; Chlorine compounds; Ductility; Environmental impact; Global warming; Polyvinyl chlorides; Sewage pumping plants; Wastewater treatment; Water treatment plants; polyvinylchloride; % reductions; Average flows; Capacity utilization; Carcinogenics; Case-studies; Civil works; Design recommendations; Overdesign; Small community; Wastewater treatment plant designs; concrete; electricity generation; environmental impact; life cycle analysis; wastewater treatment plant; acidification; Article; case study; climate change; construction work; controlled study; design; disinfection; electricity; energy consumption; engineering; environmental impact; flow rate; greenhouse effect; life cycle assessment; population growth; sludge digestion; sludge treatment; waste water treatment plant; water flow; animal; environment; life cycle stage; sewage; wastewater; water management; Life cycle},
