	title = {Use of Ground-Penetrating Radar to Detect Cement Content in Cement-Stabilized Subgrade †},
	year = {2023},
	journal = {Engineering Proceedings},
	volume = {36},
	number = {1},
	doi = {10.3390/engproc2023036004},
