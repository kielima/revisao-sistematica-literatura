@CONFERENCE{Abbott2007397,
	author = {Abbott, Ashley B. and Ellis, Michael W.},
	title = {Analysis of thermal energy collection from precast concrete roof assemblies},
	year = {2007},
	journal = {Proceedings of the Energy Sustainability Conference 2007},
	pages = {397 – 408},
	doi = {10.1115/ES2007-36011},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-37249044245&doi=10.1115%2fES2007-36011&partnerID=40&md5=ebc7c00a20610927dd0c91a5b25b5706},
	abstract = {The development of precast concrete housing systems provides an opportunity to easily and inexpensively incorporate solar energy collection by casting collector tubes into the roof structure. A design is presented for a precast solar water heating system used to aid in meeting the space and domestic water heating loads of a single-family residence. A three-dimensional transient collector model is developed to characterize the precast solar collector's performance throughout the day. The model describes the collector as a series of segments in the axial direction connected by a fluid flowing through an embedded tube. Each segment is represented by a two-dimensional solid model with top boundary conditions determined using a traditional flat plate solar collector model. The precast collector is coupled to a series solar assisted heat pump system and used to meet the heating needs of the residence. The performance of the proposed system is compared to the performance of a typical air-to-air heat pump. Using the system model, various designs and operating parameters were analyzed to determine a set of near optimal design values. The annual performance of the near optimal system was evaluated to determine the energy and cost savings for applications in Atlanta, GA and Chicago, IL. In addition, a life cycle cost was completed to determine the economic feasibility of the proposed system. The results of the annual study show that capturing solar energy using the precast collector and applying the energy through a solar assisted heat pump can reduce the electricity required for heating by more than SO percent in regions with long heating seasons such as Chicago. The life cycle cost analysis shows that the energy savings justifies the increase in initial cost in locations with long heating seasons but that the system is not economically attractive in locations with shorter heating seasons. Copyright © 2007 by ASME.},
	keywords = {Precast concrete; Roofs; Solar collectors; Solar energy; Solar water heaters; Concrete housing; Solar energy collection; Thermal energy collection; Concrete construction},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access, Green Open Access}
}

@ARTICLE{Capello200726,
	author = {Capello, Christian and Hellweg, Stefanie and Badertscher, Beat and Betschart, Hugo and Hungerbühler, Konrad},
	title = {Environmental assessment of waste-solvent treatment options. Part I: The ecosolvent tool},
	year = {2007},
	journal = {Journal of Industrial Ecology},
	volume = {11},
	number = {4},
	pages = {26 – 38},
	doi = {10.1162/jiec.2007.1231},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-36849079780&doi=10.1162%2fjiec.2007.1231&partnerID=40&md5=debecefee79524aee11a97534908e8c5},
	abstract = {The software tool ecosolvent is presented that allows for comparative environmental assessment of treatment technologies for specific, user-defined, waste-solvent mixtures. The tool is composed of models for waste-solvent distillation as well as for thermal treatment in hazardous waste-solvent incinerators and cement kilns. It was designed with a tiered structure in order to allow for a high flexibility regarding informational needs. The life-cycle assessment method was used to assess the environmental impact. The applicability of the tool is shown with two case studies from industry. In these case studies, various waste-solvent treatment technologies are compared for two specific waste-solvent mixtures. Potential use of the ecosolvent tool for its role in practical decision making in chemicals industries is illustrated by two case studies of waste-solvent systems. In the ethyl acetate case study, the tool indicates that solvent recovery by distillation is clearly better than incineration of the waste solvent. The results from the methanol case study are less clear-cut. In the subsequent article (part II), the ecosolvent tool will be used to derive general rules of thumb and specific recommendations for 45 important solvents used in chemical industries. Additionally, a framework will be presented that provides quick and easy decision support regarding environmentally optimized waste-solvent management. © 2007 by the Massachusetts Institute of Technology and Yale University.},
	author_keywords = {Cement kiln; Distillation; Hazardous waste-solvent incinerator; Industrial ecology; Life-cycle inventory (lci); Stochastic modeling},
	keywords = {Computer simulation; Computer software; Distillation; Ecology; Hazardous materials; Heat treatment; Random processes; chemical industry; comparative study; decision making; distillation; environmental impact assessment; life cycle analysis; software; solvent; waste management; waste treatment; Cement kiln; Hazardous waste-solvent incinerator; Life-cycle inventory; Stochastic modeling; Waste-solvent treatment; Environmental management},
