	doi = {10.1016/j.procir.2025.01.019},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000375316&doi=10.1016%2fj.procir.2025.01.019&partnerID=40&md5=15cbbe8e39672a2d8307fec493cf5a30},
