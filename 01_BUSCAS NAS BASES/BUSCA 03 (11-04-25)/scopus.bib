	author = {de Oliveira, Camilla C N and Zotin, Marianne Z and Rochedo, Pedro R R and Szklo, Alexandre},
	title = {Achieving negative emissions in plastics life cycles through the conversion of biomass feedstock},
	year = {2021},
	journal = {Biofuels, Bioproducts and Biorefining},
	volume = {15},
