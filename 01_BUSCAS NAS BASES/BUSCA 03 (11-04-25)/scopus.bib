@ARTICLE{Ibrion2020,
	author = {Ibrion, Michaela and Paltrinieri, Nicola and Nejad, Amir R.},
	title = {Learning from failures: Accidents of marine structures on Norwegian continental shelf over 40 years time period},
	year = {2020},
	journal = {Engineering Failure Analysis},
	volume = {111},
	doi = {10.1016/j.engfailanal.2020.104487},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081117093&doi=10.1016%2fj.engfailanal.2020.104487&partnerID=40&md5=dff9ab4d51195c9e427c1c207243fa00},
	abstract = {This paper investigates accidents, major accidents and disasters which occurred on the Norwegian Continental Shelf (NCS) over a period of more than 40 years time (1972-2013). An accident investigation based on the system life-cycle was applied on the data provided by the World Offshore Accident Database (WOAD) where the operation (in-service) stage of the life-cycle was found to be the stage with 96% and the installation stage with 4% of accident occurrences. The marine operations linked to both installation and the operation (in-service) stages are identified to be where 13% of accidents had occurred. In terms of structural types, jackets and semi-submersibles are identified with the highest number of accidents, while the highest rate of accidents per marine structure type is linked to the concrete structures where in average 5.5 accidents per each concrete structures were recorded. 1980 was the year with the highest number of fatalities on NCS within 40 years time span with the occurrence of Alexander L. Kielland disaster. There has been a reduction of number of fatalities over the years, but injuries had always been present. It was found that possible correlations can be established among occurrence of accidents and environmental loads for some months. The results and discussions contributes to learning from the 40 years accidents on the NCS with the aim of risk reduction in operation of marine structures. The predictive and preventive maintenance strategy and condition monitoring during operation (in-service) stage for each individual marine structure is promoted. However, the uncertainty is still present and risk can never be reduced to zero. © 2020 The Authors},
	author_keywords = {Marine accidents; Marine failures; Marine operations; Marine structures; Norwegian continental shelf; WOAD},
	keywords = {Accidents; Concrete buildings; Concrete construction; Concretes; Condition monitoring; Disasters; Life cycle; Marine engineering; Ocean structures; Offshore oil well production; Predictive maintenance; Preventive maintenance; Accident investigation; Environmental loads; Learning from failures; Marine accidents; Marine Operations; Norwegian continental shelves; Offshore accidents; WOAD; Failure (mechanical)},
	correspondence_address = {M. Ibrion; Department of Mechanical and Industrial Engineering, Norwegian University of Science and Technology (NTNU), Trondheim, NO-7491, Norway; email: Michaela.Ibrion@ntnu.no},
	publisher = {Elsevier Ltd},
