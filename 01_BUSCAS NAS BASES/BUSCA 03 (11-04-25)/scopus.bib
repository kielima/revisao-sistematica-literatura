@ARTICLE{Mancke2024,
	author = {Mancke, Raoul and Stephan, Dietmar and Firdous, Rafia},
	title = {Case study - Sustainable concrete development: Assessing social, environmental, and performance factors of geopolymers and CEM-I concretes},
	year = {2024},
	journal = {Case Studies in Construction Materials},
	volume = {21},
	doi = {10.1016/j.cscm.2024.e03448},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198977954&doi=10.1016%2fj.cscm.2024.e03448&partnerID=40&md5=ee5a146936d52f792b85a0493f88212f},
	abstract = {This study evaluates the environmental impacts of geopolymer concrete mixtures activated by alkali activators compared to traditional CEM-I concrete mixtures using the life cycle assessment method. The study employs the Environmental Product Declarations framework to evaluate the raw material supply chain, ensuring data comparability. Environmental Cost Indicator (ECI) is used to determine relevant environmental impact categories. New concrete mixtures are developed to increase technical performance and identify suitable applications for geopolymer concrete. The compressive strength of developed geopolymer concrete mixtures after material composition analysis is evaluated and compared to traditional CEM-I concrete mixtures. The social supply chain due diligence of the concrete mixtures is also investigated and evaluated within the context of existing or upcoming regulations for the construction sector. Results: show that all geopolymer concrete mixtures indicate lower environmental impacts, particularly in terms of Global Warming Potential and ECI. The reduction in ECI for different geopolymer concrete mixtures ranges from less than 20 % to above 60 % compared to studied CEM-I recipes. Despite the lower strength of the developed geopolymer concrete mixtures in comparison to CEM-I concrete mixtures, their performance was sufficient to meet the strength class for precast non-structural elements. The social supply chain due diligence analysis indicated potential social risks along the supply chain that may increase with the use of alternative non-cementitious binders or other additives. The study suggests a source-specific analysis of raw materials integrated with EPDs to expand them into Environmental-Social-Performance-Product-Declarations. This study provides insights into the environmental and social impacts of geopolymer concrete mixtures. © 2024 The Authors},
	author_keywords = {Alkali-activated materials; Environment Product Declaration; Environmental Cost Indicator; Geoploymer; Life cycle assessment; Low carbon concrete; Social environmental performance product declaration; Social risk assessment; Supply chain due diligence; Sustainable concrete},
	keywords = {Binders; Carbon; Compressive strength; Concrete mixtures; Construction industry; Costs; Environmental impact; Environmental management; Geopolymers; Global warming; Inorganic polymers; Life cycle; Supply chains; Sustainable development; Activated materials; Alkali-activated; Alkali-activated material; Cost indicators; Due diligence; Environment product declaration; Environmental cost indicator; Environmental costs; Environmental performance; Geoploymer; Life cycle assessment; Low carbon; Low carbon concrete; Risks assessments; Social environmental performance product declaration; Social risk assessment; Social risks; Supply chain due diligence; Sustainable concretes; Risk assessment},
