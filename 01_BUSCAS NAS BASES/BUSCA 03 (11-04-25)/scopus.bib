	author = {Chaudhary, Ranjit Kumar and Gernay, Thomas and Van Coile, Ruben},
	title = {Cost-optimization based target reliabilities for design of structures exposed to fire},
	year = {2024},
	journal = {Resilient Cities and Structures},
	volume = {3},
