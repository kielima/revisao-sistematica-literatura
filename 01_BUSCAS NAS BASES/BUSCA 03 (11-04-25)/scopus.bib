	title = {Life cycle assessment of an integrated system UASB/anaerobic biofilter with constructed wetlands and filter mixed with reactive support in the treatment of urban effluents; [Avaliação do ciclo de vida de um sistema integrado UASB/biofiltro anaeróbio com wetlands construídos e filtro misto com suporte reativo no tratamento de efluentes urbanos]},
	year = {2023},
	journal = {Engenharia Sanitaria e Ambiental},
