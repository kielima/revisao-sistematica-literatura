@ARTICLE{Alatrista Gongora20211527,
	author = {Alatrista Gongora, Giovani Rodolfo and Lu, Ray Hangyong and Hanandeh, Ali El},
	title = {Comparative life cycle assessment of aerobic treatment units and constructed wetlands as onsite wastewater treatment systems in Australia},
	year = {2021},
	journal = {Water Science and Technology},
	volume = {84},
	number = {6},
	pages = {1527 – 1540},
	doi = {10.2166/wst.2021.316},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85117395544&doi=10.2166%2fwst.2021.316&partnerID=40&md5=8802ead82381d54021bd40138f6d6db1},
	abstract = {Life Cycle Assessment was used to evaluate onsite wastewater treatment systems (OWTS): aerobic treatment unit (ATU) with reinforced concrete (C.ATU) and HDPE (H.ATU) tank; and constructed wetland (CW) with three biochar concentrations in the substrate (0%; 10, and 20% v:v), dubbed CW.BC0, CW.BC10 and CW.BC20, respectively. CML 2001 in SimaPro® was used to evaluate the impacts of the treatment of 1 m3 wastewater. The OWTS were compared on their overall environmental performance scores (OEP). ATUs have higher impacts on human toxicity, eutrophication, freshwater and marine ecotoxicity. The CW.BC20 has the lowest global warming impact (GWP) while CW.BC0 has the highest. Electricity consumption was the largest contributor to the impacts of the ATUs. PVC pipes, coir peat, geomembrane, and electronic devices were the biggest contributors to the impacts of the CWs. The OEP of the CWs were almost a third of the ATUs’ (6.07E-03). Changes in electricity sources were tested according to the 2030-Australian targets; increasing renewables share improves the OEP of ATUs by 39%; nevertheless, CWs continue to outperform the ATUs. Variations in biochar biodegradation had a small effect on the OEP of CWs; being relevant only to GWP. This study provides a reference to policy makers for better evaluation of OWTS. © 2021 The Authors},
	author_keywords = {Aerobic treatment unit; Domestic wastewater; Life cycle assessment; Onsite wastewater treatment; Vertical subsurface flow constructed wetland},
	keywords = {Animals; Australia; Humans; Life Cycle Stages; Waste Disposal, Fluid; Waste Water; Water Purification; Wetlands; Australia; Biodegradation; Environmental management; Eutrophication; Global warming; Polyvinyl chlorides; Reclamation; Reinforced concrete; Wastewater treatment; Wetlands; charcoal; fossil fuel; fresh water; peat; polyvinylchloride; Aerobic treatment unit; Australia; Biochar; Comparative life cycle assessment; Domestic wastewater; Environmental performance scores; On-site wastewater treatment; On-site wastewater treatment systems; Simapro; Vertical subsurface-flow constructed wetland; biochar; biodegradation; constructed wetland; global warming; life cycle analysis; reinforced concrete; wastewater treatment; acidification; aerobic capacity; Article; Australia; biodegradation; comparative study; constructed wetland; ecotoxicity; electricity; energy consumption; environmental impact; eutrophication; greenhouse effect; human; life cycle assessment; nonhuman; ozone depletion; photooxidation; renewable resource; waste water management; animal; life cycle stage; sewage; wastewater; water management; wetland; Life cycle},
