@ARTICLE{Kalinowski2024,
	author = {Kalinowski, Maciej and Chilmon, Karol and Jackiewicz-Rek, Wioletta},
	title = {Carbon-Negative Nano-TiO2-Modified Photocatalytic Cementitious Composites: Removal of Airborne Pollutants (NOx and O3) and Its Impact on CO2 Footprint},
	year = {2024},
	journal = {Coatings},
	volume = {14},
