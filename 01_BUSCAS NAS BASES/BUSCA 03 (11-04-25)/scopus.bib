@CONFERENCE{Caverzan2018,
	author = {Caverzan, Alessio and Lamperti Tornaghi, Marco and Negro, Paolo},
	title = {Matching safety and sustainability: The SAFESUST approach},
	year = {2018},
	journal = {IOP Conference Series: Materials Science and Engineering},
	volume = {442},
	number = {1},
	doi = {10.1088/1757-899X/442/1/012019},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85057766564&doi=10.1088%2f1757-899X%2f442%2f1%2f012019&partnerID=40&md5=3e46d54bce9873a3f9ff7b11ab2c5427},
	abstract = {The construction industry, as a main energy consumer and a foremost contributor to greenhouse gas emissions, has been undergoing a "green revolution" in the recent years. Sustainability has become a prominent issue, and environmental methods such as footprint schemes and Life Cycle Analysis approaches are being considered in the design and in the rehabilitation of buildings. However, all environmental assessment methods are applied at a later design stage, to provide a final indication of the life cycle environmental performance. A more effective way would be to consider the environmental issues in the early design stage, along with structural reliability and safety, and the global performance indicator should be expressed in economic terms. The need for an integrated design approach, to tackle safety and sustainability together has been the object of a recent workshop, in which the acronym SAFESUST was introduced. SAFESUST is an acronym to mean SAFEty and SUSTainability. It also identifies a research work-package on impact of sustainability and energy efficiency requirements on building design and retrofit, being conducted by the European Commission - Joint Research Centre, as a part of the project Safe and Cleaner Technologies for Construction and Buildings. The SAFESUST approach has been implemented into a Sustainable Structural Design (SSD) method, which considers both environmental and structural parameters in a life cycle perspective. The integration of environmental data in the structural performance is the focus of the method. Structural performances are considered in a probabilistic approach, through the introduction of a simplified Performance Based Assessment method. © Published under licence by IOP Publishing Ltd.},
	author_keywords = {Building Rehabilitation; Building Sustainability; Performance Based Design; Sustainable Structural Design},
	keywords = {Architectural design; Concretes; Construction industry; Energy efficiency; Environmental impact; Environmental management; Gas emissions; Greenhouse gases; Life cycle; Structural analysis; Building rehabilitations; Environmental assessment methods; Environmental performance; Integrated design approaches; Life cycle perspectives; Performance based design; Performance-based assessment; Probabilistic approaches; Sustainable development},
	publisher = {Institute of Physics Publishing},
	language = {English},
