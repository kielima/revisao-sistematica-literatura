	abstract = {The construction industry is a major user of non-renewable energy and contributor to emission of greenhouse gases, thus requiring to achieve net-zero carbon emissions by 2050. Indeed, construction activities account for 36% of global energy consumption and 39% of global carbon dioxide emissions. Reducing carbon emissions requires adapted government policies, carbon emission analysis and calculation models, and sustainable materials. Here, we review green construction with focus on history, carbon emissions, policies, models, life cycle assessment, and sustainable materials such as biochar, bioplastic, agricultural waste, animal wool, fly ash and self-healing concrete. Analysis of carbon emissions over the building life cycle shows that the construction phase accounts for 20–50% of total carbon emissions. The average ratio of construction phase annual emissions to operation phase emissions is 0.62. We present national policy frameworks and technology roadmaps from the United States of America, Japan, China, and the European Union, highlighting plans to achieve carbon neutrality in the building sector. © 2022, The Author(s).},
	author_keywords = {Carbon emissions; Green construction; Life cycle assessment; Net-zero carbon; Sustainable materials; Zero-carbon building},
	keywords = {Agricultural wastes; Carbon dioxide; Construction; Construction industry; Energy utilization; Fly ash; Global warming; Greenhouse gases; Carbon emissions; Construction phase; Green constructions; Life cycle assessment; Low-carbon cities; Net-zero carbon; Sustainable materials; Zero carbons; Zero-carbon building; Life cycle},
	correspondence_address = {J. Hua; School of Civil Engineering, Chongqing University, Chongqing, 400045, China; email: hjm191@163.com; P.-S. Yap; Department of Civil Engineering, Xi’an Jiaotong-Liverpool University, Suzhou, 215123, China; email: PowSeng.Yap@xjtlu.edu.cn; A.I. Osman; School of Chemistry and Chemical Engineering, Queen’s University Belfast, Belfast, Northern Ireland, BT9 5AG, United Kingdom; email: aosmanahmed01@qub.ac.uk; L. Dong; Department of Public and International Affairs, City University of Hong Kong, Kowloon Tong, SAR, 999077, Hong Kong; email: liadong@cityu.edu.hk},
