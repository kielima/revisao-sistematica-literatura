@ARTICLE{Hafez2024,
	author = {Hafez, Hisham and Bajić, Petar and Aidarov, Stanislav and Malija, Xhemsi and Drewniok, Michal and Purnell, Phil and Tošić, Nikola},
	title = {Parametric study on the decarbonization potential of structural system and concrete mix design choices for mid-rise concrete buildings},
	year = {2024},
	journal = {Materials and Structures/Materiaux et Constructions},
	volume = {57},
	number = {4},
	doi = {10.1617/s11527-024-02367-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191993442&doi=10.1617%2fs11527-024-02367-1&partnerID=40&md5=560cbac21d01519f13367c606a8b8187},
	abstract = {Mid-rise reinforced concrete buildings are projected to continue being the predominant typology for urban development. Thus, reducing the carbon footprint of such buildings is critical for achieving a sustainable built environment. Reducing the amount of concrete and steel in a building through structural and mix design optimization is identified as a primary resource efficiency strategy. This paper is among the first to present evidence of the decarbonization potential of these dematerialization strategies on a building level. The study combines structural design choices such as slab system design, steel reinforcement optimization and span width with materials-based strategies, such as low binder concrete and low-carbon binders. For each scenario, material quantities are calculated following design prescriptions by EN1992–1–1 while state-of-the art life cycle inventory data are adopted to calculate the carbon footprint. Results show that shifting towards more efficient structural systems (i.e., waffle slab system) could save up to 20% of the carbon footprint on the building level compared to more traditional systems, such as slab on beams and flat slabs. In addition, reducing the spans from 7.5 to 5 m can save up to 20% more. Finally, the use of low-clinker cement in low-binder concrete can save another 50% in terms of CO2 impact per built-up area. Realistically, results of the case study concluded that implementing these three strategies could reduce the typical 232 kg CO2e/m2 value of the carbon footprint of structural elements of a mid-rise building up to only 58 kg CO2e/m2, i.e., a four-fold reduction. © The Author(s) 2024.},
	author_keywords = {Concrete slab; Life cycle assessment; Low carbon concrete; Structural optimization; Structural system; Supplementary cementitious materials},
	keywords = {Architectural design; Binders; Carbon footprint; Concrete buildings; Concrete construction; Concrete slabs; Emission control; Life cycle; Reinforced concrete; Structural design; Building levels; Decarbonisation; Life cycle assessment; Low carbon; Low carbon concrete; Parametric study; Slab systems; Structural optimisations; Structural systems; Supplementary cementitious material; Structural optimization},
	correspondence_address = {H. Hafez; School of Civil Engineering, University of Leeds, Leeds, LS2 9JT, United Kingdom; email: h.hafez@leeds.ac.uk},
	publisher = {Springer Science and Business Media B.V.},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access, Green Open Access, Hybrid Gold Open Access}
}

@ARTICLE{Chen2024,
	author = {Chen, Kailun and Liu, Qiong and Chen, Bing and Zhang, Shishun and Ferrara, Liberato and Li, Wengui},
	title = {Effect of raw materials on the performance of 3D printing geopolymer: A review},
	year = {2024},
	journal = {Journal of Building Engineering},
	volume = {84},
	doi = {10.1016/j.jobe.2024.108501},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85182892502&doi=10.1016%2fj.jobe.2024.108501&partnerID=40&md5=d30ef628800912d5bcb248048049d844},
	abstract = {Traditional construction materials such as cement products release a significant amount of carbon dioxide during their preparation and usage, negatively impacting on the environment. In contrast, 3D printing (3DP) with geopolymer materials utilises renewable and low-carbon emission raw materials. It also exhibits characteristics such as energy efficiency and resource-efficient utilisation, contributing to reduction in carbon emissions and an improvement in sustainability. Therefore, the development of 3DP geopolymer holds great significance. This paper provides a comprehensive review of 3DP geopolymer systems, examining the effect of raw materials on processability, including flowability and thixotropy, and microstructure. The study also delves into sustainability and environmental impact. The evaluation highlights the crucial role of silicon, aluminium, and calcium content in the silicate raw material, influencing the gel structure and microstructural development of the geopolymer. Aluminium promotes reaction rate, increases reaction degree, and aids in product formation. Silicon enhances the mechanical properties of geopolymer, while calcium facilitates the formation and stability of the three-dimensional network structure, further improving material strength and stability. Moreover, the reactivity of raw materials is a key factor affecting interlayer bonding and interface mechanical properties. Finally, considering sustainability, the selection of raw materials is crucial in reducing carbon emissions, energy consumption, and costs. Compared to Portland cement, 3DP geopolymer material demonstrate lower carbon emissions, energy consumption, and costs, thus making it a sustainable material. © 2024 The Authors},
	author_keywords = {3D printing concrete; Energy consumption; Geopolymer composite; Life-cycle assessment; Low-carbon emission},
	keywords = {3D printing; Aluminum; Carbon dioxide; Concretes; Energy efficiency; Energy utilization; Environmental impact; Inorganic polymers; Life cycle; Portland cement; Silicates; Sustainable development; 3-D printing; 3d printing concrete; 3D-printing; Carbon emissions; Energy-consumption; Geopolymer; Geopolymer composites; Geopolymer materials; Life-cycle assessment; Low-carbon emissions; Geopolymers},
