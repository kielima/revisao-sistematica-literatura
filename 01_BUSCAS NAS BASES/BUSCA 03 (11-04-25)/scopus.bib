@ARTICLE{Furxhi2024269,
	author = {Furxhi, Irini and Perucca, Massimo and Baldi, Giovanni and Dami, Valentina and Cioni, Andrea and Koivisto, Antti Joonas and Bengalli, Rossella and Mantecca, Paride and Motta, Giulia and Carriere, Marie and Nicosia, Alessia and Ravegnani, Fabrizio and Burrueco-Subirà, David and Vázquez-Campos, Socorro and Lahive, Elma and de Ipiña, Jesús Lopez and Oliveira, Juliana and Cronin, Patrick and Blosi, Magda and Costa, Anna},
	title = {Advancing titanium dioxide coated photocatalytic depolluting surfaces: Leveraging ASINA's roadmap for safer and sustainable solutions},
	year = {2024},
	journal = {Computational and Structural Biotechnology Journal},
	volume = {25},
	pages = {269 – 280},
	doi = {10.1016/j.csbj.2024.10.001},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208273945&doi=10.1016%2fj.csbj.2024.10.001&partnerID=40&md5=7fc6e4523f738c7bf62b5d51233492e8},
	abstract = {This report, the second of its kind from ASINA project, aims at providing a roadmap with quantitative metrics for Safe(r) and (more) Sustainable by Design (SSbD) solutions for titanium dioxide (TiO2) nanomaterials (NMs). We begin with a brief description of ASINA's methodology across the product lifecycle, highlighting the quantitative elements, such as the Key Performance Indicators (KPIs). We then propose a decision support tool for implementing SSbD objectives across various dimensions—functionality, cost, environment, and human health safety. This is followed by the main innovative findings, a consolidation of the technical processes involved, design rationales, experimental procedures, tools and models, used and developed, to deliver photocatalytic depolluting surfaces by spray- finishing techniques based on TiO2 NMs formulations. The roadmap is thoroughly described to inform similar projects through the integration of KPIs into SSbD methodologies, fostering data-driven decision-making. While specific results are beyond this report's scope, its primary aim is to demonstrate the roadmap (SSbD know-how) and promote SSbD-oriented innovation in nanotechnology. Finally, we provide a comparison of the approaches followed in two case studies that target different industrial sectors. This case-specific SSbD assessments provide a concrete exemplification of the addressed methodology that contributes to the efforts towards attaining a common roadmap for implementing SSbD solutions aligned with the EU's Green Deal objectives. © 2024 The Authors},
	author_keywords = {Life-cycle; Roadmap; Safe and sustainable by design; Spray coating; Titanium dioxide nanomaterials},
	keywords = {Sustainable development; concrete; nanomaterial; polycarbonate; titanium dioxide; Design solutions; Key performance indicators; Photo-catalytic; Quantitative metric; Roadmap; Safe and sustainable by design; Spray coating; Sustainable solution; Titania; Titanium dioxide nanomaterials; aerosol; Article; ceramics; coating (procedure); comparative study; consumer; cost control; cost effectiveness analysis; decision support system; disease burden; environmental exposure; environmental factor; environmental impact; health hazard; human; inhalational exposure; key performance indicator; landfill; life cycle; nanotechnology; occupational exposure; occupational safety; photocatalysis; photocatalytic depolluting surface; quantitative analysis; risk assessment; safe and sustainable by design; safety procedure; solar energy; spray coating; surface area; synthesis; Titanium dioxide},
