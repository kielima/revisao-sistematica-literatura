}

@CONFERENCE{Belachia2018,
	author = {Belachia, M. and Hebhoub, H.},
	title = {Valorization of marble waste in the manufacture of concrete},
	year = {2018},
	journal = {IOP Conference Series: Materials Science and Engineering},
	volume = {431},
