	keywords = {Agricultural wastes; Binders; Carbon; Concretes; Cost engineering; Sustainable development; Alkali-activated; Alkali-activated binder; Alkali-activated cementitious composite; Cementitious composites; Engineering properties; Keys parameters; Life cycle assessment; Low carbon; Reaction mechanism; Updated history; Life cycle},
