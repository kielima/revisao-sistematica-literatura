@ARTICLE{Papadaki2022,
	author = {Papadaki, Dimitra and Nikolaou, Dimitrios A. and Assimakopoulos, Margarita N.},
	title = {Circular Environmental Impact of Recycled Building Materials and Residential Renewable Energy},
	year = {2022},
	journal = {Sustainability (Switzerland)},
	volume = {14},
