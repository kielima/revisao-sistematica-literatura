@ARTICLE{Ji2025,
	author = {Ji, Koochul and Choi, Ilyoon and Won, Jongmuk},
	title = {Reliability analysis-based life cycle assessment of railway components using long-term maintenance data},
	year = {2025},
	journal = {Developments in the Built Environment},
	volume = {21},
