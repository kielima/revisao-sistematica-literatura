	keywords = {Biodiversity; Carbon; Construction industry; Deforestation; Environmental management; Frequency modulation; Land use; Life cycle; Rural areas; Sustainable development; Built environment; Carbon balance; Carbon stocks; Environmental services; Forest products; Green building projects; Mass engineered timber; Responsible sourcing; Rural livelihood; Sustainable forest management; Timber},
	publisher = {World Conference on Timber Engineering (WCTE)},
