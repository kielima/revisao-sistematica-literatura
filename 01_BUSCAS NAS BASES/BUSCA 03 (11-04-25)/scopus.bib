	note = {Cited by: 2; All Open Access, Gold Open Access}
}

@CONFERENCE{Chen2024,
	author = {Chen, Qian and Chen, Yunpeng and Liu, Jianbo and Yang, Mei and Sun, Xiao Jie and Zhao, Gege and Cao, Baohua},
	title = {Design and realization of multifunctional energy meter calibration station under extreme conditions},
	year = {2024},
	journal = {Journal of Physics: Conference Series},
	volume = {2853},
