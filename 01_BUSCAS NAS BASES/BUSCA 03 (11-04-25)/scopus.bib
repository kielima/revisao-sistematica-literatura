@ARTICLE{Maizuar2017,
	author = {Maizuar, Maizuar and Zhang, Lihai and Miramini, Saeed and Mendis, Priyan and Thompson, Russell G.},
	title = {Detecting structural damage to bridge girders using radar interferometry and computational modelling},
	year = {2017},
	journal = {Structural Control and Health Monitoring},
	volume = {24},
	number = {10},
	doi = {10.1002/stc.1985},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85011693547&doi=10.1002%2fstc.1985&partnerID=40&md5=1f01eb73679ca500c8600ae7474043b2},
	abstract = {The process for assessing the condition of a bridge involves continuously monitoring changes to the material properties, support conditions, and system connectivity throughout its life cycle. It is known that the structural integrity of bridges can be monitored by measuring their vibration responses. However, the relationship between frequency changes and structural damage is still not fully understood. This study presents a bridge condition assessment framework which integrates computational modelling and noncontact radar sensor techniques (i.e., IBIS-S) to predict changes in the natural frequencies of a bridge girder as a result of a range of parameters that govern its structural performance (e.g., elastomeric bearing stiffness, concrete compressive stiffness, and crack propagation). Using a prestressed concrete bridge in Australia as a case study, the research outcomes suggest that vibration monitoring using IBIS-S is an efficient way for detecting the degradation of elastomeric bearing stiffness and shear crack propagation in the support areas that can significantly affect the overall structural integrity of a bridge structure. However, frequency measurements have limited capability for detecting the decrease in the material properties of a bridge girder. Copyright © 2017 John Wiley & Sons, Ltd.},
