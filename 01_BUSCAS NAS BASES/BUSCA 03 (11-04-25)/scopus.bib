	author = {Gálvez-Martos, José-Luis and Chaliulina, Roneta and Elhoweris, Ammar and Mwanda, Jonathan and Hakki, Amer and Al-horr, Yousef},
	title = {Techno-economic assessment of calcium sulfoaluminate clinker production using elemental sulfur as raw material},
	year = {2021},
	journal = {Journal of Cleaner Production},
	volume = {301},
	doi = {10.1016/j.jclepro.2021.126888},
