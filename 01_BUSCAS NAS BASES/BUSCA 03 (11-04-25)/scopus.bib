	author = {Yilmaz, Ahmet and Yildizel, Sadik Alper and Bahrami, Alireza and Kaplan, Gokhan},
	title = {Utilizing genetic programming to evaluate and predict roller-compacted concrete pavements reinforced with coal powder and basalt fiber},
	year = {2024},
	journal = {International Journal of Pavement Engineering},
	volume = {25},
	number = {1},
	doi = {10.1080/10298436.2024.2382328},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85201551440&doi=10.1080%2f10298436.2024.2382328&partnerID=40&md5=987b3e1cf442ec122509375794913a3b},
	abstract = {Roller-compacted concrete (RCC) pavement technology has drawn significant attention in recent years, thanks to its many advantages over conventional paving materials. The main benefits of RCC include decreased shrinkage, reduced life-cycle expenses, early access to traffic and a decrease in the urban heat island effect. This study proposed a cost-effective method to address the disposal of coal powder (CP), which is an important contributor of environmental problems, by integrating it into the manufacturing of RCC. Cement was replaced with CP at weight ratios of 5%, 10%, 15%, and 20%. CP was substituted for cement, with weight ratios of 5%, 10%, 15% and 20%. The albedo and mechanical properties of the obtained RCC mixtures were measured. The albedo of the RCC mixture with 20% CP decreased approximately 2.3 times in comparison to that of the reference mixture. After 28 days, RCC mixes had compressive strengths of 26–38 MPa and flexural strengths of 4.3–6.1 MPa. Flexural and splitting tensile strengths increased substantially with BF. RCC mixtures with 5% CP and 0.5% BF improved freeze-thaw resilience after 100 cycles. The genetic algorithm approach may improve RCC design optimisation. Thus, RCC made with CP may be environmentally friendly and Sustainable. © 2024 The Author(s). Published by Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {basalt fiber; coal powder; frost resistance; genetic programming; pavement; Roller-compacted concrete},
	keywords = {Bending strength; Binary mixtures; Cement manufacture; Cements; Concrete pavements; Frost resistance; Pavement overlays; Roller compacted concrete; Rollers (machine components); Rollers (roadbuilding machinery); Sustainable development; Basalt fiber; Coal powder; Cost-effective methods; Environmental problems; Mechanical; Pavement technology; Roller compacted concrete pavements; Roller compacted concretes; Urban Heat Island Effects; Weight ratios; Compressive strength},
