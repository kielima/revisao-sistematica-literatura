	keywords = {Bridges; Cost benefit analysis; Environmental impact assessments; High performance concrete; Life cycle; Sustainable development; Concrete covering; Design Methodology; Historical development; Life-cycle cost; Manufacturing property; Mechanical durability; Multifunctional properties; Multifunctionality; Self-heating; Self-sensing; Durability},
