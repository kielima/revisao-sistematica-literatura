@CONFERENCE{Sharma2024,
	author = {Sharma, Shashikant Nishant and Lodhi, Arjun Singh and Dehalwar, Kavita and Jaiswal, Anuj},
	title = {Life Cycle Assessment (LCA) of Recycled & Secondary Materials in the Construction of Roads},
	year = {2024},
	journal = {IOP Conference Series: Earth and Environmental Science},
	volume = {1326},
