@ARTICLE{Kumari20242881,
	author = {Kumari, Sunita and Jaglan, Saurabh and Chouksey, Arti and Walia, Rinku and Ahlawat, Aman and Garg, Atul and Verma, Manvendra},
	title = {Carbon Footprint Analysis of Cement Production in India},
