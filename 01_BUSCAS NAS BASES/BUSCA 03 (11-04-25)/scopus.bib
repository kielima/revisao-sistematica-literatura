@ARTICLE{Jiang2024,
	author = {Jiang, Peiling and Zhao, Diansheng and Jin, Cheng and Ye, Shan and Luan, Chenchen and Tufail, Rana Faisal},
	title = {Compressive strength prediction and low-carbon optimization of fly ash geopolymer concrete based on big data and ensemble learning},
	year = {2024},
	journal = {PLoS ONE},
	volume = {19},
	number = {9 September},
	doi = {10.1371/journal.pone.0310422},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204040498&doi=10.1371%2fjournal.pone.0310422&partnerID=40&md5=0cd49b3c920c7b69bc7d4f558468b9e3},
	abstract = {Portland cement concrete (PCC) is a major contributor to human-made CO2 emissions. To address this environmental impact, fly ash geopolymer concrete (FAGC) has emerged as a promising low-carbon alternative. This study establishes a robust compressive strength prediction model for FAGC and develops an optimal mixture design method to achieve target compressive strength with minimal CO2 emissions. To develop robust prediction models, comprehensive factors, including fly ash characteristics, mixture proportions, curing parameters, and specimen types, are considered, a large dataset comprising 1136 observations is created, and polynomial regression, genetic programming, and ensemble learning are employed. The ensemble learning model shows superior accuracy and generalization ability with an RMSE value of 1.81 MPa and an R2 value of 0.93 in the experimental validation set. Then, the study integrates the developed strength model with a life cycle assessment-based CO2 emissions model, formulating an optimal FAGC mixture design program. A case study validates the effectiveness of this program, demonstrating a 16.7% reduction in CO2 emissions for FAGC with a compressive strength of 50 MPa compared to traditional trial- and-error design. Moreover, compared to PCC, the developed FAGC achieves a substantial 60.3% reduction in CO2 emissions. This work provides engineers with tools for compressive strength prediction and low carbon optimization of FAGC, enabling rapid and highly accurate design of concrete with lower CO2 emissions and greater sustainability. Copyright: © 2024 Jiang et al. This is an open access article distributed under the terms of the Creative Commons Attribution License, which permits unrestricted use, distribution, and reproduction in any medium, provided the original author and source are credited.},
	keywords = {Carbon; Carbon Dioxide; Coal Ash; Compressive Strength; Construction Materials; Machine Learning; Polymers; concrete; carbon; carbon dioxide; polymer; Article; big data; carbon dioxide emission; chemical composition; climate change; compressive strength; cost effectiveness analysis; decision tree; extraction; fly ash; geopolymer; human; learning; life cycle assessment; polynomial regression analysis; temperature; building material; chemistry; compressive strength; machine learning},
	correspondence_address = {C. Luan; Institute of Advanced Study, Chengdu University, Chengdu, China; email: luanchenchen@hit.edu.cn},
	publisher = {Public Library of Science},
	language = {English},
