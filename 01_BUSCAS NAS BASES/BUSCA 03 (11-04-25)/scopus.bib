	title = {A Stochastic Formulation to Assess the Environmental Impact of the Life-Cycle of Engineering Systems},
	year = {2022},
	journal = {Journal of Structural Engineering (United States)},
	volume = {148},
	number = {1},
	doi = {10.1061/(ASCE)ST.1943-541X.0003201},
