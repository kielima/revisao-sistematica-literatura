@BOOK{Luukkonen20221,
	author = {Luukkonen, Tero},
	title = {Alkali-Activated Materials in Environmental Technology Applications},
	year = {2022},
	journal = {Alkali-Activated Materials in Environmental Technology Applications},
	pages = {1 – 435},
	doi = {10.1016/C2020-0-03591-7},
