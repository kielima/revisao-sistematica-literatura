	keywords = {Complex networks; Housing; Life cycle; Neural networks; Reinforced concrete; Risk assessment; Risk management; Risk perception; @risk 7.5; Artificial neural network; Construction projects; Contingency; Contingency factors; Neuraltool 7.5; Project complexity; Project's life cycle; Saudi Arabia; Turnkey; Contractors},
