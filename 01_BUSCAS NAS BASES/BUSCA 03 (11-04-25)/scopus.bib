}

@ARTICLE{Navaratnam2023,
	author = {Navaratnam, Satheeskumar and Tushar, Quddus and Jahan, Israt and Zhang, Guomin},
	title = {Environmental Sustainability of Industrial Waste-Based Cementitious Materials: A Review, Experimental Investigation and Life-Cycle Assessment},
	year = {2023},
	journal = {Sustainability (Switzerland)},
	volume = {15},
	number = {3},
