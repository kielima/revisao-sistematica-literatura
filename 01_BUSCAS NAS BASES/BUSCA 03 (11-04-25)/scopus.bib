@ARTICLE{Elliot2024236,
	author = {Elliot, Thomas and Kouchaki-Penchah, Hamed and Brial, Victor and Levasseur, Annie and McLaren, Sarah J.},
	title = {Dynamic environmental payback of concrete due to carbonation over centuries},
	year = {2024},
	journal = {Sustainable Production and Consumption},
	volume = {51},
	pages = {236 – 247},
	doi = {10.1016/j.spc.2024.09.009},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204962482&doi=10.1016%2fj.spc.2024.09.009&partnerID=40&md5=957839d51b7ec334bb062b28b8d50dd0},
	abstract = {This research introduces a dynamic life cycle assessment (LCA) based carbonation impact calculator designed to enhance the environmental evaluation of cement-based construction products. The research emphasizes the limitations of static LCAs which fail to capture the time-dependent nature of carbon sequestration by carbonation. We provide an easy-to-use spreadsheet-based LCA carbonation model. The model is available in the supplementary information, and includes a suite of changeable parameters for exploring the effect of alternative environmental conditions and concrete block composition on carbonation. The tool enables use of both a static and dynamic LCA method to calculate the production emissions and carbonation sequestration of a concrete block over a 1000-year time horizon. Carbonation can partially mitigate initial production emissions and adjust radiative forcing over long periods. Using a static attributional LCA approach, carbonation sequesters 6 % of the CO2 generated from its production emissions. We describe the ratio of carbonation to production emissions as the partial “carbonation payback”, and with dynamic LCA show the variation of this ratio over time. Considering time by applying the dynamic LCA approach, we find this partial “carbonation payback” is split between uptake during the 60-year service life (0.13 kg CO2) and the 940-year end of life period (0.12 kg CO2) in our baseline case. Further scenario analyses illustrate the significant variability in carbonation payback, driven by environmental factors, cement composition, and the use of supplementary cementitious materials. The results highlight the critical role of modelling choices in estimating the carbonation payback. The carbonation calculator developed in this study offers a sophisticated yet user-friendly tool, providing both researchers and practitioners with the ability to dynamically model the sequestration potential of concrete, thereby promoting more sustainable construction practices. © 2024 The Authors},
	author_keywords = {Carbon footprint; Carbon sequestration; Concrete; Dynamic life cycle assessment; Industrial ecology},
	keywords = {Carbon capture; Carbon capture and storage; Carbon capture and utilization; Zero-carbon; Assessment approaches; Carbon sequestration; Cement-based; Construction products; Dynamic life cycle assessment; Environmental conditions; Environmental evaluation; Industrial ecology; Supplementary information; Time dependent; Carbon sequestration},
	correspondence_address = {T. Elliot; Department of Sustainability and Planning, Aalborg University, Denmark; email: thomaselliot@plan.aau.dk},
	publisher = {Elsevier B.V.},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
