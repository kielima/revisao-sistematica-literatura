@ARTICLE{Ugural2024,
	author = {Ugural, Mehmet Nurettin and Ozyilmaz, Merve Ruya and Burgan, Halil Ibrahim},
	title = {Life Cycle Assessment Analysis Based on Material Selection in Sustainable Airport Buildings},
	year = {2024},
	journal = {Buildings},
	volume = {14},
	number = {9},
	doi = {10.3390/buildings14092728},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85205230034&doi=10.3390%2fbuildings14092728&partnerID=40&md5=a53c9776ae70683291ce26b97f53b447},
	abstract = {Sustainable airport buildings aim to minimize environmental impacts through energy efficiency, water conservation, and waste management. This is achieved by employing green building materials and utilizing renewable energy sources to reduce their carbon footprint. In this study, life cycle assessment (LCA) was conducted to assess the environmental impacts of three main construction materials—concrete, steel, and wood—used in sustainable airport buildings. These materials were selected for their widespread use in eight different airport terminal buildings with sustainability certifications. The environmental impacts of these materials were calculated and compared using OpenLCA 1.9.0 software and the ECOinvent database, adhering to the standards set forth by the Environmental Product Declaration (EPD) initiative. The findings indicate that wood, as a construction material, has a significantly lower impact on global warming compared to steel and concrete, with a global warming potential (GWP) ratio of less than 60%. Steel, with a GWP of approximately 90% of that of concrete, also showed a lower impact than concrete. Additionally, other environmental impacts, such as stratospheric ozone depletion potential (ODP) and acidification potential (AP), were also examined, highlighting the trade-offs associated with each material. © 2024 by the authors.},
	author_keywords = {airport; building materials; life cycle assessment (LCA); project management; sustainability},
	keywords = {Life cycle assessment; Project management; Sustainable building; Buildings materials; Energy; Global warming potential; Green building materials; Life cycle assessment; Life cycle assessment analysis; Low impacts; Materials selection; Renewable energy source; Water wastes; Airport buildings},
