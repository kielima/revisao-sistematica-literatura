@CONFERENCE{Taraben2018,
	author = {Taraben, Jakob and Hallermann, Norman and Kersten, Jens and Morgenthal, Guido and Rodehorst, Volker},
	title = {Case study for the integration of geometrical analyses for structural condition assessment in building information models},
	year = {2018},
	journal = {IOP Conference Series: Materials Science and Engineering},
	volume = {365},
	number = {2},
