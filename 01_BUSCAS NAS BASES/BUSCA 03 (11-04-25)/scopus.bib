@ARTICLE{Ravikumar2021,
	author = {Ravikumar, Dwarakanath and Zhang, Duo and Keoleian, Gregory and Miller, Shelie and Sick, Volker and Li, Victor},
	title = {Carbon dioxide utilization in concrete curing or mixing might not produce a net climate benefit},
	year = {2021},
	journal = {Nature Communications},
	volume = {12},
	number = {1},
	doi = {10.1038/s41467-021-21148-w},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100973703&doi=10.1038%2fs41467-021-21148-w&partnerID=40&md5=5341d1ee15412901c3a73f8cea87fa60},
	abstract = {Carbon capture and utilization for concrete production (CCU concrete) is estimated to sequester 0.1 to 1.4 gigatons of carbon dioxide (CO2) by 2050. However, existing estimates do not account for the CO2 impact from the capture, transport and utilization of CO2, change in compressive strength in CCU concrete and uncertainty and variability in CCU concrete production processes. By accounting for these factors, we determine the net CO2 benefit when CCU concrete produced from CO2 curing and mixing substitutes for conventional concrete. The results demonstrate a higher likelihood of the net CO2 benefit of CCU concrete being negative i.e. there is a net increase in CO2 in 56 to 68 of 99 published experimental datasets depending on the CO2 source. Ensuring an increase in compressive strength from CO2 curing and mixing and decreasing the electricity used in CO2 curing are promising strategies to increase the net CO2 benefit from CCU concrete. © 2021, The Author(s).},
	keywords = {carbon dioxide; concrete; natural gas; carbon dioxide; carbon sequestration; compressive strength; electricity; Article; carbon utilization; climate; compressive strength; electric power plant; electricity; life cycle; Monte Carlo method; sensitivity analysis},
	correspondence_address = {D. Ravikumar; Center for Sustainable Systems (CSS), School for Environment and Sustainability (SEAS), University of Michigan, Ann Arbor, United States; email: dwarak.ravikumar@nrel.gov},
	publisher = {Nature Research},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 129; All Open Access, Gold Open Access, Green Open Access}
}

@ARTICLE{Hossain2021,
	author = {Hossain, Md. Uzzal and Dong, Yahong and Ng, S. Thomas},
	title = {Influence of supplementary cementitious materials in sustainability performance of concrete industry: A case study in Hong Kong},
	year = {2021},
	journal = {Case Studies in Construction Materials},
	volume = {15},
	doi = {10.1016/j.cscm.2021.e00659},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85113242952&doi=10.1016%2fj.cscm.2021.e00659&partnerID=40&md5=cc285a8daa28cb4cea90d3c8ba266c76},
	abstract = {Although the use of a few industrial by-products as supplementary cementitious materials (SCMs) is one of the most recognized solutions to produce more durable and sustainable concrete, cost-competitive supply of such materials is of great concern, especially for a resource-scarce city like Hong Kong. In addition, several factors including the mechanical performance, transport distance and allocation of upstream impacts, can offset the environmental gain of concretes produced with such by-products. Other potential material such as volcanic ash, can be an effective alternative of industrial SCMs. However, there is a need to comprehensively demonstrate how this material can enhance the sustainability performance of the concrete industry. In this study, the greenhouse gases (GHG) emissions of using volcanic ash is evaluated and compared with its counterparts such as fly ash and ground granulated blast furnace slag in concrete production using a lifecycle assessment (LCA) technique. Based on the bottom-up approach, an industry level evaluation on GHG emission saving due to the use of different SCMs is conducted. The results show that more than 80 % lower GHG emissions are associated with volcanic ash compared to other SCMs. For the same grade of concrete, volcanic ash can reduce up to 25 % and 19 % of total GHG emissions compared to ordinary Portland cement and SCM concretes, respectively (at the product level). Considering the assumptions described in this study, the results reveal that by substituting 10–50 % industrial SCMs with volcanic ash, 11–37 % more GHG emissions can be reduced from the concrete industry in Hong Kong (at the industry level). The analysis conducted in this study would help source alternative SCMs for further promotion of sustainability in the construction industry of Hong Kong, where majority of SCMs are sourced from different countries. © 2021 The Author(s)},
	author_keywords = {Concrete industry; Greenhouse gas emissions; Natural pozzolana; Supplementary cementitious materials; Sustainability},
	keywords = {Blast furnaces; Concrete products; Construction industry; Fly ash; Greenhouse gases; Industrial emissions; Life cycle; Portland cement; Slags; Sustainable development; Volcanoes; Greenhouse gases (GHG); Ground granulated blast furnace slag; Industrial by-products; Life-cycle assessments; Mechanical performance; Ordinary Portland cement; Supplementary cementitious material; Sustainability performance; Concrete industry},
	correspondence_address = {S.T. Ng; Department of Architecture and Civil Engineering, City University of Hong Kong, Kowloon Tong, 83 Tat Chee Avenue, Hong Kong; email: thomasng@cityu.edu.hk},
	publisher = {Elsevier Ltd},
