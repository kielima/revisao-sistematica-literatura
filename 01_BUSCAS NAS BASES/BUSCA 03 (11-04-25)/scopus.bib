@ARTICLE{Dorr2023,
	author = {Dorr, Erica and Goldstein, Benjamin and Aubry, Christine and Gabrielle, Benoit and Horvath, Arpad},
	title = {Best practices for consistent and reliable life cycle assessments of urban agriculture},
	year = {2023},
	journal = {Journal of Cleaner Production},
	volume = {419},
	doi = {10.1016/j.jclepro.2023.138010},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166332456&doi=10.1016%2fj.jclepro.2023.138010&partnerID=40&md5=070bd444eb49512e0533dbf014aaf065},
	abstract = {There is increasing interest in evaluating the environmental performance of urban agriculture (UA), primarily using life cycle assessment (LCA). However, LCA has been applied to UA inconsistently, making it difficult to confidently compare or draw conclusions from existing studies. This article outlines the key challenges of applying LCA to UA and recommends concrete steps to bring consistency and comprehensiveness to the topic. The research questions that LCA can address are framed before providing practical recommendations for performing LCAs of UA, considering several of its unique aspects that require special attention by practitioners. These include crop diversity, data availability, modeling compost, soil carbon sequestration, producing growing media, distribution of crops, and variability and uncertainty. Next, the article proposes future research areas that will benefit LCA generally and its application to UA, such as framing UA as urban green infrastructure, evaluating at the city scale, accounting for ecosystem services, and including social dimensions of UA. By following these recommendations, future LCAs of UA can be more consistent, comparable, and holistic, and will help build knowledge and inform policy-making and practices around UA. © 2023},
	author_keywords = {Compost; Ecosystem services; Gardens; LCA guidelines; Social LCA; Urban agriculture},
	keywords = {Composting; Crops; Ecosystems; Environmental management; Uncertainty analysis; Best practices; Compost; Ecosystem services; Environmental performance; Garden; Life cycle assessment guideline; Reliable lives; Social life; Social life cycle assessment; Urban agricultures; Life cycle},
