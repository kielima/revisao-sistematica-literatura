@CONFERENCE{Mack Vergara20194662,
	author = {Mack Vergara, Yazmin Lisbeth and John, Vanderley},
	title = {OPPORTUNITIES FOR REDUCING WATER CONSUMPTION IN CONCRETE PRODUCTION: THE PANAMA CANAL EXPANSION CASE STUDY},
	year = {2019},
	journal = {Proceedings of the IAHR World Congress},
