	title = {Punching above its weight: Life cycle energy accounting and environmental assessment of vanadium microalloying in reinforcement bar steel},
	year = {2021},
	journal = {Environmental Science: Processes and Impacts},
	volume = {23},
	number = {2},
	pages = {275 – 290},
	doi = {10.1039/d0em00424c},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85098623938&doi=10.1039%2fd0em00424c&partnerID=40&md5=08315720d28f4af8933a409b66a726cf},
	abstract = {Steel-reinforced concrete is ubiquitously used in construction across the world. The United Nations estimates that the worldwide energy consumption of buildings accounts for 30-40% of global energy production, underlining the importance of the judicious selection of construction materials. Much effort has focused on the use of high-strength low-alloy steels in reinforcement bars whose economy of materials use is predicated upon improved yield strengths in comparison to low-carbon steels. While microalloying is known to allow for reduced steel consumption, a sustainability analysis in terms of embodied energy and CO2 has not thus far been performed. Here we calculate the impact of supplanting lower grade reinforcement bars with higher strength vanadium microalloyed steels on embodied energy and carbon footprint. We find that the increased strength of vanadium microalloyed steel translates into substantial material savings over mild steel, thereby reducing the total global fossil carbon footprint by as much as 0.385%. A more granular analysis pegs savings for China and the European Union at 1.01 and 0.19%, respectively, of their respective emissions. Our cradle-to-gate analysis provides an accounting of the role of microalloying in reducing the carbon footprint of the steel and construction industries and highlights the underappreciated role of alloying elements. This journal is  © The Royal Society of Chemistry.},
	keywords = {Animals; Carbon Footprint; China; Life Cycle Stages; Steel; Vanadium; Alloying elements; Carbon footprint; Construction industry; Emission control; Energy utilization; High strength alloys; Life cycle; Microalloyed steel; Microalloying; Rebar; Reinforced concrete; Steel metallography; Strength of materials; Sustainable development; Vanadium steel; alloy; aluminum; carbon; carbon dioxide; concrete; manganese; nitrogen; oxygen; phosphorus; silicon; steel; sulfur; vanadium; Environmental assessment; Granular analysis; Life cycle energies; Steel consumption; Steel reinforced concrete; Sustainability analysis; Vanadium microalloyed steel; Vanadium microalloying; Article; building industry; built environment; calculation; carbon footprint; China; cost control; energy consumption; energy yield; European Union; life cycle assessment; machine learning; precursor; priority journal; research; strength; animal; carbon footprint; life cycle stage; Low carbon steel},
