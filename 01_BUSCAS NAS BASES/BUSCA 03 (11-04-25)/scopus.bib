	title = {Digital Prefabrication of Lightweight Building Elements for Circular Economy: Material-Minimised Ribbed Floor Slabs Made of Extruded Carbon Reinforced Concrete (ExCRC)},
	year = {2023},
	journal = {Buildings},
	volume = {13},
