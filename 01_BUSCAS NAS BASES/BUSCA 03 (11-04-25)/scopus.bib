	correspondence_address = {S.G. Al-Ghamdi; Environmental Science and Engineering Program, Biological and Environmental Science and Engineering Division, King Abdullah University of Science and Technology, Thuwal, 23955, Saudi Arabia; email: sami.alghamdi@kaust.edu.sa},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
