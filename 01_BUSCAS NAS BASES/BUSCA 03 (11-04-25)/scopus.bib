@ARTICLE{Idrees2022,
	author = {Idrees, Maria and Akbar, Arslan and Saeed, Farhan and Saleem, Huma and Hussian, Tousif and Vatin, Nikolai Ivanovich},
	title = {Improvement in Durability and Mechanical Performance of Concrete Exposed to Aggressive Environments by Using Polymer},
	year = {2022},
	journal = {Materials},
	volume = {15},
	number = {11},
	doi = {10.3390/ma15113751},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85131595721&doi=10.3390%2fma15113751&partnerID=40&md5=7f28b4e2b00eb1d86d03e5d84d579001},
	abstract = {Concrete is the most widely used construction material. However, it cannot sustain the harsh environment and can easily deteriorate. It results in repair and reworks that amount to a considerable loss of money and time. The life span of concrete reduces if exposed to external attacks, for instance, sulfate attacks, alkali-silica reactions, corrosion, and drying shrinkage. These ubiquitous attacks cause a reduction in service life and raise the need for early repair and maintenance, resulting in higher life cycle costs and structural failures. To resolve these issues, the potential of styrene-butadiene-rubber (SBR) ultrafine powder as cement replacement polymeric admixture at 0%, 3%, 5%, 7%, and 10% have been evaluated. The effect of SBR-powder on concrete is investigated by conducting an alkali-silica reactivity test (ASR), rapid-chloride-permeability test (RCPT), drying shrinkage, and sulfate resistivity tests. Workability, compressive and flexural strength tests are also conducted. For ASR and drying shrinkage, mortar bar samples were cast, exposed to respective environments, and the percentage change in length was measured. For mechanical tests and RCPT, prisms, cylinders and cubes were cast and tested at 28 days. The SBR-powder modification reduces concrete’s permeability, drying shrinkage, and expansions due to ASR and sulfate attacks. SBR powder increased workability by 90%, compressive strength by 23%, and flexural strength by 9.4% in concrete when used at 10% cement replacement by weight. The SBR-powder (10%) modification reduced the RCPT value by up to one-third (67%), drying shrinkage by 53%, ASR by 57%, and sulfate reaction by 73%. Consequently, SBR powder usage can adequately improve the workability, mechanical properties, and durability of the concrete and lead to advanced sustainable concrete with low repair requirements. © 2022 by the authors. Licensee MDPI, Basel, Switzerland.},
	author_keywords = {cement-based materials; durability; styrene-butadiene-rubber; sustainability},
	keywords = {Butadiene; Cements; Chlorine compounds; Compressive strength; Concretes; Corrosion; Drying; Failure (mechanical); Fracture mechanics; Life cycle; Mechanical permeability; Repair; Rubber; Silica; Styrene; Sulfur compounds; Sustainable development; Alkali-silica reactivity; Cement based material; Cement replacement; Drying shrinkages; Exposed to; Permeability test; Rapid chloride permeabilities; Styrene-butadiene rubber powder; Styrene/butadiene rubbers; Sulfate attack; Durability},
	correspondence_address = {M. Idrees; Department of Architectural Engineering & Design, Faculty of Civil Engineering, University of Engineering and Technology, Lahore, 54890, Pakistan; email: mariaidrees@uet.edu.pk; A. Akbar; Department of Architecture and Civil Engineering, City University of Hong Kong, Kowloon, 999077, Hong Kong; email: aakbar4-c@my.cityu.edu.hk},
