@ARTICLE{Rumayor2022267,
	author = {Rumayor, Marta and Fernández-González, Javier and Domínguez-Ramos, Antonio and Irabien, Angel},
	title = {Deep Decarbonization of the Cement Sector: A Prospective Environmental Assessment of CO2 Recycling to Methanol},
	year = {2022},
	journal = {ACS Sustainable Chemistry and Engineering},
	volume = {10},
