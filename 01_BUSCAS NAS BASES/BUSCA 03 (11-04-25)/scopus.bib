@CONFERENCE{Ling2021,
	author = {Ling, T.-C. and Tiong, M.},
	title = {Developing carbon-neutral construction materials using wastes as carbon sink},
	year = {2021},
	journal = {IOP Conference Series: Earth and Environmental Science},
	volume = {861},
