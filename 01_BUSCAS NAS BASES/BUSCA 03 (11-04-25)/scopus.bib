@ARTICLE{Coenen2020,
	author = {Coenen, Tom B.J. and Haanstra, Willem and Jan Braaksma, A.J.J. and Santos, João},
	title = {CEIMA: A framework for identifying critical interfaces between the Circular Economy and stakeholders in the lifecycle of infrastructure assets},
	year = {2020},
