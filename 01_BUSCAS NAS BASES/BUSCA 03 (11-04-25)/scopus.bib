	author = {Morales-Beltran, Mauricio and Engür, Pınar and Şişman, Ömer Asım and Aykar, Gizem Nur},
	title = {Redesigning for Disassembly and Carbon Footprint Reduction: Shifting from Reinforced Concrete to Hybrid Timber–Steel Multi-Story Building},
	year = {2023},
