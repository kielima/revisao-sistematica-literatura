@CONFERENCE{Wu201986,
	author = {Wu, Pengfei and Shen, Qingni and Deng, Robert. H. and Liu, Ximeng and Zhang, Yinghui and Wu, Zhonghai},
	title = {ObliDC: An SGX-based oblivious distributed computing framework with formal proof},
	year = {2019},
	journal = {AsiaCCS 2019 - Proceedings of the 2019 ACM Asia Conference on Computer and Communications Security},
	pages = {86 – 99},
	doi = {10.1145/3321705.3329822},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85069962734&doi=10.1145%2f3321705.3329822&partnerID=40&md5=cef2e7ba4973fa0b4d14ff1683c0bd24},
	abstract = {Data privacy is becoming one of the most critical concerns in cloud computing. Several proposals based on Intel SGX such as VC3 [1] and M2R [2] have been introduced in the literature to protect data privacy during job execution in the cloud. However, a comprehensive formal proof of their security guarantees is still lacking. In this paper, we propose ObliDC, a general UC-secure SGX-based oblivious distributed computing framework. First, we model the life-cycle of a distributed computing job as data-flow graphs. Under the assumption of malicious, adaptive adversaries in the cloud, we then formally define data privacy of a distributed computing job by introducing a notion named ODC-privacy, which encompasses both semantic security (to protect data confidentiality during computation and transmission) and oblivious traffic (to prevent data leakage from traffic analysis). ObliDC is composed of four two-party protocols - job deployment, job initialization, job execution, and results return, which allow for modular construction of concrete privacy-preserving job protocols in different distributed computing frameworks. Finally, inspired by a formal abstraction for trusted processors proposed by R. Pass et al. [3], we formally prove the security of ObliDC under the universal composability (UC) framework. © 2019 Association for Computing Machinery.},
	author_keywords = {Distributed computing systems; Formal proof; Intel SGX; Oblivious computation},
	keywords = {Data flow analysis; Data flow graphs; Data privacy; Graphic methods; Life cycle; Modular construction; Semantics; Data confidentiality; Distributed computing frameworks; Distributed computing systems; Formal proofs; Intel SGX; Privacy preserving; Two-party protocols; Universal composability; Distributed computer systems},
	correspondence_address = {Q. Shen; Peking University, China; email: qingnishen@ss.pku.edu.cn},
	publisher = {Association for Computing Machinery, Inc},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 12; All Open Access, Green Open Access}
}

@ARTICLE{Li20191496,
