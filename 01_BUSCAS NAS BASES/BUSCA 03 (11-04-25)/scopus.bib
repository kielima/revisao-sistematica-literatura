@CONFERENCE{Antypa2022,
	author = {Antypa, Despoina and Vlysidis, Anestis and Gkika, Anastasia and Petrakli, Foteini and Kraft, Robert and Böhm, Robert and Eckert, Kathrin Marina and Smirnova, Irina and Suchorzewski, Jan and Koumoulos, Elias},
	title = {Life cycle assessment of advanced building materials towards NZEBs},
	year = {2022},
	journal = {E3S Web of Conferences},
	volume = {349},
