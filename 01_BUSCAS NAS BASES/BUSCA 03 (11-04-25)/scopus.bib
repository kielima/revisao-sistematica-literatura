@ARTICLE{Sangiorgio2025,
	author = {Sangiorgio, Valentino and Bianchi, Iacopo and Forcellese, Archimede},
	title = {Advancing decarbonization through 3D printed concrete formworks: Life cycle analysis of technologies, materials, and processes},
	year = {2025},
	journal = {Energy and Buildings},
	volume = {332},
	doi = {10.1016/j.enbuild.2025.115444},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217279307&doi=10.1016%2fj.enbuild.2025.115444&partnerID=40&md5=6d7124f2ac8b2f660ef58e26069c04e9},
	abstract = {3D printing technologies are innovating several industrial fields for their ability to produce complex shapes, reduce material use and obtain high-performance structures. Among the possible applications of 3D printing in the civil construction sector, manufacturing formwork for concrete casting is a promising solution for producing thin-walled and complex structures. Given the increasing interest and numerous applications being developed, comprehensive studies on the sustainability of 3D-printed concrete formwork are required to improve the processes and drive low-carbon construction practices. In this context, the present study provides for the first time an evaluation of the environmental and economic sustainability of concrete structures achieved using 3D printed formwork. The research investigates the influence of various factors such as: i) geometry complexity, ii) printing technology (Fused Deposition Modelling and Material Jetting), iii) process parameters, iv) raw materials (PLA, ABS, PVA, Geopolymers, Cements, Clay) v) machines kinematic systems and vi) End of Life alternatives. To perform such an investigation, a parametric CAD model was developed to define structure geometry; furthermore, Life Cycle Assessment and Life Cycle Costing methodologies were applied to calculate the impacts and cost of the different alternatives. The results showed that a proper choice of the combination of geometry, technology, material, and process parameters is crucial for reducing the carbonization-related impacts associated with 3D-printed formwork production. In addition, reuse and recycling of the formworks cut overall impacts, making 3D printing a sustainable alternative to traditional production processes while allowing greater design freedom. © 2025 The Author(s)},
	keywords = {Concrete construction; Concretes; 3-D printing; 3D-printing; Complex shapes; Decarbonisation; Formwork; Industrial fields; Life cycle analysis; Materials and process; Printing technologies; Process parameters; Thin walled structures},
	correspondence_address = {V. Sangiorgio; Department of Engineering and Geology (INGEO), D'Annunzio University of Chieti –Pescara, Pescara, Viale Pindaro, 42, 65127, Italy; email: valentino.sangiorgio@unich.it},
