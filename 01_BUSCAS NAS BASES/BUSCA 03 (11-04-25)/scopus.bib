@ARTICLE{Younis2022,
	author = {Younis, Adel and Dodoo, Ambrose},
	title = {Cross-laminated timber for building construction: A life-cycle-assessment overview},
	year = {2022},
	journal = {Journal of Building Engineering},
	volume = {52},
	doi = {10.1016/j.jobe.2022.104482},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85128237766&doi=10.1016%2fj.jobe.2022.104482&partnerID=40&md5=3f9a2cd602132eec067a128bb9ad5309},
	abstract = {The building industry is a large contributor to greenhouse gas (GHG) emissions and a vast consumer of natural resources. It is estimated that, in the next 40 years, around 415 Gt of CO2 will be released as a result of global construction activities. Therefore, improvements in construction technologies are essential to reduce GHG emissions and thereby attain national and international goals to mitigate climate change. Cross-laminated timber (CLT) has emerged as an innovative alternative material to steel/concrete in building construction, given its relatively low carbon footprint, not to mention its high strength-to-weight ratio, simple installation, and aesthetic features. CLT is a structural composite panel product developed in the early 1990s, and the contemporary generation of CLT buildings are yet to reach the end of their service life. Accordingly, there has been growing interest to understand and optimize the performance of CLT in building construction. In view of that, this paper presents an overview on the feasibility of using CLT in buildings from a life-cycle assessment (LCA) standpoint. The authors performed a brief review on LCA studies conducted in the past decade pertaining to the carbon footprint of CLT buildings. On average, the findings of these studies revealed about 40% reduction in carbon footprint when using CLT in lieu of conventional construction materials (steel/concrete) for multi-story buildings. Furthermore, the paper explores the challenges associated with conducting LCA on CLT buildings, identifies the gaps in knowledge, and outlines directions for future research. © 2022 The Authors},
	author_keywords = {Carbon footprint; Climate change; Cross-laminated timber; Life cycle assessment; Sustainable multi-story construction},
	keywords = {Building materials; Buildings; Climate change; Construction; Construction industry; Emission control; Gas emissions; Greenhouse gases; Laminating; Life cycle; Timber; Building construction; Cross laminated; Cross-laminated timber; Greenhouse gas emissions; In-buildings; Laminated timber; Steel concrete; Story construction; Sustainable multi-story construction; Timber buildings; Carbon footprint},
