	keywords = {Binders; Cement industry; Costs; Energy utilization; Fly ash; Gas emissions; Geopolymers; Greenhouse gases; Inorganic polymers; Lime; Portland cement; Slag cement; Slags; Supply chains; Alkali activated cements; Alkali-activated slag cement; Cementitious binders; Energy and cost; Geopolymer; Life Cycle Assessment (LCA); Ordinary Portland cement; Transportation-logistics; Life cycle},
