@ARTICLE{Fischer2023,
	author = {Fischer, Henriette and Aichholzer, Martin and Korjenic, Azra},
	title = {Ecological Potential of Building Components in Multi-Storey Residential Construction: A Comparative Case Study between an Existing Concrete and a Timber Building in Austria},
	year = {2023},
	journal = {Sustainability (Switzerland)},
	volume = {15},
	number = {8},
	doi = {10.3390/su15086349},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85156125461&doi=10.3390%2fsu15086349&partnerID=40&md5=04d219bef16ee9d03155c08ec55cd4ea},
	abstract = {With the introduction of energy-efficient buildings, the importance of embodied energy in new buildings has become increasingly relevant to minimising the impact of climate change. This study compares two existing four-storey residential buildings: one building has a reinforced concrete (RC) structure and the other has a timber structure. The study’s aim is to find out which building components are responsible for the largest embodied impacts and whether there are differences between the two construction methods. The specificity of the wooden building is the combined use of solid and lightweight timber elements. The methodology consists of a general life cycle assessment (LCA) and a more detailed analysis of the product stage using the eco2soft software. The heating and cooling energy demand was calculated using the WUFI Plus software with recent regional climate data sets. The results show that for both types of construction in multi-storey buildings, it is not only the superstructure that needs to be considered, but also the floor structures, which have a major influence on the embodied impact. The timber building requires less energy to maintain the indoor climate within the set temperatures. As climate change has progressed rapidly in Austria in recent years, it is recommended that the standards for climate models be updated more quickly to allow realistic prediction of thermal comfort at the design stage. © 2023 by the authors.},
	author_keywords = {building components; comparative LCA; embodied impacts; energy demand; timber construction},
	keywords = {Austria; climate change; construction; cooling; data set; demand-side management; energy efficiency; heating; life cycle; regional climate; reinforced concrete; timber},
	correspondence_address = {H. Fischer; Research Unit of Ecological Building Technologies, Institute of Material Technology, Building Physics and Building Ecology, Faculty of Civil and Environmental Engineering, Vienna University of Technology, Vienna, A-1040, Austria; email: henriette.fischer@tuwien.ac.at},
	publisher = {MDPI},
	language = {English},
	type = {Article},
	publication_stage = {Final},
