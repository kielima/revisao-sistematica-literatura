	author = {Jiang, Gang and Zuo, Lanlan and Asutosh, Ashish T. and Zhang, Junxue},
	title = {Environmental Sustainability Study of Urban Waterfront Landscapes Based on the LCA–Emergy–Carbon Footprint and Artificial Neural Network Method},
	year = {2024},
	journal = {Buildings},
	volume = {14},
	number = {2},
