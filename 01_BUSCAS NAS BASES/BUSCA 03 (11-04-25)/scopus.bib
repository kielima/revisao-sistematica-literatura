	title = {A Study on Life Cycle Analysis of Bituminous and Cement Concrete Pavements with Recycled Materials in Circular Economy},
	year = {2024},
	journal = {IOP Conference Series: Earth and Environmental Science},
	volume = {1326},
	number = {1},
