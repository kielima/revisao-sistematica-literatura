	title = {Evaluation of the diffusion model considering the variation in time of the chloride content of the concrete surface; [Avaliação de modelo de difusão considerando a variação no tempo do teor de cloretos na superfície do concreto]},
	year = {2014},
	journal = {Revista Materia},
	volume = {19},
