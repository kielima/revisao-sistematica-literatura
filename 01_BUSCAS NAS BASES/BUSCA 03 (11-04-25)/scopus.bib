}

@ARTICLE{Caneda‐martínez20211,
	author = {Caneda‐martínez, Laura and Monasterio, Manuel and Moreno‐juez, Jaime and Martínez‐ramírez, Sagrario and García, Rosario and Frías, Moisés},
	title = {Behaviour and properties of eco‐cement pastes elaborated with recycled concrete powder from construction and demolition wastes},
	year = {2021},
	journal = {Materials},
	volume = {14},
	number = {5},
	pages = {1 – 19},
	doi = {10.3390/ma14051299},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85102762532&doi=10.3390%2fma14051299&partnerID=40&md5=dbe56323b25ea6daa4555c81ce0a2cda},
	abstract = {This work analyses the influence of fine concrete fractions (<5 mm) of different natures — calcareous (HcG) and siliceous (HsT)—obtained from construction and demolition waste (C&DW) on the behaviour of blended cement pastes with partial replacements between 5 and 10%. The two C&DW fractions were characterised by different instrumental techniques. Subsequently, their lime-fixing capacity and the physico‐mechanical properties of the blended cement pastes were analysed. Lastly, the environmental benefits of reusing these fine wastes in the manufacture of future eco-efficient cement pastes were examined. The results show that HsT and HcG exhibit weak pozzolanic activity, owing to their low reactive silica and alumina content. Despite this, the new cement pastes meet the physical and mechanical requirements of the existing regulations for common cements. It should be highlighted that the blended cement pastes initially showed a coarser pore network, but then they underwent a refinement process between 2 and 28 days, along with a gain in compressive strength, possibly due to the double pozzolanic and filler effect of the wastes. The environmental viability of the blended cements was evaluated in a Life Cycle Assessment (LCA) concluding that the overall environmental impact could be reduced in the same proportion of the replacement rate. This is in line with the Circular Economy goals and the 2030 Agenda for Sustainable Development. © 2021 by the author. Licensee MDPI, Basel, Switzerland.},
	author_keywords = {Circular economy; Construction and demolition waste; Eco‐efficient cements; Supplementary cementitious materials},
	keywords = {Alumina; Aluminum oxide; Artificial life; Cement industry; Cements; Compressive strength; Concrete aggregates; Concretes; Demolition; Environmental impact; Life cycle; Lime; Silica; Sustainable development; Blended cement pastes; Construction and demolition waste; Environmental benefits; Instrumental techniques; Life Cycle Assessment (LCA); Mechanical requirements; Partial replacement; Pozzolanic activity; Cement manufacture},
	correspondence_address = {M. Frías; Eduardo Torroja Institute for Construction Sciences (IETcc‐CSIC), Madrid, 28033, Spain; email: mfrias@ietcc.csic.es},
