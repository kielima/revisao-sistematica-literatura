@CONFERENCE{Pittau2019,
	author = {Pittau, F. and Dotelli, G. and Arrigoni, A. and Habert, G. and Iannaccone, G.},
	title = {Massive timber building vs. conventional masonry building. A comparative life cycle assessment of an Italian case study},
	year = {2019},
