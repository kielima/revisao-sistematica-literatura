@CONFERENCE{Rayjada2023311,
	author = {Rayjada, S.P. and Ghosh, J. and Raghunandan, M.},
	title = {Impact of modeling uncertainty on seismic life-cycle cost analysis of RC building under mainshock-aftershock sequences},
	year = {2023},
