	author = {Syamsunur, Deprizon and Wei, Li and Hisyam, Muhammad Noor and Memon, Zubair Ahmed and Sultan, Basel},
	title = {Research on performance monitoring of binary nano modified concrete based on temperature variation},
	year = {2023},
	journal = {Case Studies in Construction Materials},
	volume = {19},
