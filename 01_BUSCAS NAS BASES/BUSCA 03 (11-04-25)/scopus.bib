	title = {LIFE CYCLE ASSESSMENT OF CARBON CONCRETE COMPOSITES: A CIRCULAR ECONOMY PATH BEYOND CLIMATE MITIGATION?},
	year = {2022},
	journal = {Acta Polytechnica CTU Proceedings},
