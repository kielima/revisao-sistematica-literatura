AUTHOR = {Ramagiri, Kruthi Kiran and Kara De Maeijer, Patricia and Kar, Arkamitra},
TITLE = {High-Temperature, Bond, and Environmental Impact Assessment of Alkali-Activated Concrete (AAC)},
