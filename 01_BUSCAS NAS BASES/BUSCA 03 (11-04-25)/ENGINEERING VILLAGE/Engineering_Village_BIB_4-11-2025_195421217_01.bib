journal = {Building Services Engineering Research and Technology},
author = {Mohebbi, Golnaz and Hasan, Agha and Blay-Armah, Augustine and Bahadori-Jahromi, Ali and Mylona, Anastasia and Barthorpe, Mark},
volume = {44},
