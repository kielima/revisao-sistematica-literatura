keywords = {Architectural design;Bridges;Concrete buildings;Cost engineering;Data visualization;Digital storage;Disaster prevention;Efficiency;Internet of things;Life cycle;Precast concrete;Quality control;Reinforced concrete;},
note = {BIM technologies;Construction data;Data-source;Infrastructure industry;Manufacturing technologies;Precast concrete structures;Production process;Reinforcing bar;Smart manufacturing;Steel reinforcements;},
URL = {http://dx.doi.org/10.1088/1742-6596/2775/1/012028},
} 


