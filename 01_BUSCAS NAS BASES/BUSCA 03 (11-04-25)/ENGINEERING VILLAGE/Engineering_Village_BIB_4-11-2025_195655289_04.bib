} 


@article{20121114843828 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Life cycle data management: First step towards a new product lifecycle management standard},
journal = {International Journal of Computer Integrated Manufacturing},
author = {Taisch, M. and Cammarino, B.P. and Cassina, J.},
