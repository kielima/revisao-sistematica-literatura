note = {Cumulative energy demands;Global warming potential;Levels of analysis;Life Cycle Assessment (LCA);Life cycle energies;Life cycle stages;Screening assessment;Transport infrastructure;},
URL = {http://dx.doi.org/10.18757/ejtir.2012.12.1.2948},
} 


@inproceedings{20131516197096 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
