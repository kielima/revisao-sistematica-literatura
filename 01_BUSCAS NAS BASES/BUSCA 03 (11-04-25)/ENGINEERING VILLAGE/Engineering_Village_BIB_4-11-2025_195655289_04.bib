journal = {Zairyo/Journal of the Society of Materials Science, Japan},
author = {Furuta, Hitoshi and Koyama, Kazuhiro},
volume = {54},
number = {1},
year = {2005},
pages = {25 - 31},
issn = {05145163},
abstract = {In this study, an attempt is made to develop an analysis method for calculating Life-Cycle Cost (LCC) of Reinforced Concrete (RC) piers, paying attention to the difference of initial seismic performance. In order to evaluate the seismic performance, reliability index in service life is used by considering the deterioration of RC piers due to the corrosion. Through several numerical examples, the following conclusions were derived: 1) It is difficult to calculate LCC by considering only the initial seismic performance. 2) Paying attention to the corrosion of reinforcement, the service life of RC piers becomes longer as the longitudinal reinforcement ratio becomes larger. 3) It is obtained that the maintenance actions during service life greatly affect LCC minimization.},
key = {Reinforced concrete},
keywords = {Concrete bridges;Corrosion;Cost benefit analysis;Deterioration;Earthquake resistance;Life cycle;Piers;Preventive maintenance;Reliability theory;Seismic waves;},
note = {Bridge deterioration;Bridge maintenance;Life-cycle cost analysis;Performance-based design;Reinforced concrete pier;Seismic performance;},
URL = {http://dx.doi.org/10.2472/jsms.54.25},
} 


@article{2005129004441 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Life cycle modeling of concrete bridge design: Comparison of engineered cementitious composite link slabs and conventional steel expansion joints},
journal = {Journal of Infrastructure Systems},
author = {Keoleian, Gregory A. and Kendall, Alissa and Dettling, Jonathan E. and Smith, Vanessa M. and Chandler, Richard F. and Lepech, Michael D. and Li, Victor C.},
volume = {11},
number = {1},
year = {2005},
pages = {51 - 60},
issn = {10760342},
abstract = {Concrete infrastructure represents an enormous investment of materials, energy, and capital, and results in significant environmental burdens and social costs. There is an ongoing effort to identify material alternatives to conventional concrete. Life cycle assessment (LCA) is an important tool to evaluate the environmental performance of alternative infrastructure materials and systems. Here, we present a comparative LCA of two bridge deck systems over a 60 year service life: one using conventional steel expansion joints and the other based on a link slab design using a concrete alternative, engineered cementitious composites (ECC). The ECC link slab design is expected to extend the bridge deck service life and reduce maintenance activities. A life cycle model was developed that accounts for materials production and distribution, construction and maintenance processes, construction-related traffic congestion, and end-of-life management. Results indicate that the ECC bridge deck system has significant advantages in environmental performance: 40% less life cycle energy consumption, 50% less solid waste generation, and 38% less raw material consumption. Construction related traffic congestion is the greatest contributor to most life cycle impact categories. © ASCE.},
key = {Concrete bridges},
keywords = {Bridge decks;Costs;Energy utilization;Expansion joints;Investments;Life cycle;Maintenance;Social aspects;Solid wastes;Structural analysis;},
note = {Engineered cementitious composites (ECC);Life cycle assessment (LCA);Solid waste generation;Steel expansion joints;Traffic congestion;},
URL = {http://dx.doi.org/10.1061/(ASCE)1076-0342(2005)11:1(51)},
} 


