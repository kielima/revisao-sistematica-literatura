title = {A Fuzzy Multi Criteria Approach for Sustainable Manufacturing Evaluation in Cement Industry},
journal = {Procedia CIRP},
author = {Amrina, Elita and Ramadhani, Chintia and Vilsi, Annike Lutfia},
volume = {40},
