keywords = {Carbon;Environmental impact;Lime;Risk assessment;Life cycle;Cements;Repair;Buildings;},
note = {Building services;Construction environment;Embodied carbons;Innovative design;Long-term impacts;Maintenance Action;Performance based design;Saving potentials;},
URL = {http://dx.doi.org/10.1016/j.enbuild.2017.08.026},
} 


@inproceedings{20174704435829 ,
