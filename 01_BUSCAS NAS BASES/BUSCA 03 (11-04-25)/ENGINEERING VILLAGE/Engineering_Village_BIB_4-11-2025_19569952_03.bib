copyright = {Compendex},
title = {Cradle-to-gate life cycle assessment of self-healing engineered cementitious composite with in-house developed (semi-)synthetic superabsorbent polymers},
journal = {Cement and Concrete Composites},
author = {Van den Heede, Philip and Mignon, Arn and Habert, Guillaume and De Belie, Nele},
volume = {94},
year = {2018},
pages = {166 - 180},
issn = {09589465},
abstract = {Autogenous crack healing can be stimulated with superabsorbent polymers (SAPs) in microfibre reinforced strain hardening engineered cementitious composite (ECC). Cradle-to-gate life cycle assessment was performed for self-healing ECC with 1 m% of three in-house developed (semi-)synthetic SAPs and 2 v% of polypropylene (PP) or polyvinyl alcohol (PVA) microfibre. Given the high cement content of this ECC (572 kg/m<sup>3</sup>), CML-IA impacts of 1 m% SAP range between 4 and 52% of the cement impact. The highest impacts were recorded for semi-synthetic SAPs, due to high energy use during drying. Use of PVA microfibre should be avoided since addition of 2 v% (= 26 kg/m<sup>3</sup>) can easily induce significantly higher CML-IA impacts than 572 kg cement. Nonetheless, if 100% crack healing efficiency could be assumed for slabs made of self-healing ECC, CML-IA impacts remain lower than those of a slab made of traditional concrete with inclusion of the required cover replacements within 100 years.<br/> © 2018 Elsevier Ltd},
key = {Life cycle},
keywords = {Self-healing materials;Strain hardening;Concretes;Reinforced plastics;Cements;Polypropylenes;},
note = {Cement content;Crack-healing;Energy use;Engineered cementitious composite (ECC);Life Cycle Assessment (LCA);Poly (vinyl alcohol) (PVA);Self-healing;Superabsorbent polymer;},
URL = {http://dx.doi.org/10.1016/j.cemconcomp.2018.08.017},
} 


