language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Concrete hybrid manufacturing: A machine architecture},
journal = {Procedia CIRP},
author = {Muniz, Manuel Menendez and Chantin, Marjorie and Vintila, Cristian Raul and Fabritius, Marc and Martin, Christoph and Calvo, Laura and Poudelet, Louison and Canou, Joseph and Uhart, Maylis and Papacharalampopoulos, Alexios and Stavropoulos, Panos and Olsson, Nils Olof Emanuel and Tenorio, Jose Antonio and Madrid, Javier Alonso and Dirrenberger, Justin and Munoz, Ivan},
volume = {97},
