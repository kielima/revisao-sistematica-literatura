copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Characterization of cracks of damaged concrete structures in dynamics},
journal = {Computational Modelling of Concrete  Structures - Proceedings of the conference on Computational Modelling of Concrete&amp;amp;amp;amp;amp;amp;amp;amp;nbsp;and Concrete Structures, EURO-C 2018},
author = {Akiki, R. and Giry, C. and Gatuingt, F.},
year = {2018},
pages = {1009 - 1016},
address = {Bad Hofgastein, Austria},
abstract = {The analysis and prediction of the degradation process and cracking of concrete structures with numerical models is an important issue in the field of civil engineering. In order to describe the global behavior of a structure composed of quasi-brittle material as well as local fields, a continuous approach using nonlinear constitutive law (e.g. damage, plasticity, …) remains the most efficient one regarding the computational time. However, one has to consider additional tools to extract discrete information about cracks like spacing and openings from these computations. The objective of this research is to propose tools capable of extracting local information such as cracking using two post-treatment methods of a global finite element analysis. These methods are applied to a dynamic one-point bend test case and results show the capability of both methods to give a good estimation of crack path and openings.<br/> © 2018 Taylor & Francis Group, London.},
key = {Concrete construction},
keywords = {Brittleness;Concretes;Life cycle;Concrete buildings;},
note = {Computational time;Continuous approach;Cracking of concrete;Degradation process;Discrete information;Non-linear constitutive laws;Post-treatment method;Quasibrittle material;},
URL = {http://dx.doi.org/10.1201/9781315182964-116},
} 


@inproceedings{20190706497947 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Modeling of bond fatigue in reinforced concrete based on cumulative measure of slip},
journal = {Computational Modelling of Concrete  Structures - Proceedings of the conference on Computational Modelling of Concrete&amp;amp;amp;amp;amp;amp;amp;amp;nbsp;and Concrete Structures, EURO-C 2018},
author = {Baktheer, A. and Chudoba, R.},
year = {2018},
pages = {767 - 776},
address = {Bad Hofgastein, Austria},
abstract = {In this paper we introduce a thermodynamically consistent bond-interface pressure-sen-sitive damage model with cumulative sliding strain measure as a fundamental source of fatigue damage. The modeling approach provides a clear physical interpretation of the dissipative mechanisms governing the propagation of fatigue damage within the concrete-steel interface so that it is possible to reproduce both the monoutonic and the cyclic behavior of the bond with a consistent set of material parameters. The model has been applied for simulation of the degradation process in the bond between concrete and reinforcement under pullout fatigue loading. The paper presents numerical studies of the fatigue pullout behavior with detailed analysis of the damage propagation during loading and unloading stages, and at different levels of imposed lateral pressure. To validate the ability of the model, pullout simulations of tests published in the literature have been conducted.<br/> © 2018 Taylor & Francis Group, London.},
key = {Fatigue damage},
keywords = {Unloading;Life cycle;Reinforced concrete;},
note = {Concrete-steel interfaces;Damage propagation;Degradation process;Dissipative mechanisms;Lateral pressures;Loading and unloading;Material parameter;Physical interpretation;},
URL = {http://dx.doi.org/10.1201/9781315182964-90},
} 


@inproceedings{20190706497948 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Fatigue life assessment of reinforced concrete members considering bond-slip},
journal = {Computational Modelling of Concrete  Structures - Proceedings of the conference on Computational Modelling of Concrete&amp;amp;amp;amp;amp;amp;amp;amp;nbsp;and Concrete Structures, EURO-C 2018},
author = {Bhowmik, Sonali and Ray, Sonalisa},
year = {2018},
pages = {777 - 784},
address = {Bad Hofgastein, Austria},
abstract = {In the present work, an analytical model has been developed to predict the crack propagation and fatigue life in reinforced concrete members under the action repetitive loading. The analytical model is developed from the fundamental principles using the theory of dimensional analysis in conjunction with the concept of selfsimilarity. The presence of reinforcement is taken into account by incorporating a pair of closing force in steel. Further, the effect of bond-slip phenomenon on crack propagation and fatigue life estimation has been considered and the variation in steel stresses at different level of slip has been incorporated in the analytical formulation. Various important material and loading parameters which influence the crack propagation behavior are considered in the present analytical formulation. The parameters are, critical energy dissipation, change in energy release rate, initial crack length, maximum size of the aggregate and the reinforcement ratio. The proposed model has been implemented for the prediction of fatigue life and crack growth behavior for the experimental data available in the literature.<br/> © 2018 Taylor & Francis Group, London.},
key = {Analytical models},
keywords = {Life cycle;Reinforced concrete;Energy dissipation;Fatigue of materials;Crack propagation;},
note = {Analytical formulation;Crack growth behavior;Crack propagation behavior;Fatigue life assessment;Fatigue life estimation;Fundamental principles;Prediction of fatigue lives;Reinforced concrete member;},
URL = {http://dx.doi.org/10.1201/9781315182964-91},
} 


@inproceedings{20190706497951 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Simulation of reinforced ductile cement-based composite beams under cyclic loads},
journal = {Computational Modelling of Concrete  Structures - Proceedings of the conference on Computational Modelling of Concrete&amp;amp;amp;amp;amp;amp;amp;amp;nbsp;and Concrete Structures, EURO-C 2018},
author = {Billington, S.L. and Shao, Y. and Frank, T.E. and Bandelt, M.J. and Moreno, D.M.},
year = {2018},
pages = {805 - 812},
address = {Bad Hofgastein, Austria},
abstract = {High Performance Fiber-Reinforced Cement-based Composites (HPFRCCs) exhibit pseudo-strain hardening behavior in tension and little to no spalling in compression. HPFRCC has been proposed for use in earthquake-and blast-resistant structural design due to its high damage tolerance. Tension-stiffening, bond-slip behavior, and reinforcement fracture failure in reinforced HPFRCC components have been experimentally investigated. Numerical modeling approaches to predict these unique experimental responses have also been developed and are further explored and validated here with a cyclically loaded cantilever beam experiment. Simulation results are able to capture the test strength, stiffness, and hysteretic energy dissipation with reasonable accuracy. With the help of a recently developed bond-slip model for reinforced HPFRCCs, reinforcing strains are also well simulated up to drifts of 6%. At large drifts of 12% when the experiment fails, the simulated steel strains are below the expected failure strain of the reinforcing bar, and two possible causes are discussed.<br/> © 2018 Taylor & Francis Group, London.},
key = {Energy dissipation},
keywords = {Strain;Strain hardening;Life cycle;Safety engineering;Structural design;Maintenance;Stiffness;Cements;},
note = {Bond-slip models;Cement based composites;Fracture failure;High-performance fibers;Hysteretic energy dissipations;Numerical modeling approach;Reasonable accuracy;Tension stiffening;},
URL = {http://dx.doi.org/10.1201/9781315182964-94},
} 


