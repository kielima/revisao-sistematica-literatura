title = {Analysis and integration of design for X approaches in lean design as basis for a lifecycle optimized product design},
journal = {Procedia CIRP},
author = {Dombrowski, Uwe and Schmidt, Stefan and Schmidtchen, Kai},
volume = {15},
year = {2014},
