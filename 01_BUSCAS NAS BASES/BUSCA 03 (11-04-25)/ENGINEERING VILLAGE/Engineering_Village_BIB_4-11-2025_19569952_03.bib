note = {Compressive and flexural strengths;Ecological balance;Entire life cycles;Physical and mechanical properties;Physicomechanical properties;Processed materials;Thermal conductivity coefficient;Timber frame construction;},
URL = {http://dx.doi.org/10.1051/e3sconf/20184900010},
} 


@inproceedings{20183805820763 ,
