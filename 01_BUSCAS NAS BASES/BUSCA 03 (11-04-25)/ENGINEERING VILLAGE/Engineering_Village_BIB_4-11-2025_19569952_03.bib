@inproceedings{20194107520665 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Massive timber building vs. conventional masonry building. A comparative life cycle assessment of an Italian case study},
