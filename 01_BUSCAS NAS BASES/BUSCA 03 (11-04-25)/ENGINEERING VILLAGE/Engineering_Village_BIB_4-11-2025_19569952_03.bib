title = {Calculation of fuel consumption and emissions in buildings based on external walls and windows using economic optimization},
title = {Binalarda ekonomik optimizasyon kullanılarak dış duvar ve pencerelere bağlı yakıt tüketimi ve emisyon hesabı},
