note = {Distributed power supplies;Feasibility studies;Investment Options;Investment schemes;Operation and maintenance;Photovoltaic power plant;Return rate of investment;Rural constructions;},
URL = {http://dx.doi.org/10.1088/1755-1315/108/5/052015},
} 


