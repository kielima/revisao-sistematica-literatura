copyright = {Compendex},
title = {Life Cycle Assessment of Warm Mix Asphalt with Recycled Concrete Aggregate},
journal = {IOP Conference Series: Materials Science and Engineering},
author = {Vega, Daniela L. and Gilberto, Martinez A. and Dos Santos, Joao M.O.},
