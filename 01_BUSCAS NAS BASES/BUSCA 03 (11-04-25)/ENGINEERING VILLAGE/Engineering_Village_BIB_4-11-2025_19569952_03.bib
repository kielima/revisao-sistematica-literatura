title = {Reducing water footprint of building sector: Concrete with seawater and marine aggregates},
journal = {IOP Conference Series: Earth and Environmental Science},
author = {Arosio, V. and Arrigoni, A. and Dotelli, G.},
volume = {323},
number = {1},
year = {2019},
