note = {Chemical admixture;High-performance concrete;Hybrid MCDA;Hydrophilic nanosilica;Hydrophobic nanosilicum;Hydrophobics;Materials selection;Nano Silica;Optimal material selection;Optimal materials;Post-tensioned girder bridges;},
URL = {http://dx.doi.org/10.3390/ma14216553},
} 


