@inproceedings{20203209029147 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Life Cycle Assessment of Biochar as a Partial Replacement to Portland Cement},
journal = {IOP Conference Series: Earth and Environmental Science},
author = {Campos, J. and Fajilan, S. and Lualhati, J. and Mandap, N. and Clemente, S.},
