title = {Hybrid simulation of bridges constructed with concrete-filled steel tube columns subjected to horizontal and vertical ground motions},
journal = {Bulletin of Earthquake Engineering},
author = {Al-Attraqchi, Ali Y. and Hashemi, M. Javad and Al-Mahaidi, Riadh},
volume = {18},
