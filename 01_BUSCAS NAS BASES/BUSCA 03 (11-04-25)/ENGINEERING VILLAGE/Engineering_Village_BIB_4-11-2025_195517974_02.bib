keywords = {Concrete beams and girders;Corrosion;Deflection (structures);Life cycle;Stiffness;},
note = {Beam stiffness;Bending stiffness;Corrosion damage;Corrosion damage of concrete;Damaged beam;Deflection;Height of compressed zone;Reinforced concrete beams;Reinforced concrete elements;Strength of reinforced concrete element;},
URL = {http://dx.doi.org/10.3233/ATDE220847},
} 


