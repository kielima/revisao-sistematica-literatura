title = {Time-dependent reliability analysis of corroded RC beams based on the phase-type fitting method},
journal = {Eksploatacja i Niezawodnosc},
author = {Li, Junxiang and Chen, Jianqiao and Zhang, Xinxin and Wu, Zijun},
volume = {25},
number = {4},
year = {2023},
issn = {15072711},
abstract = {<div data-language="eng" data-ev-field="abstract">It remains an important challenge to quantitatively describe the corrosion of reinforced concrete (RC) structures under chloride penetration. When considering the uncertainties encountered throughout the life cycle of RC structures exposed to a corrosive environment and evaluating their safety and reliability, the complexity of the problem intensifies. To address these issues, this paper focuses on the time-dependent reliability analysis of corroded RC beams, utilizing the phase-type (PH) fitting method. Initially, a model for the time-dependent reliability of corroded RC beams is established, incorporating the time-dependent chloride diffusion coefficient. Subsequently, a novel PH fitting method is proposed. The effectiveness of this new method is demonstrated through numerical examples. Furthermore, the time-dependent reliability analysis of corroded RC beams is compared using both the PH fitting method and the Monte Carlo simulation. The results reveal that the proposed method can accurately and efficiently deal with time-dependent reliability problems.<br/></div> © 2023, Polish Academy of Sciences Branch Lublin. All rights reserved.},
key = {Life cycle},
keywords = {Chlorine compounds;Concrete beams and girders;Corrosion;Intelligent systems;Monte Carlo methods;Numerical methods;Reinforced concrete;Reliability analysis;Uncertainty analysis;},
note = {Chloride penetration;Corroded reinforced concrete beams;Corrosive environment;Exposed to;Fitting method;Phase-type fitting method;Reinforced concrete structures;Time dependent reliability;Time dependent reliability analysis;Uncertainty;},
URL = {http://dx.doi.org/10.17531/ein/172442},
} 


@inproceedings{20233814741073 ,
