note = {Crumb rubber;Crumb rubber-modified asphalt;End of lives;End-of-life tire;High viscosities;Life cycle costs analysis;Sustainability analysis;Wearing course;Wet process;Wet process high viscosity;},
URL = {http://dx.doi.org/10.1016/j.conbuildmat.2022.127468},
} 


@article{20221611992980 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Sustainability of alternative reinforcement for concrete structures: Life cycle assessment of basalt FRP bars},
journal = {Construction and Building Materials},
author = {Pavlovi, A. and Donchev, T. and Petkova, D. and Staletovi, N.},
volume = {334},
year = {2022},
issn = {09500618},
abstract = {<div data-language="eng" data-ev-field="abstract">Due to the global climate emergency as a result of anthropogenic activities, an accelerated progress towards sustainable thinking is needed. The construction industry, as one of the contributors to the global emissions, must re-examine the construction materials, procedures and technologies which are traditionally used. To reach an informed design decision with regards to sustainability, the engineering community would benefit from independent and objective studies of the environmental impact of materials and systems. Crucially, decarbonising concrete structures should emerge as a priority, due to the wide availability and utilisation of the material. Although the fibre reinforced polymers have caused an interest of the construction industry due to their favourable mechanical properties, Life Cycle Assessment (LCA) studies of alternative reinforcing options are very limited to date. This paper presents an evaluation of the environmental impact of BFRP reinforcing bars. Using an LCA approach, the conducted study aims to examine the potential of utilising BFRP for creating more sustainable reinforced concrete structures. It includes a contribution analysis of the production of BFRP bars, as well as comparison with steel, glass FRP, galvanised steel and stainless-steel bars. Additionally, a comparison of BFRP and steel reinforced beams is offered, supported by the results of experimental flexural testing. The findings of the study demonstrate that BFRP bars can contribute to large reduction of embodied emissions of reinforced concrete elements in comparison with steel, and other reinforcing materials.<br/></div> © 2022 The Author(s)},
key = {Life cycle},
keywords = {Bridge decks;Reinforced concrete;Basalt;Concrete buildings;Fiber reinforced plastics;Bars (metal);Galvanizing;Sustainable development;Construction industry;Concrete construction;Environmental impact;},
note = {Anthropogenic activity;Basalt FRP;Fiber reinforced polymer bar;Fiber-reinforced polymers;Fibre reinforced polymers;FRP bar;Global climates;Sustainable concrete reinforcement;Sustainable concretes;Sustainable thinking;},
URL = {http://dx.doi.org/10.1016/j.conbuildmat.2022.127424},
} 


@article{20224313012483 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Comparative life cycle assessment of large-scale 3D printing utilizing kaolinite-based calcium sulfoaluminate cement concrete and conventional construction},
