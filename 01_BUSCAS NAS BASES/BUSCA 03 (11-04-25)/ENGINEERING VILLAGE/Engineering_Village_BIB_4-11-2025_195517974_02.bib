note = {Basalt fiber;Basalt fibre reinforcements;Buildings materials;Complex assessment;Eco-efficiency;Environmental efficiency;Fiber-reinforced materials;Functional performance;Modern buildings;Performance criterion;},
URL = {http://dx.doi.org/10.3390/en14227736},
} 


@article{20214711203301 ,
