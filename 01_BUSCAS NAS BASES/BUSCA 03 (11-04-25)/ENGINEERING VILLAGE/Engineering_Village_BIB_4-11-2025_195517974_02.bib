@article{20224813174951 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Integrating a Chemicals Perspective into the Global Plastic Treaty},
journal = {Environmental Science and Technology Letters},
author = {Wang, Zhanyun and Praetorius, Antonia},
volume = {9},
number = {12},
year = {2022},
pages = {1000 - 1006},
issn = {23288930},
abstract = {<div data-language="eng" data-ev-field="abstract">Driven by the growing concern about plastic pollution, countries have agreed to establish a global plastic treaty addressing the full life cycle of plastics. However, while plastics are complex materials consisting of mixtures of chemicals such as additives, processing aids, and nonintentionally added substances, it is at risk that the chemical aspects of plastics may be overlooked in the forthcoming treaty. This is highly concerning because a large variety of over 10,000 chemical substances may have been used in plastic production, and many of them are known to be hazardous to human health and the environment. In this Global Perspective, we further highlight an additional, generally overlooked, but critical aspect that many chemicals in plastics hamper the technological solutions envisioned to solve some of the major plastic issues: mechanical recycling, waste-to-energy, chemical recycling, biobased plastics, biodegradable plastics, and durable plastics. Building on existing success stories, we outline three concrete recommendations on how the chemical aspects can be integrated into the global plastic treaty to ensure its effectiveness: (1) reducing the complexity of chemicals in plastics, (2) ensuring the transparency of chemicals in plastics, and (3) aligning the right incentives for a systematic transition.<br/></div> © 2022 American Chemical Society. All rights reserved.},
key = {Indicators (chemical)},
keywords = {Additives;Biodegradable polymers;Elastomers;Life cycle;Plastic recycling;},
note = {Bio-based;Biobased plastic;Biodegradable plastics;Durable plastic;Global plastic treaty;Nonintentionally added substance;Plastic additives;Plastic processing aid;Plastics processing;Plastics recycling;Processing aids;Waste to energy;},
URL = {http://dx.doi.org/10.1021/acs.estlett.2c00763},
} 


@inproceedings{20225113286379 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {EVALUATION OF 3D MODEL OF REBAR FOR QUANTITATIVE PARAMETERS},
journal = {International Archives of the Photogrammetry, Remote Sensing and Spatial Information Sciences - ISPRS Archives},
author = {Qureshi, A.H. and Alaloul, W.S. and Murtiyoso, A. and Hussain, S.J. and Saad, S. and Oad, V.K.},
volume = {48},
