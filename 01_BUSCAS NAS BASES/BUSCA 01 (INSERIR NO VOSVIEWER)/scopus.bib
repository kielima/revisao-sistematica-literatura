@ARTICLE{Roßmann2021213,
	author = {Roßmann, Maximilian and Stratmann, Matthias and Rötzer, Nadine and Schäfer, Philipp and Schmidt, Mario},
	title = {Comparability of lcas — review and discussion of the application purpose},
	year = {2021},
	journal = {Sustainable Production, Life Cycle Engineering and Management},
	pages = {213 – 225},
	doi = {10.1007/978-3-030-50519-6_15},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091588486&doi=10.1007%2f978-3-030-50519-6_15&partnerID=40&md5=eb334dc5910a4f7112dc3368370d2499},
	abstract = {This article discusses the comparability of Life Cycle Assessments (LCAs) and the central role of the application purpose in a study review. According to ISO 14040, an LCA study design emerges in continuous reference to the “intended application”. Goal and scope, case-specific assumptions, as well as methodological freedoms, should be justified by their significance for the specific application purpose, e.g. for process optimization or for advice on a political issue. In contrast, our systematic review of 58 LCA studies shows that LCAs hardly name applications, and more generally, applications are difficult to reconstruct. This lack of transparency makes the LCA methodology attackable through meta-studies that ignore the problem-oriented and case-specific approach. Since these studies are valuated for different purposes by a diverse set of actors, quantification in any study that does not represent the context and purpose of its generation can disguise as much as it can enlighten. Therefore, we propose what a study should look like that is problem-solving, concrete and yet provides transferable results for other studies. © 2021, Springer Nature Switzerland AG.},
	author_keywords = {Application; Biofuels; Comparability; Life cycle assessment; Systems theory; Technology assessment},
	keywords = {Biofuels; Optimization; System theory; Assessment methodologies; Comparability; IS problems; Life cycle assessment; Meta-study; Political issues; Process optimisation; Study design; Systematic Review; Technology assessments; Life cycle},
