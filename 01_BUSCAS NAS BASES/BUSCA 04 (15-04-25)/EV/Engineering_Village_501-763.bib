journal = {Bridge Maintenance, Safety, Management, Digitalization and Sustainability - Proceedings of the 12th International Conference on Bridge Maintenance, Safety and Management, IABMAS 2024},
author = {Lee, S.H. and An, L.S. and Kim, H.K.},
