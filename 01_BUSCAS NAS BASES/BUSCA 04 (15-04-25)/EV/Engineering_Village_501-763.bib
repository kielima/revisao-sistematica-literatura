title = {Sustainable end-of-life value chain scenarios for wind turbine blades},
journal = {Journal of Physics: Conference Series},
author = {Fayyaz, S. and Lund, K.W. and Khoshnevisan, B. and Madsen, E.S. and Birkved, M.},
volume = {2507},
