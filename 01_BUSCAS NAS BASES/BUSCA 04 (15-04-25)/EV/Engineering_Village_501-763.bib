title = {A Workability and sustainability assessment of multistorey earthquake-resistant timber building},
journal = {13th World Conference on Timber Engineering, WCTE 2023},
author = {Tsuda, Kazuki and Aljuhmani, Ahmad Ghazi and Minegishi, Arata and Goto, Yutaka and Maeda, Masaki},
volume = {7},
