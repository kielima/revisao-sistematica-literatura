copyright = {Compendex},
title = {Potential of Mechanochemically Activated Sulfidic Mining Waste Rock for Alkali Activation},
journal = {Journal of Sustainable Metallurgy},
author = {Niu, He and Adrianto, Lugas Raka and Escobar, Alexandra Gomez and Zhukov, Vladimir and Perumal, Priyadharshini and Kauppi, Janne and Kinnunen, Paivo and Illikainen, Mirja},
