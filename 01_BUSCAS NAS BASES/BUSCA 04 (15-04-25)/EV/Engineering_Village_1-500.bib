@article{20240415441024 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Environmental and mechanical analysis of low-carbon concrete with vitrified MSW incineration bottom ash as cement replacement},
journal = {Structural Concrete},
