copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {Decarbonization potential of steel fibre-reinforced limestone calcined clay cement concrete one-way slabs},
journal = {Construction and Building Materials},
author = {Hafez, Hisham and Malchiodi, Beatrice and Toi, Nikola and Drewniok, Michal and Purnell, Phil and de la Fuente, Albert},
