copyright = {Compendex},
title = {Eco-efficiency evaluation of sustainable self-compacting concrete using magnesite mine waste},
journal = {Case Studies in Construction Materials},
author = {Vembu, Pitchiah Raman Shunmuga and Ammasi, Arun Kumar},
