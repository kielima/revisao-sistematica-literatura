note = {Computational model;Durability factor;Life Cycle Assessment (LCA);Mechanical characteristics;Non-destructive test;Structural behaviour;Structural elements;Time-dependent behaviour;},
URL = {http://dx.doi.org/10.1088/1757-899X/586/1/012021},
} 


@article{20131116116064 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2025 Elsevier Inc.},
copyright = {Compendex},
title = {A materials life cycle assessment of a net-zero energy building},
