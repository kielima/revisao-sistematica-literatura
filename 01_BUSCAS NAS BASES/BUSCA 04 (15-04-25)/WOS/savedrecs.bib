@inproceedings{ WOS:000387975200047,
Author = {Song, Dan and Chen, Bin},
Editor = {Yan, J and Chen, B and Yang, J},
Title = {Extended Exergy Accounting For Energy Consumption and CO2
   Emissions of Cement Industry-A Basic Framework},
Booktitle = {CUE 2015 - APPLIED ENERGY SYMPOSIUM AND SUMMIT 2015: LOW CARBON CITIES
   AND URBAN ENERGY SYSTEMS},
Series = {Energy Procedia},
Year = {2016},
Volume = {88},
Pages = {305-308},
Note = {Applied Energy Symposium and Summit - Low Carbon Cities and Urban Energy
   Systems (CUE), Fuzhou, PEOPLES R CHINA, NOV 15-17, 2015},
Abstract = {Owing to the intensive energy consumption and CO2 emissions of cement
   production process, attention has been focused on exploring an
   integrated metric for mitigation potential. Exergy is thereby raised to
   analyze the system operation efficiency and environmental cost. In this
   paper, exergetic efficiency and CO2 emission targeted at a typical
   cement production line are examined in detail with key factors of
