@article{ WOS:001323137800001,
Author = {Beskopylny, Alexey N. and Shcherban, Evgenii M. and Stel'makh, Sergey A.
   and Shilov, Alexandr A. and Chernil'nik, Andrei and El'shaeva, Diana and
