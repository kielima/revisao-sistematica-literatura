Language = {English},
Affiliation = {Nshimiyimana, P (Corresponding Author), Inst Int Ingn Eau \& Environm Inst 2iE, Lab Ecomat \& Habitats Durables LEMHaD, Rue Sci,01 BP 594, Ouagadougou, Burkina Faso.
