@article{ WOS:000599003100006,
Author = {Olagunju, B. D. and Olanrewaju, O. A.},
Title = {COMPARISON OF LIFE CYCLE ASSESSMENT TOOLS IN CEMENT PRODUCTION},
Journal = {SOUTH AFRICAN JOURNAL OF INDUSTRIAL ENGINEERING},
Year = {2020},
Volume = {31},
