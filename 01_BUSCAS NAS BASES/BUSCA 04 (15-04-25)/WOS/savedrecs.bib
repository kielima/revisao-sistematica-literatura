@article{ WOS:001220082200002,
Author = {Cherni, Makrem and Sebei, Abdelaziz and Amor, Ben and Hssine, Naziha and
   Hajjaji, Noureddine},
Title = {Critical reviews and benchmarking Tunisian clinker and cement with life
   cycle assessment results},
