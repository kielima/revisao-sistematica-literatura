@article{ WOS:000451531700339,
Author = {Cantisani, Giuseppe and Di Mascio, Paola and Moretti, Laura},
Title = {Comparative Life Cycle Assessment of Lighting Systems and Road Pavements
   in an Italian Twin-Tube Road Tunnel},
Journal = {SUSTAINABILITY},
Year = {2018},
Volume = {10},
Number = {11},
Month = {NOV},
Abstract = {This work calculates and discusses the Life Cycle Assessment (LCA) of
   four scenarios composed of two types of road pavements and two types of
   lighting systems to be built in an Italian twin-tube road tunnel. A
   20-year time horizon is adopted to assess the burdens of construction
   and maintenance of both flexible and rigid pavements and high-pressure
   sodium (HPS) and light-emitting diode (LED) lamps, traffic, and
   switching on of lamps. All considered scenarios are comparable with each
   other in terms of technical performances, but significantly differ
   regarding their environmental consequences. The geometrical and
   technical characteristics of the examined scenarios comply with current
   Italian standards for highways. In all the examined cases, LCA is
   carried out according to the European standard, EN 15804, and includes
   19 impact categories (IC). The analysis demonstrates that the use of
   more reflecting surface pavement materials (i.e., concrete vs. asphalt)
   and more performing lighting systems (i.e., LED vs. HPS) can effectively
   mitigate the deleterious burdens related to road construction,
   maintenance, and use. For most of the examined ICs, the most
   environment-friendly scenario has LED lamps and concrete pavement.},
Type = {Article},
Language = {English},
Affiliation = {Moretti, L (Corresponding Author), Sapienza Univ Rome, Dept Civil Construct \& Environm Engn, I-00184 Rome, Italy.
   Cantisani, Giuseppe; Di Mascio, Paola; Moretti, Laura, Sapienza Univ Rome, Dept Civil Construct \& Environm Engn, I-00184 Rome, Italy.},
DOI = {10.3390/su10114165},
Article-Number = {4165},
ISSN = {2071-1050},
Keywords = {tunnel lighting; light-emitting diode; high-pressure sodium; EN 15804;
   LCA; road tunnel},
Keywords-Plus = {CONSTRUCTION; IMPACT},
Research-Areas = {Science \& Technology - Other Topics; Environmental Sciences \& Ecology},
