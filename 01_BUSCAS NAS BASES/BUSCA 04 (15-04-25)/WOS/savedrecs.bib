@article{ WOS:000457951100021,
Author = {Teixeira, E. R. and Mateus, R. and Camoes, A. and Branco, F. G.},
Title = {Quality and durability properties and life-cycle assessment of high
   volume biomass fly ash mortar},
Journal = {CONSTRUCTION AND BUILDING MATERIALS},
Year = {2019},
Volume = {197},
Pages = {195-207},
Month = {FEB 10},
Abstract = {The effect of using biomass fly ash (BFA) on the quality, durability and
   sustainability of mortars was studied. Using high amounts of BFA does
   not lead to a production of mortars with better performance than a plain
   cement mortar. However, when BFA is used in small amounts mixed with
   coal fly ash, mortars with similar compressive strength, to that of a
   cement mortar, but with less carbonation and with better environmental
   performance are obtained. Using BFA in the concrete industry can lead to
   a minimisation of issues related to the high volume fly ash concrete.
   (C) 2018 Elsevier Ltd. All rights reserved.},
