@article{ WOS:000926038300001,
Author = {Smith, Lucy and Ali, Mustafa and Agrissais, Manon and Mulligan, Steven
   and Koh, Lenny and Martin, Nicolas},
Title = {A comparative life cycle assessment of dental restorative materials},
Journal = {DENTAL MATERIALS},
Year = {2023},
