@article{ WOS:000845092500001,
Author = {Alotaibi, Badr Saad and Khan, Sahil Ali and Abuhussain, Mohammed Awad
   and Al-Tamimi, Nedhal and Elnaklah, Rana and Kamal, Mohammad Arif},
Title = {Life Cycle Assessment of Embodied Carbon and Strategies for
   Decarbonization of a High-Rise Residential Building},
Journal = {BUILDINGS},
Year = {2022},
Volume = {12},
Number = {8},
Month = {AUG},
Abstract = {The construction sector is responsible for the 40\% of consumed
   resources, 40\% of CO2 emissions, and approximately 40\% of construction
   and demolition waste. For the assessment of the building, there exists a
   standardized method, life cycle assessment (LCA), however, the process
   requires time, cost, and most importantly expertise. In this paper, a
   method is proposed and analyzed for the life cycle assessment of the
   building for the embodied carbon in the three stages, construction,
   operation, and demolition. Moreover, the result of the analysis is
   considered as the base result, and de-carbonization strategies
   identified through literature study for the three stages of
   construction, operation, and demolition are assessed with the same
   method to know how much each strategy will be effective in minimizing
   the embodied carbon. For the base case, a high-rise residential building
   in an urban region of India is analyzed, based on existing conditions
   through the building information modeling (BIM) method. The carbon
   emission of the selected building comes out to be 414 kg
   CO(2)e/m(2)/year, and assessing different decarbonization strategies,
   considering the first analysis as the baseline, it can be minimized to
   135 kg CO(2)e/m(2)/year.},
Type = {Article},
Language = {English},
Affiliation = {Abuhussain, MA (Corresponding Author), Najran Univ, Coll Engn, Architectural Engn Dept, Najran 66426, Saudi Arabia.
