@article{ WOS:000428567100272,
Author = {Navarro, Ignacio J. and Yepes, Victor and Marti, Jose V.},
Title = {Life Cycle Cost Assessment of Preventive Strategies Applied to
   Prestressed Concrete Bridges Exposed to Chlorides},
Journal = {SUSTAINABILITY},
Year = {2018},
Volume = {10},
Number = {3},
Month = {MAR},
Abstract = {This paper applies Life Cycle Assessment methodology to aid in the
   decision making to select the preventive measure against chloride
   corrosion in concrete structures that works best for the socio-economic
   context of the structure. The assumed model combines the concepts of
   Life Cycle Cost Analysis and Social Life Cycle Analysis to assess the
   impacts on users derived from the maintenance activities associated with
   each alternative analyzed in terms of economic costs. The model has been
   applied to a prestressed concrete bridge to obtain a preventive measure
   that can reduce the total costs incurred over the period of analysis by
   up to 58.5\% compared to the cost of the current solution.},
Type = {Article},
Language = {English},
Affiliation = {Martí, JV (Corresponding Author), Univ Politecn Valencia, Inst Concrete Sci \& Technol ICITECH, E-46022 Valencia, Spain.
   Navarro, Ignacio J., Univ Politecn Valencia, Dept Construct Engn, E-46022 Valencia, Spain.
   Yepes, Victor; Marti, Jose V., Univ Politecn Valencia, Inst Concrete Sci \& Technol ICITECH, E-46022 Valencia, Spain.},
DOI = {10.3390/su10030845},
Article-Number = {845},
ISSN = {2071-1050},
Keywords = {Life Cycle Assessment; Social Life Cycle Analysis; reinforced concrete;
