EISSN = {2071-1050},
Keywords = {timber building; life cycle assessment; carbon storage; greenhouse gas
   reduction; sustainable neighborhoods; sustainable site development},
Keywords-Plus = {TIMBER BUILDINGS; CITIES},
Research-Areas = {Science \& Technology - Other Topics; Environmental Sciences \& Ecology},
Web-of-Science-Categories  = {Green \& Sustainable Science \& Technology; Environmental Sciences;
   Environmental Studies},
