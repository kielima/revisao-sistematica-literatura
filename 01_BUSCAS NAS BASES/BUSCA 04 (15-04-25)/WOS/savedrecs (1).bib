@article{ WOS:000339533000028,
Author = {Wu, Peng and Xia, Bo and Zhao, Xianbo},
Title = {The importance of use and end-of-life phases to the life cycle
   greenhouse gas (GHG) emissions of concrete - A review},
Journal = {RENEWABLE \& SUSTAINABLE ENERGY REVIEWS},
Year = {2014},
Volume = {37},
Pages = {360-369},
Month = {SEP},
Abstract = {Global climate change is one of the most significant environmental
   impacts at the moment. One central issue for the building and
   construction industry to address global climate change is the
   development of credible carbon labelling schemes for building materials.
   Various carbon labelling schemes have been developed for concrete due to
   its high contribution to global greenhouse gas (GHG) emissions. However,
   as most carbon labelling schemes adopt cradle-to-gate as system
   boundary, the credibility of the eco-label information may not be
   satisfactory because recent studies show that the use and end-of-life
   phases can have a significant impact on the life cycle GHG emissions of
   concrete in terms of carbonation, maintenance and rehabilitation, other
   indirect emissions, and recycling activities. A comprehensive review on
   the life cycle assessment of concrete is presented to holistically
   examine the importance of use and end-of-life phases to the life cycle
   GHG quantification of concrete. The recent published 15014067: Carbon
   footprint of products - requirements and guidelines for quantification
   and communication also mandates the use of cradle-to-grave to provide
   publicly available eco-label information when the use and end-of-life
   phases of concrete can be appropriately simulated. With the support of
   Building Information Modelling (BIM) and other simulation technologies,
   the contribution of use and end-of-life phases to the life cycle GHG
   emissions of concrete should not be overlooked in future studies. (C)
   2014 Elsevier Ltd. All rights reserved.},
Type = {Review},
Language = {English},
Affiliation = {Wu, P (Corresponding Author), Cent Queensland Univ, Sch Engn \& Technol, 400 Kent St, Sydney, NSW 2000, Australia.
