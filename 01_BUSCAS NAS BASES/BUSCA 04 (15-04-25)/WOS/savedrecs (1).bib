@inproceedings{ WOS:000724676100175,
Author = {Hoxha, Endrit and Bohne, Rolf Andre and Passer, Alexander},
Editor = {Scartezzini, JL and Smith, B},
Title = {Gap between simplified and detailed calculation of the environmental
   impacts of road mixtures},
Booktitle = {CARBON-NEUTRAL CITIES - ENERGY EFFICIENCY AND RENEWABLES IN THE DIGITAL
   ERA (CISBAT 2021)},
Series = {Journal of Physics Conference Series},
Year = {2021},
Volume = {2042},
Note = {International Hybrid Conference on Carbon Neutral Cities - Energy
   Efficiency and Renewables in the Digital Era (CISBAT), Ecole
   Polytechnique Fed Lausanne, Solar Energy \& Bldg Phys Lab, Lausanne,
   SWITZERLAND, SEP 08-10, 2021},
Abstract = {In order to reach the COP21 objectives, solutions with low carbon
   contents must be used in road projects. However, the identification of
   the best materials to be implemented in the wearing course of roads is a
   daily problem faced by stakeholders. To overcome this knowledge gap, the
   present study demonstrates the environmental impacts of 120 mixtures
   calculated with simplified and detailed hypotheses and input data. Even
   though the variability of inputs significantly influences the impacts of
   the mixtures and do not allow for the identification of the best
   solutions, on average, warm mix asphalt presented lower impacts than hot
   mix asphalt or concrete.},
