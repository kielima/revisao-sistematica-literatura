@article{ WOS:000251656500003,
Author = {Capello, Christian and Hellweg, Stefanie and Badertscher, Beat and
   Betschart, Hugo and Hungerbuehler, Konrad},
Title = {Part 1:: The ecosolvent tool -: Environmental assessment of
   waste-solvent treatment options},
Journal = {JOURNAL OF INDUSTRIAL ECOLOGY},
Year = {2007},
Volume = {11},
Number = {4},
Pages = {26-38},
Month = {FAL},
Abstract = {The software tool ecosolvent is presented that allows for comparative
   environmental assessment of treatment technologies for specific,
   user-defined, waste-solvent mixtures. The tool is composed of models for
   waste-solvent distillation as well as for thermal treatment in hazardous
   waste-solvent incinerators and cement kilns. It was designed with a
   tiered structure in order to allow for a high flexibility regarding
   informational needs. The life-cycle assessment method was used to assess
   the environmental impact. The applicability of the tool is shown with
   two case studies from industry. In these case studies, various
   waste-solvent treatment technologies are compared for two specific
   waste-solvent mixtures. Potential use of the ecosolvent tool for its
   role in practical decision making in chemicals industries is illustrated
   by two case studies of waste-solvent systems. In the ethyl acetate case
   study, the tool indicates that solvent recovery by distillation is
   clearly better than incineration of the waste solvent. The results from
   the methanol case study are less clear-cut. In the subsequent article
   (part 11), the ecosolvent tool will be used to derive general rules of
   thumb and specific recommendations for 45 important solvents used in
   chemical industries. Additionally, a framework will be presented that
   provides quick and easy decision support regarding environmentally
   optimized waste-solvent management.},
Type = {Article},
Language = {English},
Affiliation = {Capello, C (Corresponding Author), ETH, Safety \& Environm Technol Grp, Wolfgang Pauli Str 10,HCI, CH-8093 Zurich, Switzerland.
   Capello, Christian; Hellweg, Stefanie; Hungerbuehler, Konrad, ETH, Safety \& Environm Technol Grp, CH-8093 Zurich, Switzerland.
   Badertscher, Beat; Betschart, Hugo, Ciba Specialty Chem AG, Zurich, Switzerland.},
DOI = {10.1162/jiec.2007.1231},
ISSN = {1088-1980},
EISSN = {1530-9290},
Keywords = {cement kiln; distillation; hazardous waste-solvent incinerator;
   industrial ecology; life-cycle inventory (LCI); stochastic modeling},
Keywords-Plus = {LIFE-CYCLE INVENTORY; MANAGEMENT},
