@ARTICLE{Munir2024,
	author = {Munir, Qaisar and Lahtela, Ville and Kärki, Timo and Koivula, Aki},
	title = {Assessing life cycle sustainability: A comprehensive review of concrete produced from construction waste fine fractions},
	year = {2024},
	journal = {Journal of Environmental Management},
	volume = {366},
	doi = {10.1016/j.jenvman.2024.121734},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198007648&doi=10.1016%2fj.jenvman.2024.121734&partnerID=40&md5=cef161db7cd4e843f2ee14238d4b345c},
	abstract = {This paper presents an overview of the scholarly works employing the life cycle assessment (LCA) approach to evaluate the environmental impact of construction and demolition waste (CDW) fine fractions derived from concrete elements throughout their life cycle. Unlike conventional studies, this work addresses the challenge of reducing the carbon footprint associated with CDW-based building materials, emphasizing environmental impact mitigation. The study highlights that approximately 30% of CDW is landfilled, 50% is recycled, and 20% is used as fill material, underscoring the potential for increasing recycling rates through improved processing techniques and management practices. In the reviewed studies, most research has been conducted in Europe, Asia, the USA, and China. The primary and secondary data sources for the life cycle inventory (LCI) vary depending on the study region and locality. By exploring innovative practices and critical stages in CDW fine fractions utilization for concrete components, the study aims to contribute to greener construction practices and sustainable resource management. The distinctive aspect of this research lies in its comprehensive review of CDW-based aggregates, binders, and alternative cementitious materials, highlighting the significance of sustainable energy resources and transportation strategies in enhancing the sustainability of CDW-derived concrete. Key findings highlight the necessity of sustainable energy for pretreatment and optimized transportation strategies, including route planning and vehicle selection, to produce greener CDW fine fraction-based building materials. Additionally, the study suggests key steps and parameters required for defining the system boundary and preparing the inventory for conducting an LCA of building materials based on CDW fine fractions. Through a detailed analysis of environmental burdens at each production stage, this study seeks to promote the adoption of greener concrete solutions worldwide. The use of CDW in concrete production promotes environmental sustainability and greener concrete regardless of the region. © 2024 The Authors},
	author_keywords = {Alternative cementitious materials; Environmental impact; Geopolymer binder; Greener construction practices; Recycled aggregates; Sustainable resource management},
	keywords = {Conservation of Natural Resources; Construction Materials; Recycling; Waste Management; Carbon footprint; Concrete aggregates; Demolition; Energy conservation; Environmental impact; Materials handling; Recycling; Resource allocation; Sustainable development; Transportation routes; Waste management; concrete; Alternative cementitious material; Cementitious materials; Construction and demolition waste; Construction practice; Fine fraction; Geopolymer binders; Green construction practice; Green constructions; Recycled aggregates; Sustainable resources managements; assessment method; environmental impact; industrial waste; instrumentation; life cycle analysis; sustainability; building material; carbon footprint; construction and demolition waste; controlled study; energy resource; environmental impact; environmental mitigation; environmental sustainability; human; life cycle; life cycle assessment; recycling; review; traffic and transport; building material; environmental protection; procedures; recycling; waste management; Life cycle},
	correspondence_address = {Q. Munir; Fiber Composite Laboratory, LUT School of Energy Systems, Lappeenranta-Lahti University of Technology, Lappeenranta, 53850, Finland; email: qaisar.munir@lut.fi},
	language = {English},
