}

@ARTICLE{Speroni2023,
	author = {Speroni, Alberto and Cavaglià, Matteo and Mainini, Andrea Giovanni and Casarini, Valentina and Bovi, Simona and Blanco Cadena, Juan Diego and Pittau, Francesco and Poli, Tiziana},
	title = {Parametric Assessment to Evaluate and Compare the Carbon Footprint of Diverse Manufacturing Processes for Building Complex Surfaces},
	year = {2023},
	journal = {Buildings},
	volume = {13},
	number = {12},
	doi = {10.3390/buildings13122989},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85180693265&doi=10.3390%2fbuildings13122989&partnerID=40&md5=b07240800c03c153a3ceafd966d09215},
	abstract = {At present, building design is faced with a need to properly manage complex geometries and surfaces. This fact is not only driven by the increased demand for visually stunning spaces but also stems from the rise of new design paradigms, such as “user-centred design”, that include bespoke optimization approaches. Nevertheless, the escalating adoption of customized components and one-off solutions raises valid concerns regarding the optimal use of energy and resources in this production paradigm. This study focuses on the Life Cycle Assessment of a novel Cement–Textile Composite (CTC) patented material. It combines a synthetic reinforcing textile with a customized concrete matrix, to generate rigid elements that are able to statically preserve complex spatial arrangements, particularly double-curvature surfaces. Moreover, the CTC offers a low-volume cost-effective alternative for custom-made cladding applications. The study performed a comparative carbon footprint assessment of the CTC production process in contrast to other technologies, such as CNC milling and 3D printing. To facilitate meaningful comparisons among diverse construction alternatives and to derive generalized data capable of characterizing their overall capacity, independent of specific production configurations, the present study implemented a generalized parametric shape of reference defined as a bounding box (BBOX), which encloses the volume of the target shape. Comparing different production technologies of the same shape with the same BBOX results in a significant carbon saving, up to 9/10th of the carbon footprint, when the CTC technology is adopted. The study therefore highlights the potential environmental advantages of CTC in the fields of architectural design and building engineering. © 2023 by the authors.},
	author_keywords = {complex geometries; concrete-based composite; customized designs; environmental impact; LCA; low-carbon technology; parametric optimization},
	keywords = {3D printing; Architectural design; Concretes; Cost effectiveness; Data visualization; Ecodesign; Environmental impact; Geometry; Life cycle; Textiles; Building complexes; Complex geometries; Complex surface; Concrete-based composite; Customized design; LCA; Low-carbon technologies; Manufacturing process; Parametric optimization; Textile composite; Carbon footprint},
	correspondence_address = {A.G. Mainini; Department of Architecture, Built Environment and Construction Engineering, Politecnico di Milano, Milan, Via Ponzio 31, 20133, Italy; email: andreagiovanni.mainini@polimi.it},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access, Gold Open Access, Green Open Access}
}

