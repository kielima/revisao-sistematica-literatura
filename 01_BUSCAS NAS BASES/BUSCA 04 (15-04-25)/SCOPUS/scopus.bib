@ARTICLE{Dias2024,
	author = {Dias, Luis C. and Caldeira, Carla and Sala, Serenella},
	title = {Multiple criteria decision analysis to support the design of safe and sustainable chemicals and materials},
	year = {2024},
	journal = {Science of the Total Environment},
	volume = {916},
	doi = {10.1016/j.scitotenv.2023.169599},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184833265&doi=10.1016%2fj.scitotenv.2023.169599&partnerID=40&md5=eda0344ee06607f1299b594ba050209e},
	abstract = {The development of safe and sustainable chemicals and materials is essential to achieve the Zero-Pollution Ambition for a Toxic Free Environment stated in the EU Green Deal. For that, criteria need to be defined and considered since early stage of development. A Safe and Sustainable by Design (SSbD) framework is proposed in an EU Recommendation suggesting the assessment of multiple safety and sustainability aspects of chemicals and materials leaving open how the evaluation and selection of the preferable option should be done. This paper presents a proposal with different options for the use of multiattribute aggregation in an evaluation procedure for the SSbD assessment of chemicals and materials. This proposal is based on i) a review of the literature focusing on Multi-Criteria Decision Analysis (MCDA) application in the SSbD context (i.e. applications considering simultaneously safety and sustainability attributes) and ii) the definition of requisites for MCDA to be applied to the SSBD framework. In the latter, an absolute rather than a relative assessment is preferred as it should be possible for an organization developing a new chemical or material to assess if it is SSbD, without needing to obtain data on all of its possible competitors. Moreover, rank-reversals caused by the introduction of other options are avoided, i.e., assessments of one alternative that depends on other alternatives being assessed simultaneously are not the most adequate. Different options for the aggregation of attributes at different levels are discussed as well as for the consideration of data quality in the evaluation procedure. Regardless the approach selected, the use of multiattribute aggregation does not rule out a richer dashboard presenting not only the overall aggregate result, but also the results obtained in other levels of the hierarchy. Such complementary information is important to understand the strengths and weaknesses that an aggregate result might hide. © 2024 The Authors},
	author_keywords = {Chemicals; Decision support; Life cycle assessment; Materials; Multicriteria assessment; Safety; Sustainability},
	keywords = {Aggregates; Decision making; Decision support systems; Decision theory; Petroleum reservoir evaluation; Quality control; Sustainable development; 4 (2 methoxyethyl)phenol; alcohol; amine; biodiesel; carbon dioxide; carbon nanofiber; carbonic acid; cement; chemical compound; dimethyl carbonate; electrolyte; ethylene; hydrogen; magnesium chloride; methacrylic acid methyl ester; methanol; organophosphate; palm oil; phenol; phosphoric acid; polymer; propylene; rubber; solvent; succinic acid; triisobutylphosphate; unclassified drug; Decision supports; Design assessments; Design context; Design frameworks; Life cycle assessment; Multi-attributes; Multi-criteria assessment; Multi-criteria decision analysis; Multiple criteria decision analysis; Rank reversals; decision analysis; decision support system; European Union; life cycle analysis; multicriteria analysis; safety; sustainability; alkalinity; Article; carbon capture; catalyst; data analysis; data quality; design; environmental sustainability; human; life cycle stage; membrane; microbial fuel cell; multicriteria decision analysis; nonhuman; safety; transesterification; article; decision support system; diagnosis; life cycle assessment; Life cycle},
	correspondence_address = {S. Sala; European Commission, Joint Research Centre, Ispra, Via Enrico Fermi 2749, Italy; email: serenella.sala@ec.europa.eu},
	language = {English},
