}

@ARTICLE{Zhao2024,
	author = {Zhao, Li and Guo, Cheng and Chen, Leduan and Qiu, Liping and Wu, Weiwei and Wang, Qingqin},
	title = {Using BIM and LCA to Calculate the Life Cycle Carbon Emissions of Inpatient Building: A Case Study in China},
	year = {2024},
