@ARTICLE{Mani2025,
	author = {Mani, Saba and Hosseini, M.Reza and Karunsena, Gayani and Kocaturk, Tuba},
	title = {Inconsistencies revealed: A critical analysis of circular economy assessment methods for buildings},
	year = {2025},
	journal = {Resources, Conservation and Recycling},
	volume = {218},
	doi = {10.1016/j.resconrec.2025.108203},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85219153926&doi=10.1016%2fj.resconrec.2025.108203&partnerID=40&md5=e64accc9de889672a6bc063ca3ee1d36},
	abstract = {A wide range of metrics and assessment methods have been proposed to quantify the performance of buildings concerning their alignment with CE principles. This study is one of the first to undertake a comprehensive review of noteworthy metrics through a quantitative analysis. It subsequently conducts a comparative assessment among three of the most prominent metrics, utilizing a defined scenario for a case project, with the aim of uncovering variations and inconsistencies, if any. The findings reveal a marked diversity and inconsistency among major assessment methods. That is, a simple scenario assessed by these methods — which are treated as the most reliable and widely used in the domain — can result in significantly disparate outcomes, leading to confusion among practitioners. This study makes a valuable contribution to the field by providing concrete data and tangible evidence that bring to light the existing incongruities among prevalent assessment methods. © 2025 The Author(s)},
