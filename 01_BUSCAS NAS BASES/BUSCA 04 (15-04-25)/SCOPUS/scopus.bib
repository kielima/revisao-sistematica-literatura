@ARTICLE{Engelfried2025,
	author = {Engelfried, Tabea and Cucurachi, Stefano and Lavidas, George},
	title = {Life cycle assessment of a point absorber wave energy converter},
	year = {2025},
	journal = {Cleaner Environmental Systems},
	volume = {16},
	doi = {10.1016/j.cesys.2025.100265},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218950397&doi=10.1016%2fj.cesys.2025.100265&partnerID=40&md5=f413a98fe4bab3e1704cf3ec3ffafb98},
	abstract = {Harnessing wave energy from the oceans using wave energy converters (WECs) offers a huge opportunity to diversify Europe's future renewable energy system. Although the energy conversion of this pre-commercial technology is not directly linked to greenhouse gas emissions, environmental sustainability over the full life cycle needs to be ensured for a future-proof large-scale application of WECs. Therefore, we present a cradle-to-grave full life cycle assessment (LCA) study for a generic point absorber WEC based on a fully transparent and adaptable life cycle inventory. Within the study we assess the environmental impacts of a single point absorber device, the influence of different hull materials, hotspots in the impacts of WEC components, and variations induced by different deployment locations. For a WEC deployed in the North Sea, we found a global warming impact of 300-325gCO2eq./kWh with periphery and 52-77gCO2eq./kWh without periphery, depending on the hull material. Using an alternative fibre-reinforced concrete material for the hull can reduce the impact across all categories by between 10% (marine eutrophication) and 78% (human toxicity, carcinogenic). In addition to the WEC itself we found that the electrical cable and vessel operations, particularly for maintenance, are significant contributors. These two elements will also be relevant to other marine renewables such as offshore wind and floating solar. Overall, this study shows potential for improving environmental impacts from WECs and identifies possible levers to achieve such a reduction. © 2025 The Authors},
	author_keywords = {Life cycle assessment; Life cycle inventory; Point absorber; Renewable energy; Wave energy converter},
	keywords = {Eutrophication; Fiber reinforced concrete; Wave energy conversion; Wave power; Commercial technology; Energy systems; Greenhouse gas emissions; Hull materials; Life Cycle Inventory; Point absorber; Renewable energies; Wave energy; Wave energy converters; Clean energy},
	correspondence_address = {T. Engelfried; Faculty of Civil Engineering and Geosciences, Delft University of Technology, Delft, Stevinweg, 1, CN, 2628, Netherlands; email: t.d.engelfried@tudelft.nl},
