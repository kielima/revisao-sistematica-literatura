@ARTICLE{Piccardo2024,
	author = {Piccardo, Chiara and Steinik, Camille and Caffè, Simone and Argentoni, Alessio and Calderini, Chiara},
	title = {Primary Energy and Carbon Impacts of Structural Frames with Equivalent Design Criteria: Influence of Different Materials and Levels of Prefabrication},
	year = {2024},
