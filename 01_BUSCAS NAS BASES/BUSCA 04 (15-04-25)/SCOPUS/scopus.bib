@ARTICLE{Siva Rama Krishna2025251,
	author = {Siva Rama Krishna, Uppuluri and Badiger, Mohan and Chaudhary, Yatin and Vijaya Gowri, Turumella and Jahnavi Devi, Esamsetti},
	title = {Optimizing roads for sustainability: Inverted pavement design with life cycle cost analysis and carbon footprint estimation},
	year = {2025},
	journal = {International Journal of Transportation Science and Technology},
