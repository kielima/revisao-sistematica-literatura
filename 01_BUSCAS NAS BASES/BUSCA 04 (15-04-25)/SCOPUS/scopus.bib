}

@ARTICLE{Al-Omari20231646,
	author = {Al-Omari, Omar and Alkhdor, Ahmad and Al-Rawashdeh, M. Abed and Al-Ruwaishedi, M.R. and Al-Rawashdeh, S.B.},
	title = {Evaluating Carbon Footprint in the Life Cycle Design of Residential Concrete Structures in Jordan},
