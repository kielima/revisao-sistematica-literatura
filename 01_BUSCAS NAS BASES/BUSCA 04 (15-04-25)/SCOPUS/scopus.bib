	keywords = {Anaerobic digestion; Effluent treatment; Exhaust gases; Fly ash; Hydraulic laboratories; Land fill; Materials testing laboratories; Plastic parts; Plastics fillers; Process heat reactors; Research laboratories; Television studios; Textile chemical treatment; Waste heat; Wind tunnels; Chemical treatments; Damage; Environmental benefits; Healthcare wastes; Landfilling; LCA; Medical wastes; Scenario; Thermal; Waste valorizations; environmental impact; health care; life cycle analysis; plastic waste; recycling; solid waste; textile industry; Plastic recycling},
