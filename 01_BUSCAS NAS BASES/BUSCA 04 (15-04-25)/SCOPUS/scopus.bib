@ARTICLE{da Gloria2024,
	author = {da Gloria, M’hamed Y. R. and Caldas, Lucas R. and Barros, Joaquim A. O. and Toledo Filho, Romildo D.},
	title = {A Comprehensive Approach for Designing Low Carbon Wood Bio-Concretes},
	year = {2024},
	journal = {Materials},
	volume = {17},
	number = {11},
	doi = {10.3390/ma17112742},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195832217&doi=10.3390%2fma17112742&partnerID=40&md5=e7ff0a35b4579afe0cf61d6dd9923982},
	abstract = {This paper presents a method for designing low carbon bio-based building materials, also named bio-concretes, produced with wood wastes in shavings form (WS) and cementitious pastes. As the aggregates phase of bio-concretes is composed of plant-based particles, known as porous and high water-absorbing materials, the bio-concretes cannot be designed by using the traditional design rules used for conventional mortar or concrete. Then, the method used in the current paper is an adaptation of a previous one that has been developed in a recent paper where bio-concretes were produced with a cement matrix, three types of bio-aggregates, and a proposal of a design abacus. However, when that abacus is used for designing WBC with low cement content in the matrix, the target compressive strength is not reached. In the present paper, the method is extended to low cement content matrix (up to 70% of cement substitution) and also considering the greenhouse gas (GHG) emission of the WBC. To obtain data for proposing a new design abacus, an experimental program was carried out by producing nine workable WBCs, varying wood volumetric fractions (40–45–50%), and water-to-binder ratios. The bio-concretes produced presented adequate consistency, lightness (density between 715 and 1207 kg/m3), and compressive strength ranging from 0.64 to 12.27 MPa. In addition, the GHG emissions of the WBC were analysed through the Life Cycle Assessment methodology. From the relationships obtained between density, compressive strength, water-to-binder ratio, cement consumption, and GHG emissions of the WBC, calibration constants were proposed for developing the updated and more complete abacus regarding an integrated mix design methodology. © 2024 by the authors.},
	author_keywords = {bio-based building materials; GHG emissions; mix design; supplementary cementitious materials; wood bio-concretes},
	keywords = {Aggregates; Carbon; Cements; Concretes; Design; Greenhouse gases; Life cycle; Wood; Bio concretes; Bio-based; Bio-based building material; Buildings materials; Cement content; Greenhouse gas emissions; Low carbon; Mix designs; Supplementary cementitious material; Wood bio-concrete; Compressive strength},
