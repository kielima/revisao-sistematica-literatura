	author = {Yao, Ziqi and Luo, Ling and Qin, Yongjun and Bi, Yu and Liu, Fengchao and Yang, Yiheng},
	title = {Influence of Accelerated Carbonation on the Performance of Recycled Concrete Containing Fly Ash, Recycled Coarse Aggregate, and Fine Aggregate},
	year = {2024},
	journal = {Materials},
	volume = {17},
	number = {21},
	doi = {10.3390/ma17215191},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208565352&doi=10.3390%2fma17215191&partnerID=40&md5=6ac4bb6d34641a6ac8cff3cbbe4bb3d0},
	abstract = {In order to improve the quality of solid waste utilization, this study simultaneously used recycled coarse aggregate and recycled fine aggregate to prepare recycled aggregate concrete, with fly ash partially replacing cement as a binder. After the particle gradation of recycled aggregate was artificially adjusted into continuous gradation, the effects of accelerated carbonation on the performance and microstructure of recycled concrete were studied. The microstructural change was analyzed using mercury intrusion porosimetry and scanning electron microscopy–energy dispersive spectroscopy. Additionally, the environmental benefits of the recycled concrete were evaluated based on carbon emissions using the life cycle assessment method. The experimental results indicate that accelerated carbonation can increase the compressive strength of recycled concrete by up to 13%, and its microstructure becomes more compact after carbonation. The carbon emissions are reduced by more than 13% after using 20% fly ash, contributing to sustainable development. Additionally, the optimal replacement rate of recycled fine aggregate should be controlled to under 15% when both recycled coarse and fine aggregates are used. © 2024 by the authors.},
	author_keywords = {accelerated carbonation; carbon emission; microstructure; recycled coarse aggregate; recycled fine aggregate},
	keywords = {Carbon sequestration; Carbonation; Energy dispersive spectroscopy; Fly ash; Accelerated carbonation; Carbon emissions; Fine aggregates; Microstructural changes; Performance; Recycled aggregate concrete; Recycled aggregates; Recycled coarse aggregate; Recycled concretes; Recycled fine aggregates; Carbon capture and utilization},
	correspondence_address = {L. Luo; College of Civil Engineering and Architecture, Xinjiang University, Urumqi, 830017, China; email: luoling@xju.edu.cn},
	language = {English},
