	title = {Improving the Buildings' Sustainability through Combined Matrix Assessment of Embodied Energy, Water, and Carbon: Case of Conventional Houses, Jammu − India},
	year = {2024},
	journal = {Journal of Sustainable Development of Energy, Water and Environment Systems},
