}

@ARTICLE{Saeed2025620,
	author = {Saeed, Mohamed and Yas, Harith},
	title = {Review of Scoping Studies on Modeling of Concrete Waste},
	year = {2025},
	journal = {Journal of Information Systems Engineering and Management},
	volume = {10},
	number = {17},
