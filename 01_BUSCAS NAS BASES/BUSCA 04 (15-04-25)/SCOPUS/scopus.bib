	journal = {Science of the Total Environment},
	volume = {881},
	doi = {10.1016/j.scitotenv.2023.163488},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85152592672&doi=10.1016%2fj.scitotenv.2023.163488&partnerID=40&md5=e038f4cfd602cc13c1834bdacef5dbd7},
	abstract = {The study aims to conduct a comprehensive life cycle assessment (LCA) of mixed glass waste (MGW) recycling processes to quantify the environmental impacts of crushed glass as a partial substitute for virgin aggregate. Upstream washing, crushing, and sorting conducted at material recycling facilities (MRF) are the prime activities to assess whether reprocessed MGW in pavement construction is an alternate feasible solution. None of the previous studies explicitly account for the relative uncertainties and optimization of waste glass upstream processes from an environmental perspective. The study calculates environmental impacts using the LCA tool SimaPro considering design factors attributed to transportation, electricity consumption, use of chemicals, and water for reprocessing glass waste. Relative uncertainties of design variables and the national transition policy (2021−2030) from non-renewable to renewable energy sources have been validated by performing detailed Monte Carlo simulations. The correlation coefficients (r = 0.64, 0.58, and 0.49) of successive variables explain how the higher environmental gains of the glass recycling process are outweighed by diesel, energy consumption, and transportation distances. Compared to natural quarry sand, the recycled glass aggregate produced through crushing and recycling of its by-products reduces CO2eq emissions by 16.2 % and 46.7 %, respectively. The need for a washing line at the plant, in addition to crushing, results in a higher environmental impact over natural sand by 90.1 % and emphasizes the benefits of collecting waste glass through a separate bin, hence avoiding contamination. The result indicates that the benefit of lowering emissions varies significantly when considering waste glass landfilling. Moreover, this study evaluates the potential impacts on asphalt and reinforced concrete pavements (RCP) with 5 %, 10 %, 15 %, and 20 % replacement of natural sand with recycled glass aggregate. The LCA emphasizes the limitations of energy-intensive waste glass reprocessing. The obtained results and uncertainty analysis based on primary MRF data and recycled product applications provide meaningful suggestions for a more fit-for-purpose waste management and natural resource conservation. © 2023 The Authors},
	author_keywords = {Life cycle assessment (LCA); Materials recycling facility (MRF); Mixed glass waste (MGW); Monte Carlo simulations; Renewable energy; Road pavements},
	keywords = {Conservation; Crushing; Energy utilization; Environmental impact; Glass; Intelligent systems; Monte Carlo methods; Recycling; Reinforced concrete; Renewable energy resources; Uncertainty analysis; asphalt; glass; recycled crushed glass; unclassified drug; Crushed glass; Glass wastes; Life cycle assessment; Material recycling facilities; Material recycling facility; Mixed glass waste; Monte Carlo's simulation; Renewable energies; Road pavements; Waste glass; alternative energy; bedding plane; carbon dioxide; design; environmental assessment; environmental impact assessment; glass; landfill; life cycle analysis; Monte Carlo analysis; natural resource; pavement; pipeline; recycling; resource management; road; road construction; uncertainty analysis; Article; construction and demolition waste; contamination; electricity; energy consumption; environmental evaluation; environmental impact; environmental protection; life cycle assessment; Monte Carlo method; non-renewable resource; particle size; pipeline bedding; procedures; recycling; renewable energy; road pavement; sand; sensitivity analysis; traffic and transport; uncertainty; waste management; Life cycle},
	correspondence_address = {F. Giustozzi; RMIT University, School of Engineering, 124 La Trobe St, 3001, Australia; email: filippo.giustozzi@rmit.edu.au},
