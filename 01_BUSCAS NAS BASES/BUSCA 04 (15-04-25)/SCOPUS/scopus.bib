	author = {Abdelaal, Mohamed A. and Seif, Samer M. and El-Tafesh, Menna M. and Bahnas, Noha and Elserafy, Mohamed M. and Bakhoum, Emad S.},
	title = {Sustainable assessment of concrete structures using BIM–LCA–AHP integrated approach},
