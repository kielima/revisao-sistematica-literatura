@ARTICLE{Backes20247199,
	author = {Backes, Jana Gerta and Traverso, Marzia},
	title = {Social Life Cycle Assessment in the Construction Industry: Systematic Literature Review and Identification of Relevant Social Indicators for Carbon Reinforced Concrete},
	year = {2024},
	journal = {Environment, Development and Sustainability},
