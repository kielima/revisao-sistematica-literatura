@ARTICLE{Asare2024,
	author = {Asare, Gideon Osei and Barnett, Stephanie and Awinda, Kenneth and Martinson, Brett},
	title = {Life cycle assessment of steel fibre-reinforced concrete beams},
	year = {2024},
	journal = {Cogent Engineering},
	volume = {11},
	number = {1},
	doi = {10.1080/23311916.2024.2374942},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198470411&doi=10.1080%2f23311916.2024.2374942&partnerID=40&md5=3ad3a91574908bf0dc92c2fe1b808889},
	abstract = {The use of steel fibres in reinforcing concrete has proven to enhance certain mechanical and durability properties of concrete; however, as a material that presents enhanced properties, its environmental performance should also be analysed. This study aims to quantify the carbon emissions of steel fibre-reinforced concrete beams using a functional unit that considers the mechanical and durability performance of concrete through a whole life cycle assessment methodology that includes the benefits/load after the end-of-life. A cradle-to-grave approach, which considers the end-of-life stage and the benefits/loads beyond the system boundary, was performed to compare the embodied carbon of conventionally reinforced concrete and steel fibre-reinforced concrete beams. The results show that the addition of steel fibres as reinforcing material to concrete can reduce the area of steel required in the tension zone of a conventionally reinforced concrete beam and the embodied carbon of concrete by an average of 33% and 37%, respectively. © 2024 The Author(s). Published by Informa UK Limited, trading as Taylor & Francis Group.},
