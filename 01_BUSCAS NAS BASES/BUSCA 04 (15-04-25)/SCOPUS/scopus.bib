	author = {Suárez Silgado, S.S. and Calderón Valdiviezo, L. and Betancourt Quiroga, C.},
	title = {Life cycle analysis and economic evaluation of cement and concrete mixes with rice husk ash: application to the Colombian context; [Análisis del ciclo de vida y evaluación económica de cemento y mezclas de hormigón con ceniza de cascarilla de arroz: aplicación al contexto colombiano]},
