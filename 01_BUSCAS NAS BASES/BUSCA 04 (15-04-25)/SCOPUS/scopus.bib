	author = {Larasati, Dewi and Aisha, Heidi and Hanifah, Yulita and Triyadi, Sugeng and Suhendri and Primasetra, Anjar},
	title = {Effects of utilizing various types of facade material on the Embodied and operational energy; a case study of apartment building in Indonesia},
	year = {2025},
	journal = {Journal of Asian Architecture and Building Engineering},
