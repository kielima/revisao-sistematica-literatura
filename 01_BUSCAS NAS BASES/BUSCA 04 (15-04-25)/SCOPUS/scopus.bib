@ARTICLE{Martínez-Muñoz2025,
	author = {Martínez-Muñoz, David and Martí, Jose V. and Yepes, Víctor},
	title = {Game-Theory-Based Multi-Objective Optimization for Enhancing Environmental and Social Life Cycle Assessment in Steel–Concrete Composite Bridges},
	year = {2025},
	journal = {Mathematics},
	volume = {13},
	number = {2},
