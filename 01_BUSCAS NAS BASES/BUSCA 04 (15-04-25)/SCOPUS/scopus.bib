@ARTICLE{Lei2024,
	author = {Lei, Bin and Yu, Linjie and Guo, Yipu and Xue, Hongjie and Wang, Xiaonan and Zhang, Yan and Dong, Wenkui and Dehn, Frank and Li, Wengui},
	title = {Triaxial mechanical behaviours and life cycle assessment of sustainable multi-recycled aggregate concrete},
	year = {2024},
	journal = {Science of the Total Environment},
	volume = {923},
	doi = {10.1016/j.scitotenv.2024.171381},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186957915&doi=10.1016%2fj.scitotenv.2024.171381&partnerID=40&md5=69ed5c1378ed6e71c0ee62e83ca448bc},
	abstract = {Multi-recycling of concrete waste presents a promising avenue for carbon-negative development and a circular economy. This study comprehensively assesses the triaxial mechanical performance and environmental impact of multi-recycled concrete (Multi-RAC) through three recycling cycles. The results reveal a triaxial failure mode similar to natural aggregate concrete (NAC). The peak stress and peak strain monotonically increase with confinement stress, showing a significant impact (enlarged by 171.4 % to 280.6 % and 397.4 % to 412.0 %, respectively) from 0 to 20 MPa. All P-values for recycling cycles and confining pressure are less than 0.05, with the confining pressure having a more significant effect. Three best-fit multivariate mixed models predict mechanical properties, and a modified elastoplastic model introduces the recycling cycles factor. Numerical simulations confirm the model's accuracy in predicting the triaxial mechanical properties of Multi-RAC. Comparative analysis reveals that the elastoplastic model-derived non-integral high order failure criterion outperforms the Willam-Warnke failure criterion and other conventional criteria. Regarding environmental impact, all indicators (GWP, POCP, AP, EP, and CED) decrease favourably with the increasing number of recycling cycles, with CED and EP playing the most significant roles. Compared to NAC, the five environmentally favorable indicators for RACIII decrease by 3.24 % to 50.6 %, respectively. These findings provide valuable insights for future research on developing eco-friendlier Multi-RAC for sustainable and green infrastructure. © 2024 The Authors},
	author_keywords = {Elastoplastic model; Failure criteria; Life cycle assessment; Multi-recycled aggregate concrete; Triaxial behaviour},
	keywords = {Concrete aggregates; Elastoplasticity; Environmental impact; Failure (mechanical); Recycling; Rock pressure; Sustainable development; calcium hydroxide; carbon; cement; concrete; Aggregate concrete; Confining pressures; Elasto-plastic models; Failure criteria; Life cycle assessment; Multi-recycled aggregate concrete; Natural aggregate; Recycled aggregate concrete; Recycling cycle; Triaxial behavior; aggregate; concrete; elastoplasticity; failure analysis; life cycle analysis; recycling; triaxial test; acidification potential; article; Article; basalt; biomechanics; compressive strength; elasticity; environmental impact; eutrophication Potential; finite element analysis; landfill; life cycle; life cycle assessment; mortality; municipal solid waste; nonhuman; pharmaceutics; photochemical ozone creation potential; photosynthesis; recycling; scientific literature; seasonal variation; shear stress; simulation; support vector machine; tablet disintegration; tensile strength; Young modulus; controlled study; female; male; recycling; Life cycle},
	correspondence_address = {Y. Guo; Centre for Infrastructure Engineering and Safety, School of Civil and Environmental Engineering, The University of New South Wales, 2052, Australia; email: yipu.guo-1@uts.edu.au},
