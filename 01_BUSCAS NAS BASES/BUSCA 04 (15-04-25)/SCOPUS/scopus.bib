@ARTICLE{Jin2025,
	author = {Jin, Willy and Caron, Jean-François and Ouellet-Plamondon, Claudiane M.},
	title = {Minimizing the carbon footprint of 3D printing concrete: Leveraging parametric LCA and neural networks through multiobjective optimization},
	year = {2025},
	journal = {Cement and Concrete Composites},
	volume = {157},
	doi = {10.1016/j.cemconcomp.2024.105853},
