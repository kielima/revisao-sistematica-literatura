@ARTICLE{Kolendo2024,
	author = {Kolendo, Girts and Voronova, Viktoria and Bumanis, Girts and Korjakins, Aleksandrs and Bajare, Diana},
	title = {Life Cycle Assessment of End-of-Life Tire Disposal Methods and Potential Integration of Recycled Crumb Rubber in Cement Composites},
