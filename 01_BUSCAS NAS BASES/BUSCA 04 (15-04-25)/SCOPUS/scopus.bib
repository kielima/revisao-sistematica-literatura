	title = {Research on Fresh and Hardened Concrete Residences with Partial Replacement of Recycled Coarse Aggregates Obtained from Demolition and Construction Waste},
	year = {2024},
	journal = {International Journal of Experimental Research and Review},
	volume = {42},
