	keywords = {Direct air capture; Kyoto Protocol; Low emission; CO 2 emission; CO2 emission reduction; Configuration system; Configurator; Digital tools; Emission reduction; Environmental product declaration; Environmental product declarations; Life cycle assessment; Life cycle assessment configurator; Greenhouse gas emissions},
