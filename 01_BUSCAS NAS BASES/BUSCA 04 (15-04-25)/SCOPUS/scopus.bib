@ARTICLE{Mostafaei2025,
	author = {Mostafaei, Hasan and Chamasemani, Niyousha Fallah and Mashayekhi, Mohammadreza and Hamzehkolaei, Naser Safaeian and Santos, Paulo},
	title = {Sustainability Enhancement and Evaluation of a Concrete Dam Using Recycling},
	year = {2025},
