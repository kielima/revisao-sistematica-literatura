	author = {Neimark, Benjamin and Belcher, Oliver and Ashworth, Kirsti and Larbi, Reuben},
	title = {Concrete Impacts: Blast Walls, Wartime Emissions, and the US Occupation of Iraq},
	year = {2024},
	journal = {Antipode},
	volume = {56},
	number = {3},
	pages = {983 – 1005},
	doi = {10.1111/anti.13006},
