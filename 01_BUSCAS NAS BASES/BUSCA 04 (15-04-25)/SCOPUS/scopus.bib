@ARTICLE{Ali2025,
	author = {Ali, N. and Soliman, A.M.},
	title = {Single and multi-response optimization of retarded admixture on alkali activated slag rheological behavior by the taguchi method},
	year = {2025},
	journal = {Construction and Building Materials},
	volume = {459},
	doi = {10.1016/j.conbuildmat.2024.139812},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213885292&doi=10.1016%2fj.conbuildmat.2024.139812&partnerID=40&md5=936af20c80cda6c55759debef66e2ff5},
	abstract = {The rheological behaviour of alkali-activated materials reflects their flowability and setting characteristics. Incorporating retarders has proven effective in improving flowability and extending the setting time without compromising hardened properties. In this study, single- and multi-response optimization for the type and dosages of various retarders added to one-part alkali-activated slag paste is done using the Taguchi method. The initial flow, rheological parameters (yield stress and plastic viscosity), time of the second heat of hydration peak (marking the end of the dormant period and the start of the acceleration phase in the hydration process), and compressive strength at 3, 7, and 28 days were selected as evaluation criteria. Statistical models were developed for mixes with water-to-solid ratios (w/s) of 0.4–0.55, activator dosages of 4–10 % of the slag weight, and retarder dosages of 0–1.5 % of the slag weight. Multivariable regression models were used to predict performance, and variance analysis was performed to identify the dominant levels of each variable. Moreover, the life cycle assessment for the optimized mixes was studied. Results show that w/s ratio and activator dosage are the most significant factors influencing rheological behaviour. Among the retarders tested, nano zinc and borax were the most effective, enhancing flowability without reducing compressive strength, suggesting a broader use of retarders in one-part alkali-activated slag systems. © 2024 The Authors},
	author_keywords = {GRA; Mix proportion; Multi-objective optimization; One-part alkali activated slag; Rheology; Workability},
	keywords = {Brinell Hardness; Compressive strength; Nanoclay; Regression analysis; Slags; Yield stress; Alkali activated slags; Flowability; GRA; Mix proportions; Multi-objectives optimization; Multiresponses optimization; One parts; One-part alkali activated slag; Rheological behaviour; Workability; Taguchi methods},
