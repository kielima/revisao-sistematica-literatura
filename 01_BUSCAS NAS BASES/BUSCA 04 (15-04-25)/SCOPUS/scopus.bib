	keywords = {Carbon; Concretes; Construction industry; Environmental management; Life cycle; Building envelopes; Carbon reduction; Energy  savings; Energy saving and carbon reduction; Energy-consumption; Energy-savings; Environmental performance; Modular integrated construction; Modulars; Operational phasis; Energy utilization},
