@ARTICLE{Albuquerque Filho2024,
	author = {Albuquerque Filho, Luiz Heleno and Casagrande, Michéle Dal Toé and Almeida, Mario Sergio de Souza and Costa, Weiner Gustavo Silva and Santana, Paulo Ricardo Lemos de},
	title = {Mechanical Performance and Life Cycle Assessment of Soil Stabilization Solutions for Unpaved Roads from Northeast Brazil},
	year = {2024},
	journal = {Sustainability (Switzerland)},
	volume = {16},
	number = {22},
