@ARTICLE{Jiang2025,
	author = {Jiang, Zhilu and Lu, Kuan and Limdevit, Mok and Fu, Chuanqing and Ling, Yifeng and Dong, Biqin},
	title = {Influence of durability properties on life-cycle carbon reduction of low-carbon mortar with similar compressive strength},
	year = {2025},
	journal = {Case Studies in Construction Materials},
	volume = {22},
	doi = {10.1016/j.cscm.2025.e04558},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000747909&doi=10.1016%2fj.cscm.2025.e04558&partnerID=40&md5=bf459a00553823066f8e8a4278216000},
	abstract = {The imperative for carbon reduction in the construction industry is gaining momentum. A pivotal strategy in this endeavor is the adoption of low-carbon cementitious materials and the enhancement of concrete structures' service life. The chloride-induced corrosion and water ingress in reinforced concrete is a pervasive issue, often resulting in premature structural failure and substantial economic loss. This study focuses on four low-carbon cementitious materials: calcium sulphoaluminate cement (CSA), CO2 cured calcium sulphoaluminate cement (CSA-C), alkali-activated slag (AAS), and limestone calcined clay cement (LC3). Different types of low-carbon mortars with similar compressive strength were used for mercury intrusion porosimetry, hydration phase analysis, chloride ion diffusion, and water permeability tests. The results reveal that AAS and LC3 possess superior or similar chloride diffusion and water permeation resistance compared with Portland cement (PC) mortar. Life cycle assessment (LCA) and carbon emission analyses show that AAS and LC3 produce markedly lower carbon emissions during production compared to PC. The expected repair time from the chloride ion diffusivity and water permeability suggests that LC3 and AAS have extended repair time and reduced annual carbon emissions, underscoring their viability as PC alternatives. It is highlighted that the annual carbonation emissions taking concrete durability into consideration is a more appropriate index for assessing the environmental performance of low-carbon cementitious materials, rather than the total carbon emissions. © 2025 The Authors},
	author_keywords = {Annual carbon emissions; Life cycle assessment; Predicted lifespan; Transport properties},
	keywords = {Carbon sequestration; Mortar; Portland cement; Slags; Zero-carbon; Alkali activated slags; Annual carbon emission; Calcium sulphoaluminate; Carbon emissions; Carbon reduction; Cementitious materials; Lifespans; Low carbon; Predicted lifespan; Property; Carbon capture and utilization},
	correspondence_address = {Z. Jiang; College of Civil Engineering, Zhejiang University of Technology, Hangzhou, 310023, China; email: zljiang@zjut.edu.cn},
