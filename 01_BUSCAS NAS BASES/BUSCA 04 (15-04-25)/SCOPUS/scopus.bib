	title = {Eco-efficient ultra-high-performance concrete formulation utilizing electric arc furnace slag and recycled glass powder–advanced analytics and lifecycle perspectives},
	year = {2024},
	journal = {Journal of Materials Research and Technology},
	volume = {32},
	pages = {362 – 377},
	doi = {10.1016/j.jmrt.2024.07.171},
