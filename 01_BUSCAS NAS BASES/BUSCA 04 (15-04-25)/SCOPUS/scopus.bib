@ARTICLE{Poudel2025,
	author = {Poudel, Sushant and Bhetuwal, Utkarsha and Kharel, Prabin and Khatiwada, Sudip and KC, Diwakar and Dhital, Subash and Lamichhane, Bipin and Yadav, Sachin Kumar and Suman, Saurabh},
	title = {Waste Glass as Partial Cement Replacement in Sustainable Concrete: Mechanical and Fresh Properties Review},
	year = {2025},
	journal = {Buildings},
	volume = {15},
	number = {6},
	doi = {10.3390/buildings15060857},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001116319&doi=10.3390%2fbuildings15060857&partnerID=40&md5=6319fd5f0d3d5c102ac506d3cda0bfa7},
	abstract = {The significant anthropogenic carbon dioxide (CO2) emissions from cement production and the disposal of the majority of post-consumer waste glass into landfill sites have increased environmental pollution. In order to reduce the environmental impact, ground glass pozzolan (GGP) as a partial cement replacement has drawn interest from the concrete industry. This review examines the potential of GGP as a supplementary cementitious material (SCM), exploring the chemical composition of pozzolans, the different types of glass used for GGP, and the impact of glass color on pozzolanic reactivity. In addition, this study gathers the most recent research articles on the fresh and mechanical properties of concrete incorporating GGP. Key findings show that the incorporation of GGP in concrete improves the modulus of elasticity and the compressive, tensile, flexural, and punching strengths due to the pozzolanic reactions. The results indicate that GGP, made from waste glass, has pozzolanic properties that form additional strength-enhancing calcium silicate hydrate (C-S-H) gel and densify the concrete matrix. Additionally, the life cycle assessments of GGP-incorporated concrete demonstrate reductions in energy consumption and CO2 emissions compared to conventional concrete, supporting a circular economy and sustainable construction practices. © 2025 by the authors.},
	author_keywords = {cement replacement; fresh properties; glass powder; mechanical properties; pozzolan; recycling; sustainable concrete; waste glass},
	keywords = {Cement manufacture; Compressive strength; Concrete industry; Environmental impact; Glass industry; Land fill; Silicates; Tensile strength; Cement replacement; CO 2 emission; Concrete mechanical property; Fresh properties; Glass Powder; Ground glass; Mechanical; Property; Sustainable concretes; Waste glass; Pozzolan},
	correspondence_address = {D. KC; Department of Civil and Environmental Engineering, University of Toledo, Toledo, 43606, United States; email: dibakarkc@outlook.com},
	language = {English},
