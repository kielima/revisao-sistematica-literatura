	author = {Shen, Jingchun and Chen, Yang and Rajagopal, Karthik Hejamadi},
	title = {Enhancing Indoor Environmental Quality and Sustainability in Post-Pandemic Office Settings: A Study on Displacement Ventilation Feasibility},
	year = {2023},
	journal = {Buildings},
	volume = {13},
	number = {12},
	doi = {10.3390/buildings13123110},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85180616463&doi=10.3390%2fbuildings13123110&partnerID=40&md5=cbfe06687abf5a73ef349305708af6e9},
	abstract = {The COVID-19 pandemic has catalyzed global efforts toward transitioning to a sustainable society, driving rapid innovation in building technologies, working practices, building design, and whole life cycle environmental impact consideration. In this pursuit, this study explores the enduring impact of these on an alternative ventilation approach for both existing building renovations and new building implementations. Comparing displacement ventilation to mixed-mode ventilation in a Finnish office building with varying occupancy densities, this study examines indoor air quality (IAQ), thermal comfort, total building energy performance, and embodied carbon. The findings reveal that the basic case of mixed ventilation has a specified system primary energy value of 38.83 kWh/m2 (with 28 occupants) and 39.00 kWh/m2 (with 24 occupants), respectively. With the displacement ventilation alternative, it reduces this by 0.3% and 0.1%, enhancing thermal comfort and decreasing turbulence as well as having a marginal decrease in embodied carbon. In general, the study offers three-fold contributions: insights into post-pandemic office mechanical ventilation design with an emphasis on sustainability and ecological footprint considerations, a concrete case study addressing climate action and human-centric IAQ design, and a multifaceted analysis using the Environmental, Social, and Governance (ESG) paradigm, contributing to the groundwork for associated future research and policy progress. © 2023 by the authors.},
	author_keywords = {climate with stratification model; displacement ventilation; ecological footprint; ESG analysis; healthy indoor quality; integrative design process; life cycle assessment; office layout design; post-pandemic scenario},
	keywords = {Air quality; Architectural design; Carbon; Climate models; COVID-19; Environmental technology; Indoor air pollution; Intelligent buildings; Office buildings; Quality control; Structural design; Sustainable development; Thermal comfort; Ventilation; Climate with stratification model; Design-process; Displacement ventilation; Ecological footprint; Environmental, social, and governance analyse; Healthy indoor quality; Integrative design; Integrative design process; Layout designs; Life cycle assessment; Office layout design; Office layouts; Post-pandemic scenario; Life cycle},
	correspondence_address = {J. Shen; Department of Energy, Forest, and Built Environment, Högskolan Dalarna, Borlänge, 781 70, Sweden; email: jih@du.se},
	language = {English},
