	year = {2024},
	journal = {Environmental Science and Technology},
	volume = {58},
	number = {6},
	pages = {2716 – 2727},
	doi = {10.1021/acs.est.3c05191},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184830714&doi=10.1021%2facs.est.3c05191&partnerID=40&md5=21538ac55eef9cc711a18596e9249030},
	abstract = {Plastics are controversial due to their production from fossil fuels, emissions during production and disposal, potential toxicity, and leakage to the environment. In light of these concerns, calls to use less plastic products and move toward nonplastic alternatives are common. However, these calls often overlook the environmental impacts of alternative materials. This article examines the greenhouse gas (GHG) emission impact of plastic products versus their alternatives. We assess 16 applications where plastics are used across five key sectors: packaging, building and construction, automotive, textiles, and consumer durables. These sectors account for about 90% of the global plastic volume. Our results show that in 15 of the 16 applications a plastic product incurs fewer GHG emissions than their alternatives. In these applications, plastic products release 10% to 90% fewer emissions across the product life cycle. Furthermore, in some applications, such as food packaging, no suitable alternatives to plastics exist. These results demonstrate that care must be taken when formulating policies or interventions to reduce plastic use so that we do not inadvertently drive a shift to nonplastic alternatives with higher GHG emissions. For most plastic products, increasing the efficiency of plastic use, extending the lifetime, boosting recycling rates, and improving waste collection would be more effective for reducing emissions. © 2024 The Authors. Published by American Chemical Society.},
	author_keywords = {Climate change; Greenhouse gas emission; Life-cycle assessment; Plastic alternative; Plastic pollution; Plastics},
	keywords = {Greenhouse Gases; Plastics; Recycling; Climate change; Elastomers; Environmental impact; Fossil fuels; Gas emissions; Greenhouse gases; Plastic products; aluminum; concrete; glass fiber; iron; plastic; polyethylene; polyethylene terephthalate; polypropylene; polystyrene; polyvinylchloride; soap; steel; plastic; Alternative materials; Automotive textiles; Building and construction; Emissions' impacts; Fossil fuel emissions; Greenhouse gas emissions; Life-cycle assessment; Nonplastic; Plastic alternative; Plastic pollutions; greenhouse gas; life cycle analysis; plastic; recycling; animal food; Article; building; climate change; construction work; consumer; food packaging; greenhouse gas emission; life cycle assessment; market; milk; product life cycle; product parameters; sensitivity analysis; soft drink; wood; greenhouse gas; recycling; Life cycle},
