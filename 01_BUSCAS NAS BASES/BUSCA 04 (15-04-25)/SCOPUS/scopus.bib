	author = {Armstrong, Kristina O. and Kamath, Dipti and Zhao, Xianhui and Rencheck, Mitchell L. and Tekinalp, Halil and Korey, Matthew and Hun, Diana and Ozcan, Soydan},
	title = {Life cycle cost, energy, and carbon emissions of molds for precast concrete: Exploring the impacts of material choices and additive manufacturing},
	year = {2023},
	journal = {Resources, Conservation and Recycling},
	volume = {197},
	doi = {10.1016/j.resconrec.2023.107117},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165385190&doi=10.1016%2fj.resconrec.2023.107117&partnerID=40&md5=a700abb21d52c051d0a63bbcb37fd1c0},
	abstract = {Molds for precast concrete are commonly used to create simple- to complex-shaped concrete products away from construction sites. These molds are often handmade from wood; however, additively manufacturing (AM, or 3D printing) fiber-reinforced polymer composites is an advantageous alternative, producing significantly more durable, highly complex molds faster, but likely at a higher cost. This study explores the impact of material and production variables on the cost, energy, and carbon emissions of employing composite AM molds over the full lifecycle. The case study employed techno-economic and life cycle assessments to show that using wood flour–poly(lactic acid) or recycled carbon fiber–acrylonitrile butadiene styrene for AM molds can be less expensive than conventional wood molds, especially when considering use phase costs. While wood molds have the least environmental impacts due to wood's higher biogenic carbon sequestration and minimal processing, optimizing AM designs could reduce energy demand, carbon emissions, and cost. © 2023},
	author_keywords = {3D printing; Additive manufacturing; Bio-derived composites; Composite recycling; Precast concrete},
	keywords = {Additives; Carbon fiber reinforced plastics; Carbon fibers; Costs; Environmental impact; Life cycle; Molds; Precast concrete; Recycling; Styrene; 1,3 butadiene; acrylonitrile; carbon fiber; concrete; polylactic acid; styrene; 3-D printing; 3D-printing; Bio-derived composite; Carbon emissions; Composite recycling; Construction sites; Energy emissions; Fiber reinforced polymer composites; Material choice; Simple++; carbon emission; concrete; cost analysis; environmental impact; life cycle analysis; manufacturing; polymer; recycling; reinforced concrete; Article; capital; carbon emission; carbon sequestration; case study; comparative study; controlled study; cost; economics; energy; environmental impact; life cycle; life cycle assessment; manufacturing; mold; nonhuman; printing; prospective study; recycling; wood; 3D printing},
	correspondence_address = {X. Zhao; Oak Ridge National Laboratory, Oak Ridge, 1 Bethel Valley Road, 37831, United States; email: xianhui.zhao@jacks.sdstate.edu},
