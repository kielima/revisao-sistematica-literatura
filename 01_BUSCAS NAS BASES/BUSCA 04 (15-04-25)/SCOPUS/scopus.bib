}

@ARTICLE{Dervishaj2024,
	author = {Dervishaj, Arlind and Malmqvist, Tove and Silfwerbrand, Johan and Gudmundsson, Kjartan},
	title = {A digital workflow for assessing lifespan, carbonation, and embodied carbon of reusing concrete in buildings},
	year = {2024},
	journal = {Journal of Building Engineering},
	volume = {96},
	doi = {10.1016/j.jobe.2024.110536},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202299910&doi=10.1016%2fj.jobe.2024.110536&partnerID=40&md5=8dd482dc88361ad586ed4d1cbf10acd5},
	abstract = {Concrete is the most used construction material, accounting for 8 % of global CO2 emissions. Various strategies aim to reduce concrete's embodied carbon, such as using supplementary cementitious materials, utilizing cleaner energy, and carbonation. However, a large potential lies in reusing concrete for new buildings in a Circular Economy, thereby closing material loops and avoiding CO2 emissions. This study focuses on the reuse of precast concrete elements. We present a digital workflow for assessing reuse by predicting the remaining service life, estimating CO2 uptake by natural carbonation, and calculating the embodied carbon savings of concrete reuse. Both carbonation rates from EN 16757 and our investigation were applied to a case study building. While EN 16757 rates suggest that most precast elements have reached the end of their service life, our assessment shows that these elements have a sufficient lifespan for reuse. Plaster and coverings significantly delay carbonation and extend service life. During the first service life following EN 16757, carbonation was 19,2 kg CO2/m3, whereas our prediction was 5,4 kg CO2/m3. Moreover, CO2 uptake during service life, including reuse, was less than 6 % of the embodied carbon. The climate benefits of reuse greatly exceeded those of carbonation. Furthermore, carbonation did not have a decisive influence when applying Cut-Off, Distributed, and End-of-Life allocations for assessing embodied carbon of re-used elements in subsequent life cycles. The digital workflow is useful in quickly assessing lifespan, carbonation, and embodied carbon of concrete. It can be leveraged as a decision-making tool when designing for reuse. © 2024 The Authors},
	author_keywords = {Carbonation; Circular economy; Concrete; Embodied carbon; Life cycle assessment (LCA); Reuse; Sustainable buildings},
	keywords = {Carbon capture and storage; Carbon sequestration; Circular economy; CO 2 emission; CO 2 uptake; Digital workflows; Embodied carbons; In-buildings; Life cycle assessment; Lifespans; Reuse; Sustainable building; Carbon capture and utilization},
	correspondence_address = {A. Dervishaj; KTH Royal Institute of Technology, Department of Civil and Architectural Engineering, Division of Sustainable Buildings, Stockholm, Brinellvägen 23, SE 100 44, Sweden; email: arlindd@kth.se},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access, Hybrid Gold Open Access}
}

@ARTICLE{Kiesel2024835,
	author = {Kiesel, Adrian and Brandi, Guido and Schlatter, Jael and Gerber, Andri and Langenberg, Silke},
	title = {Structural Reuse of Decommissioned Ski Lift Steel Trusses for Load-Bearing Applications},
	year = {2024},
	journal = {Architecture},
	volume = {4},
	number = {4},
	pages = {835 – 853},
	doi = {10.3390/architecture4040044},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213438862&doi=10.3390%2farchitecture4040044&partnerID=40&md5=6ac328f459d8ce70eda2637b791082d5},
	abstract = {The ongoing effects of climate change have led to a rise in global temperature, significantly reducing snow cover and resulting in the abandonment of numerous ski areas across Switzerland. As a result, many ski lifts have been decommissioned and left to deteriorate due to lenient local regulations. To address this issue, this paper presents a case study approach to repurposing steel trusses from abandoned ski lifts for a new structural application within the building industry. The design, sourcing, and construction of a new load-supporting column are described, focusing on reusing the ski lift steel trusses as a whole, without dismantling them into their components. After collection, these elements are adapted to comply with current building standards. By pouring out the hollow structure with the recently developed building material Cleancrete ©, a new load-bearing structure is developed. A comprehensive life cycle assessment (LCA) demonstrates the environmental performance of the steel–Cleancrete hybrid construction, which achieves a global warming potential (GWP) of 536.58 kg CO2-eq. In comparison, alternative designs using wood and concrete exhibited GWP values of 679.45 kg CO2-eq, +26.6%, and 1593.72 kg CO2-eq, +197.02%, respectively. These findings suggest that repurposing abandoned ski lift structures can significantly contribute to sustainable building practices, waste reduction, and the promotion of circular economy principles. The process outlined in this paper holds potential for future applications, particularly in the reuse of other steel components, ensuring continued circularity even as the supply of ski lift structures may dwindle. © 2024 by the authors.},
	author_keywords = {circular economy; decommissioned ski lifts; load-bearing structures; steel trusses; structural design; structural reuse; sustainable building practices},
	correspondence_address = {A. Kiesel; Institute Constructive Design (IKE), Zurich University of Applied Sciences, Winterthur, 8401, Switzerland; email: adrian.kiesel@zhaw.ch},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access, Gold Open Access}
}

@ARTICLE{Tian2024,
	author = {Tian, Dongyang and Cong, Ming and Xu, Zhen and Xu, Xinrong and Tian, Xianchun and Cong, Xinyu and Lu, Shuang},
	title = {Carbon sequestration and environmental impacts in ternary blended cements using dyeing sludge and papermaking sludge},
