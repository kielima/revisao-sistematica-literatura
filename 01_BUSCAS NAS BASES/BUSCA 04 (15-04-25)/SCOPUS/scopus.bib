@ARTICLE{Amari2024,
	author = {Amari, Samar and Darestani, Mariam and Millar, Graeme J. and Samali, Bijan and Strounina, Ekaterina},
	title = {Engineering and Life Cycle Assessment (LCA) of Sustainable Zeolite-Based Geopolymer Incorporating Blast Furnace Slag},
	year = {2024},
	journal = {Sustainability (Switzerland)},
	volume = {16},
	number = {1},
	doi = {10.3390/su16010440},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85181917167&doi=10.3390%2fsu16010440&partnerID=40&md5=182c3f9e1edc694a15b02906bb3fb0c6},
	abstract = {This study aims to investigate the preparation of zeolite-based geopolymer composites incorporating blast furnace slag at various temperatures and varying amounts of blast furnace slag as potential sustainable building and construction materials. The primary objectives were to use mining waste streams for geopolymer production and assess the mechanical behavior of these hybrid geopolymers, along with performing a life cycle assessment (LCA) to compare their environmental impact with conventional concrete. It was observed that the hybrid geopolymers attained a maximum mechanical strength of 40 MPa. Remarkably, substituting just 20% of the material with blast furnace slag resulted in a 92% improvement in compressive strength. To assess environmental impacts, a cradle-to-gate LCA was performed on different geopolymer mix designs, focusing particularly on the global warming potential (GWP). The results indicated that geopolymer concrete generated a maximum of 240 kg CO2-e/m3, which was 40% lower than the emissions from ordinary cement, highlighting the environmental advantages of geopolymer materials. Further, X-ray diffraction was used to determine the mineral composition of both raw and developed composites. Solid-state nuclear magnetic resonance (NMR) was applied to study the molecular structure changes upon incorporating blast furnace slag. The initial setting time and shrinkage of the geopolymers were also investigated. Morphological characteristics were analyzed by scanning electron microscopy (SEM). Thermal analyses confirmed the stability of the geopolymers up to 800 °C. Geopolymer composites with high thermal stability can be used in construction materials that require fire resistance. This study not only enhances the understanding of geopolymer composite properties but also confirms the substantial environmental advantages of utilizing geopolymerization in sustainable construction. © 2024 by the authors.},
	author_keywords = {construction materials; geopolymer; GHG emissions; life cycle assessment; zeolite},
	keywords = {construction material; greenhouse gas; life cycle analysis; nuclear magnetic resonance; polymer; scanning electron microscopy; X-ray diffraction; zeolite},
	correspondence_address = {S. Amari; Julius Kruttschnitt Mineral Research Centre, Sustainable Minerals Institute (SMI), The University of Queensland (UQ), Brisbane, 4068, Australia; email: s.amari@uq.edu.au},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 12; All Open Access, Gold Open Access}
}

@ARTICLE{Simon202312251,
	author = {Simon, Timothy R. and Inman, Daniel and Hanes, Rebecca and Avery, Gregory and Hettinger, Dylan and Heath, Garvin},
	title = {Life Cycle Assessment of Closed-Loop Pumped Storage Hydropower in the United States},
	year = {2023},
	journal = {Environmental Science and Technology},
	volume = {57},
	number = {33},
	pages = {12251 – 12258},
	doi = {10.1021/acs.est.2c09189},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85168428598&doi=10.1021%2facs.est.2c09189&partnerID=40&md5=8dc751e59ce9008eca77414ea3320133},
	abstract = {The United States has begun unprecedented efforts to decarbonize all sectors of the economy by 2050, requiring rapid deployment of variable renewable energy technologies and grid-scale energy storage. Pumped storage hydropower (PSH) is an established technology capable of providing grid-scale energy storage and grid resilience. There is limited information about the life cycle of greenhouse gas emissions associated with state-of-the-industry PSH technologies. The objective of this study is to perform a full life cycle assessment of new closed-loop PSH in the United States and assess the global warming potential (GWP) attributed to 1 kWh of stored electricity delivered to the nearest grid substation connection point. For this study, we use publicly available data from PSH facilities that are in the preliminary permitting phase. The modeling boundary is from facility construction to decommissioning. Our results estimate that the GWP of closed-loop PSH in the United States ranges from 58 to 530 g CO2e kWh-1, with the stored electricity grid mix having the largest impact, followed by concrete used in facility construction. Additionally, PSH site characteristics can have a substantive impact on GWP, with brownfield sites resulting in a 20% lower GWP compared to greenfield sites. Our results suggest that closed-loop PSH offers climate benefits over other energy storage technologies. © 2023 The Authors. Published by American Chemical Society.},
	author_keywords = {energy storage; energy sustainability; greenhouse gas emissions; hydroelectric; life cycle assessment; pumped storage hydropower; waterpower},
	keywords = {Animals; Climate; Global Warming; Greenhouse Gases; Life Cycle Stages; Renewable Energy; United States; United States; Digital storage; Electric energy storage; Electric substations; Gas emissions; Global warming; Greenhouse gases; Hydroelectric power; Pumped storage power plants; Closed-loop; Energy sustainability; Global warming potential; Greenhouse gas emissions; Grid scale; Hydroelectric; Life cycle assessment; Pumped Storage; Pumped storage hydropower; Waterpower; alternative energy; electricity; energy storage; greenhouse gas; hydroelectric power; life cycle analysis; sustainability; article; carbon dioxide equivalent; climate; electricity; global warming potential; greenhouse gas emission; hydropower; life cycle assessment; United States; animal; greenhouse effect; greenhouse gas; life cycle stage; renewable energy; United States; Life cycle},
	correspondence_address = {D. Inman; The Strategic Energy Analysis Center, National Renewable Energy Laboratory, Golden, 15013 Denver West Parkway, 80401, United States; email: daniel.inman@nrel.gov},
	language = {English},
