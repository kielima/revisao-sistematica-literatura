	title = {Eco-efficiency assessment of long-life asphalt pavement technologies},
	year = {2023},
	journal = {Transportation Research Part D: Transport and Environment},
	volume = {122},
	doi = {10.1016/j.trd.2023.103874},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85169601412&doi=10.1016%2fj.trd.2023.103874&partnerID=40&md5=2ba7a2aca59b8509f3b5e00a2d387de9},
	abstract = {This paper presents a comprehensive eco-efficiency assessment for six promising long-life asphalt pavement (LLAP) designs as a structural system, including the full-depth (FD), thick asphalt layer (TAL), inverted (Ive), enhanced semi-rigid base (Esemi), composite (CP) and traditional semi-rigid base (Tsemi) asphalt pavement. Results showed that under the baseline design scenario, the Ive, ESemi and CP perform best in terms of greenhouse gas (GHG) emissions, total embodied energy (TEE), and life-cycle cost (LCC), respectively. In most cases of the scenario and uncertainty analyses, ESemi and Ive were the most eco-efficient solutions, although CP may dominate ESemi for a longer design life, whereas the other three designs were dominated by one or more of the abovementioned designs. Among all life-cycle activities, the raw material phase was proved to be the most critical source of GHG (54.2–79.4 %), TEE (41.8–54.9 %), and LCC (72.0–72.9 %), under the system boundary of cradle-to-grave (excluding operation phase). Striking a balance between the thickness of cement-based and asphalt structural layers is the key to achieving sustainable pavement. © 2023 Elsevier Ltd},
	author_keywords = {Eco-efficiency assessment; Greenhouse gas; Life-cycle assessment; Life-cycle cost; Long-life asphalt pavement; Relative quadrant matrix},
	keywords = {Asphalt; Asphalt pavements; Gas emissions; Greenhouse gases; Life cycle; Uncertainty analysis; Eco-efficiency assessments; Embodied energy; Greenhouses gas; Life-cycle assessment; Life-cycle cost; Long life; Long-life asphalt pavement; matrix; Relative quadrant matrix; Semi-rigid base; asphalt; construction method; design; efficiency measurement; greenhouse gas; life cycle analysis; pavement; rigidity; uncertainty analysis; Costs},
	correspondence_address = {W. Chen; Key Laboratory for Special Region Highway Engineering of Ministry of Education, Chang 'an University, Xi 'an, Mid-South Erhuan Road, Shaanxi, 710064, China; email: chris_chenwang@chd.edu.cn},
	language = {English},
