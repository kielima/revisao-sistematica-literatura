	author = {Brailovsky, Peter and Sanchez, Lorena and Subasi, Dilara and Rentsch, Jochen and Preu, Ralf and Nold, Sebastian},
	title = {Photovoltaic Manufacturing Factories and Industrial Site Environmental Impact Assessment},
	year = {2024},
