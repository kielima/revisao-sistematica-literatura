}

@ARTICLE{Colangelo20201790,
	author = {Colangelo, Francesco and Navarro, Tomás Gómez and Farina, Ilenia and Petrillo, Antonella},
	title = {Comparative LCA of concrete with recycled aggregates: a circular economy mindset in Europe},
