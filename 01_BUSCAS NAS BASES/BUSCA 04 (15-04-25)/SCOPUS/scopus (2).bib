@ARTICLE{Lindkvist2018461,
	author = {Lindkvist, Mathias},
	title = {Screening of how the organisation of life cycle nodes influences environmental impacts: A methodology},
	year = {2018},
	journal = {Journal of Cleaner Production},
	volume = {204},
	pages = {461 – 470},
	doi = {10.1016/j.jclepro.2018.09.044},
