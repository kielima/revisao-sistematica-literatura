	author = {Maekawa, Koichi and Fukuura, Naoyuki and Soltani, Masoud},
	title = {Path-dependent high cycle fatigue modeling of joint interfaces in structural concrete},
	year = {2008},
	journal = {Journal of Advanced Concrete Technology},
	volume = {6},
	number = {1},
	pages = {227 – 242},
