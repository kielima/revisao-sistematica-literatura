	title = {Performance of a small-scale construction and demolition waste recycling unit: A case study in northeastern Brazil; [Performance de unidade de pequeno porte para reciclagem de resíduos da construção e demolição: Um estudo de caso na região nordeste do Brasil]},
	year = {2021},
