@CONFERENCE{Wang2021,
	author = {Wang, Weixia and Chang, Yuan},
	title = {The water footprint of permeable sidewalk pavement in China},
	year = {2021},
	journal = {IOP Conference Series: Earth and Environmental Science},
	volume = {636},
	number = {1},
	doi = {10.1088/1755-1315/636/1/012018},
