}

@ARTICLE{Di Capua20211215,
	author = {Di Capua, Salvatore Emanuele and Paolotti, Luisa and Moretti, Elisa and Rocchi, Lucia and Boggia, Antonio},
	title = {Evaluation of the Environmental Sustainability of Hemp as a Building Material, through Life Cycle Assessment},
	year = {2021},
	journal = {Environmental and Climate Technologies},
	volume = {25},
	number = {1},
	pages = {1215 – 1228},
	doi = {10.2478/rtuect-2021-0092},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85122799375&doi=10.2478%2frtuect-2021-0092&partnerID=40&md5=f066e0244643b055993d34fc2f6dfc40},
	abstract = {Environmental issues, especially those related to the over-exploitation of natural resources, are leading towards considering alternative solutions and new approaches, such as the circular economy. Currently, some key elements of the circular economy approach are sustainable procurement of raw materials, improvement of production processes and ecological design, adoption of more sustainable distribution and consumption models, development of secondary raw material markets. This work aims to analyse the use of hemp as a building material, replacing traditional construction materials, but respecting at the same time the thermal, insulating and acoustic characteristics required in the construction of a building. The methodology used was Life Cycle Assessment (LCA), which considered the hemp cultivation phase and the production phase of hemp-lime ("hempcrete") walls. The hempcrete product was compared with two different solutions: A hemp and lime block, and a traditional perforated brick block with external insulation in polystyrene. In particular, the differences among the products in terms of embodied energy and net CO2 emissions were analysed. Results showed that the hempcrete wall had better environmental performances than the other two solutions. © 2021 Salvatore Emanuele Di Capua et al., published by Sciendo.},
	author_keywords = {Building sector; eco-sustainability; hempcrete; Life Cycle Assessment (LCA); natural materials},
	keywords = {Building materials; Ecodesign; Environmental management; Hemp; Lime; Sustainable development; Walls (structural partitions); Buildings materials; Buildings sector; Circular economy; Eco-sustainability; Environmental issues; Environmental sustainability; Hempcrete; Life cycle assessment; Natural materials; Overexploitation; concrete; herb; insulation; life cycle analysis; plant residue; polymer; sustainability; Life cycle},
