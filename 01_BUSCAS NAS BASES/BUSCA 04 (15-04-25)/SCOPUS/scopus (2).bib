	year = {2020},
	journal = {Water (Switzerland)},
	volume = {12},
	number = {2},
	doi = {10.3390/w12020454},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081540577&doi=10.3390%2fw12020454&partnerID=40&md5=02ca895ca3b7410a6a3ee09f4450655a},
	abstract = {As a method for eco-effciency analysis, environmental cost effciency (ECE) indicators have been proposed for the end-of-pie (EOP) systems that referred to the techniques achieving environmental benefit under economic cost. The wastewater treatment plant (WWTP) belongs to the EOP systems; however, few studies used the ECE indicators for the sustainability evaluation. Here, this study first proposed the following processes that had been excluded in the current ECE framework and thus limited the potential application in WWTP: (1) the direct impact of wastewater on receiving water, (2) the migration and transformation of water pollutants affected by the self-purification mechanisms of receiving water. To address the aforementioned processes, this study extended the framework of ECE indicators by means of incorporating the potential growth of microorganisms as the characterization state and integrating the water quality models with the characterization models. To investigate the applicability, a full-scale WWTP was selected as the study case and the eco-effciency of the increasing levels of sewage treatment was evaluated. The case outcome showed that, with the extended ECE indicators, the analysis of eco-effciency could be directly related to the specific locations and could determine the specific distance ranges within which the scenarios changing were considered effcient. Moreover, the eco-effciency could be investigated under more concrete and flexible situations because the extended framework of ECE indicators was able to include more information, such as different types of receiving water or different environmental conditions of certain water body. © 2020 by the authors.},
	author_keywords = {Depletion of dissolved oxygen; Eco-effciency; Life cycle assessment; Wastewater treatment; Water quality model},
	keywords = {Biochemical oxygen demand; Dissolved oxygen; Life cycle; Reclamation; Sewage treatment; Sustainable development; Wastewater treatment; Water pollution; Water quality; Water treatment; Eco-effciency; Environmental benefits; Environmental conditions; Life Cycle Assessment (LCA); Sustainability evaluations; Wastewater treatment plants; Water quality modeling; Water quality models; dissolved oxygen; efficiency measurement; environmental conditions; life cycle analysis; self purification; sewage treatment; wastewater; wastewater treatment; wastewater treatment plant; water quality; Cost benefit analysis},
