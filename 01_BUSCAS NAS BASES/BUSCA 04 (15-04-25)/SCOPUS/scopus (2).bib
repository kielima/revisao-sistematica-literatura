@ARTICLE{Navarro2018698,
	author = {Navarro, Ignacio J. and Yepes, Víctor and Martí, José V. and González-Vidosa, Fernando},
	title = {Life cycle impact assessment of corrosion preventive designs applied to prestressed concrete bridge decks},
	year = {2018},
	journal = {Journal of Cleaner Production},
	volume = {196},
	pages = {698 – 713},
	doi = {10.1016/j.jclepro.2018.06.110},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85049333430&doi=10.1016%2fj.jclepro.2018.06.110&partnerID=40&md5=08554fb89ee3854bb466f1c28b534cae},
	abstract = {Chloride corrosion of reinforcing steel in concrete structures is a major issue in the construction sector due to economic and environmental reasons. Assuming different prevention strategies in aggressive marine environments results in extending the service life of the exposed structures, reducing the maintenance actions required throughout their operation stage. The aim of the present study is to analyze the environmental implications of several prevention strategies through a life cycle assessment using a prestressed bridge deck as a case study. The environmental impacts of 15 prevention alternatives have been evaluated when applied to a real case of study, namely a bridge deck exposed to a chloride laden surrounding. The Eco-indicator 99 methodology has been adopted for the evaluation of the impacts. As some of the alternatives involve the use of by-products such as fly ash and silica fume, economic allocation has been assumed to evaluate their environmental impacts. Results from the life cycle analysis show that the environmental impacts of the chloride exposed structure can be reduced significantly by considering specific preventive designs, such as adding silica fume to concrete, reducing its water to cement ratio or applying hydrophobic or sealant treatments to its surface. In such scenarios, the damage caused to the environment mainly due to maintenance operations and material consumption can be reduced up to a 30–40% of the life cycle impacts associated to a conventional design. The study shows how the application of life cycle assessment methodologies can be of interest to reduce the environmental impacts derived from the maintenance operations required by bridge decks subjected to aggressive chloride laden environments. © 2018 Elsevier Ltd},
	author_keywords = {Bridge deck; Chloride corrosion; Concrete; Eco-indicator 99; Life cycle assessment; Preventive measures; Sustainable design},
	keywords = {Bridge decks; Chlorine compounds; Concretes; Condition monitoring; Construction industry; Corrosion prevention; Ecodesign; Fly ash; Maintenance; Marine engineering; Prestressed concrete; Silica fume; Steel corrosion; Sustainable development; Chloride corrosion; Eco-Indicator 99; Environmental implications; Life Cycle Assessment (LCA); Life cycle impact assessment; Maintenance operations; Preventive measures; Water to cement (binder) ratios; Life cycle},
	correspondence_address = {V. Yepes; Institute of Concrete Science and Technology (ICITECH), Universitat Politècnica de València, Valencia, 46022, Spain; email: vyepesp@cst.upv.es},
	language = {English},
