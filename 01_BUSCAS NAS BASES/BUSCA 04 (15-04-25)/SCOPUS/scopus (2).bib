	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 29; All Open Access, Gold Open Access}
}

@ARTICLE{Pretot2014223,
	author = {Pretot, Sylvie and Collet, Florence and Garnier, Charles},
	title = {Life cycle assessment of a hemp concrete wall: Impact of thickness and coating},
	year = {2014},
	journal = {Building and Environment},
