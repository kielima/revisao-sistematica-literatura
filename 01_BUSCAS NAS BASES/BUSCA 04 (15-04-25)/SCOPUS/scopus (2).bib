@ARTICLE{Palumbo2020,
	author = {Palumbo, Elisabetta and Soust-Verdaguer, Bernardette and Llatas, Carmen and Traverso, Marzia},
	title = {How to obtain accurate environmental impacts at early design stages in BIM when using environmental product declaration. A method to support decision-making},
	year = {2020},
	journal = {Sustainability (Switzerland)},
	volume = {12},
	number = {17},
	doi = {10.3390/SU12176927},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85090756922&doi=10.3390%2fSU12176927&partnerID=40&md5=36ffc8be5ee033c76d4dae1a2dc2b035},
	abstract = {The construction sector plays an important role in moving towards a low-carbon economy. Life cycle assessment (LCA) is considered one of the most effective methods of analytically evaluating environmental profiles and an efficient tool for calculating the environmental impacts in building design-oriented methodologies, such as building information modelling (BIM). At early design stages, generic LCA databases are used to conduct the life cycle inventory (LCI), while detailed stages require more detailed data, such as environmental product declarations (EPDs), namely documents that provide accurate results and precise analyses based on LCA. Limitations are recognized when using EPDs in BIM elements at different levels of development (LOD) in the design stages, especially related to the data consistency and system boundaries of the LCA. This paper presents a method of achieving accurate LCA results, that helps with decision-making and provides support in the selection of building products and materials. The method is validated by its application in the structural concrete of an office building located in Germany. The method defines a safety factor adopted for embodied impacts ("cradle-to-gate"), based on EPD results to predict the environmental impact of BIM elements at different LODs. The results obtained show that by integrating the method to conduct the LCA, the range of errors and possible inconsistencies in the LCA results can be reduced. © 2020 by the authors.},
	author_keywords = {BIM (building information modelling); Building sustainability; Early design stages; Environmental product declaration (EPD); From cradle to gate; LCA (life cycle assessment); LOD (level of development)},
	keywords = {Germany; construction industry; decision making; design method; emission inventory; environmental assessment; environmental impact; life cycle analysis; methodology; product development},
	correspondence_address = {E. Palumbo; Institute of Sustainability in Civil Engineering (INaB), RWTH Aachen University, Aachen, D-52074, Germany; email: elisabetta.palumbo@inab.rwth-aachen.de},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 58; All Open Access, Gold Open Access, Green Open Access}
}

@ARTICLE{DeRousseau2020,
	author = {DeRousseau, M.A. and Arehart, J.H. and Kasprzyk, J.R. and Srubar, W.V.},
	title = {Statistical variation in the embodied carbon of concrete mixtures},
	year = {2020},
	journal = {Journal of Cleaner Production},
	volume = {275},
	doi = {10.1016/j.jclepro.2020.123088},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85088903464&doi=10.1016%2fj.jclepro.2020.123088&partnerID=40&md5=6b0077897b6fe505d8a74ec4ba0a0993},
	abstract = {This study presents a refined calculation of the embodied carbon of concrete mixtures via life cycle assessment (LCA) with an explicit focus on three innovations. First, probability distributions that represent process-related variability in the embodied carbon of concrete are calculated using a variety of life cycle inventory data sources. Second, the traditional concrete LCA system boundary (i.e., cradle-to-gate) is expanded to incorporate and analyze estimates of in situ carbon sequestration via concrete carbonation. Third, we analyze the impact of different transportation scenarios on the utility of using fly ash to reduce the embodied carbon of concrete. We use these data to heuristically determine the breakeven transportation distance for fly ash via trucking to be 2655 km for domestic sources of fly ash. However, when fly ash is imported from international sources, reductions to embodied carbon attributed to fly ash replacement can be negligible. The calculated breakeven maritime shipping distance for fly ash equals 15,110 km—beyond which, the anticipated embodied carbon reductions due to fly ash use in concrete are compromised due to transportation. The advancements described herein enable improved scenario-based decision-making for understanding, quantifying, and reducing the embodied carbon of concrete mixtures. In addition, the results highlight the importance of accounting for international transportation of fly ash in LCAs, especially given that domestic sources of quality fly ash are expected to continue to decline and imports are expected to increase in many parts of the world over the next few decades. © 2020 Elsevier Ltd},
	author_keywords = {Concrete; Embodied carbon; Fly ash; Life cycle assessment; Transportation; Variability},
	keywords = {Carbon; Decision making; Fly ash; Life cycle; Mixtures; Probability distributions; Trucks; Carbon sequestration; Concrete carbonation; Life Cycle Assessment (LCA); Life cycle inventory datum; Maritime shipping; Statistical variations; Transportation distance; Transportation scenario; Concrete mixtures},
	correspondence_address = {W.V. Srubar; Department of Civil, Environmental, and Architectural Engineering, Boulder, 1111 Engineering Drive, UCB 428, 80309, United States; email: wsrubar@colorado.edu},
	language = {English},
