	title = {Use of recycled concrete aggregates from precast block for the production of new building blocks: An industrial scale study},
	year = {2020},
	journal = {Resources, Conservation and Recycling},
	volume = {157},
	doi = {10.1016/j.resconrec.2020.104786},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85080983319&doi=10.1016%2fj.resconrec.2020.104786&partnerID=40&md5=22e73cde4f8e1a4caa4faf4545f14a9b},
	abstract = {Large amounts of construction and demolition (C&D) waste are generated annually and will increase in the future. Until now, only a small fraction of concrete by-products is re-used as recycled concrete aggregates (RCA) for the manufacture of concrete. In this paper, the feasibility of using RCA obtained from old precast concrete block was investigated for the industrial scale production of new blocks. Concrete building blocks with different substitution rates (0%, 30% and 100%) of natural aggregates (NA) by the same volume fraction of RCA were manufactured in a factory and the mechanical properties and durability of concrete blocks were monitored. The results show that incorporating RCA slightly decreases the compressive strength and impairs the durability of concrete blocks. However, the compressive strength of concrete blocks made with 100% RCA could reach 11.1 MPa after 28 days, which is within the requirement in Belgian codes for this type of block. The concrete blocks produced with 30% and 100% of RCA reached the strength, capillary water absorption, drying shrinkage and freeze-thaw resistance requirements for concrete blocks specified by Belgian codes. A cradle-to-gate life cycle assessment (LCA) was performed on both "classical" blocks with only NA and with substitution of NA by RCA. When considering the additional use of RCA from a nearby C&D waste recycling centre, the substitution of 30% or 100% of NA by RCA led to a reduction in the land use category, in addition to supporting the implementation of the circular economy. © 2020 Elsevier B.V.},
	author_keywords = {Concrete blocks; Construction and demolition waste; Durability; Life cycle assessment; Mechanical properties; Recycled concrete aggregates},
	keywords = {Compressive strength; Concrete aggregates; Concrete industry; Demolition; Durability; Economics; Land use; Life cycle; Mechanical properties; Precast concrete; Recycling; Shrinkage; Water absorption; concrete; recycled concrete aggregate; unclassified drug; Capillary water absorption; Compressive strength of concrete; Construction and demolition; Construction and demolition waste; Durability of concretes; Industrial-scale production; Life Cycle Assessment (LCA); Recycled concrete aggregates; aggregate; concrete; construction material; durability; feasibility study; life cycle analysis; mechanical property; recycling; solid waste; Article; capillary water absorption; compressive strength; construction and demolition waste; controlled study; drying shrinkage; durability; environmental impact; feasibility study; freeze thaw resistance; hardened density; industrial production; life cycle assessment; mechanical property; particle size; physical parameters; physical phenomena; recycling; water absorption; Concrete blocks},
