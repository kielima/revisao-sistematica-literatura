@ARTICLE{Petit-Boix2015194,
	author = {Petit-Boix, Anna and Sevigné-Itoiz, Eva and Rojas-Gutierrez, Lorena Avelina and Barbassa, Ademir Paceli and Josa, Alejandro and Rieradevall, Joan and Gabarrell, Xavier},
