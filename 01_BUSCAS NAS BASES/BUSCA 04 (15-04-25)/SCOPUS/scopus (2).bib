@ARTICLE{Zirps2020,
	author = {Zirps, Melissa and Lepech, Michael and Savage, Sam and Michel, Alexander and Stang, Henrik and Geiker, Mette},
	title = {Probabilistic Design of Sustainable Reinforced Concrete Infrastructure Repairs Using SIPmath},
	year = {2020},
	journal = {Frontiers in Built Environment},
