@ARTICLE{Kim2018,
	author = {Kim, Yoo-Jae and van Leeuwen, Ryno and Cho, Bum-Yean and Sriraman, Vedaraman and Torres, Anthony},
	title = {Evaluation of the efficiency of limestone powder in concrete and the effects on the environment},
	year = {2018},
	journal = {Sustainability (Switzerland)},
	volume = {10},
