}

@ARTICLE{Kastiukas2020,
	author = {Kastiukas, Gediminas and Ruan, Shaoqin and Liang, Shuang and Zhou, Xiangming},
	title = {Development of precast geopolymer concrete via oven and microwave radiation curing with an environmental assessment},
	year = {2020},
	journal = {Journal of Cleaner Production},
	volume = {255},
