}

@CONFERENCE{Sánchez2019,
	author = {Sánchez, S. and Cancio, Y. and Sánchez, I.R. and Martirena, J.F. and Rosa, E.R. and Habert, G.},
	title = {Sustainability assessment in Cuban cement sector- a methodological approach},
	year = {2019},
	journal = {IOP Conference Series: Earth and Environmental Science},
	volume = {323},
	number = {1},
	doi = {10.1088/1755-1315/323/1/012128},
