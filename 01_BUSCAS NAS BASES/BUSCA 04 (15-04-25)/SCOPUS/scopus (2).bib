@ARTICLE{Gallagher201511,
	author = {Gallagher, John and Styles, David and McNabola, Aonghus and Williams, A. Prysor},
	title = {Making green technology greener: Achieving a balance between carbon and resource savings through ecodesign in hydropower systems},
	year = {2015},
	journal = {Resources, Conservation and Recycling},
	volume = {105},
	pages = {11 – 17},
	doi = {10.1016/j.resconrec.2015.10.015},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84945978294&doi=10.1016%2fj.resconrec.2015.10.015&partnerID=40&md5=5a19ccf467f761490cf518a7762dead4},
	abstract = {Renewable energy systems reduce the greenhouse gas (GHG) emissions associated with energy generation. However, we live in a world with depleting reserves of natural resources, and significant quantities of raw materials are often embodied within renewable energy infrastructure. This paper examines the potential for ecodesign measures to improve the GHG and resource balance of five small-scale hydropower case studies (50-650 kW). A life cycle assessment (LCA) approach compares two specific environmental impact categories: global warming potential (GWP) and abiotic resource depletion potential (ARDP). A number of ecodesign measures were examined for each installation: powerhouse structure, concrete selection, roofing materials, excavation work and transportation. Ecodesign led to cumulative savings of between 2.1% and 10.4% for GWP, and ARDP savings of between 0.1% and 2.6%, for the hydropower installations. Small savings were made with each ecodesign measure applied in all case studies. Furthermore, applying a 1% materiality threshold as outlined by LCA standards was shown to under-estimate the total project burdens, and to neglect opportunities for burden savings through ecodesign. Ecodesign can promote the use of locally sourced materials and some measures can lead to time savings during the construction process. The findings demonstrate the potential for ecodesign to modestly improve the carbon and resource efficiency of hydropower projects. © 2015 Elsevier B.V. All rights reserved.},
	author_keywords = {Abiotic resource depletion; Cradle-to-operation; Ecodesign; Environmental burdens; Global warming potential; Life cycle assessment},
	keywords = {Environmental impact; Gas emissions; Global warming; Greenhouse gases; Hydroelectric power; Life cycle; Materials handling; Natural resources; Renewable energy resources; Roofs; carbon; Cradle-to-operation; Environmental burdens; Global warming potential; Life Cycle Assessment (LCA); Resource depletion; carbon balance; emission control; environmental impact assessment; global warming; greenhouse gas; hydroelectric power; life cycle analysis; renewable resource; resource depletion; resource economy; abiotic resource depletion potential; Article; carbon footprint; concrete selection; construction work; controlled study; ecodesign; environmental impact; environmental parameters; excavation work and transportation; global warming potential; greenhouse effect; hydropower; life cycle assessment; measurement accuracy; powerhouse structure; process design; roofing material; Ecodesign},
