	author = {Ramagiri, Kruthi Kiran and Chintha, Ravali and Bandlamudi, Radha Kiranmaye and Kara De Maeijer, Patricia and Kar, Arkamitra},
	title = {Cradle-to-gate life cycle and economic assessment of sustainable concrete mixes—alkali-activated concrete (Aac) and bacterial concrete (bc)},
	year = {2021},
