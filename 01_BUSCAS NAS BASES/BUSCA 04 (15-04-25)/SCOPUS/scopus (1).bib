	keywords = {Carbon dioxide; Concrete aggregates; Demolition; Eutrophication; Fire resistance; Land fill; Light weight concrete; Ozone; Ozone layer; Recycling; Water; Water absorption; autoclaved aerated concrete; concrete; unclassified drug; Autoclaved aerated concrete; Circular economy; Concrete recycling; Environmental accountings; Industrial ecology; Landfilling; Life cycle assessment; Post-demolition autoclaved aerated concrete; Primary production; Recycling options; comparative study; concrete; demolition; industrial ecology; landfill; life cycle analysis; recycling; acidification; Article; carcinogenicity; construction and demolition waste; controlled study; ecological procedures; ecotoxicity; environmental accounting; environmental aspects and related phenomena; environmental impact; eutrophication; fossil; freshwater ecotoxicity; landfill; life cycle assessment; Monte Carlo method; ozone layer; photochemistry; recycling; sensitivity analysis; uncertainty; Life cycle},
	correspondence_address = {R. Volk; Karlsruhe Institute of Technology (KIT), Institute for Industrial Production (IIP), Karlsruhe, Hertzstraße 16; email: rebekka.volk@kit.edu},
