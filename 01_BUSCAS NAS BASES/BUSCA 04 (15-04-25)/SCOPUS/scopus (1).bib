}

@ARTICLE{Czernik202214,
	author = {Czernik, Sebastian and Michałowski, Bartosz and Tomaszewska, Justyna and Michalak, Jacek},
	title = {The influence of cement on the environmental performance of construction products on the example of cementitious adhesives – External Thermal Insulation Composite Systems [ETICS] components; [Wpływ cementu na charakterystykę środowiskową wyrobów budowlanych na przykładzie klejów cementowych – składników złożonych systemów izolacji cieplnej ETICS]},
	year = {2022},
	journal = {Cement, Wapno, Beton},
	volume = {27},
	number = {1},
	pages = {14 – 31},
	doi = {10.32047/CWB.2022.27.1.2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85135252007&doi=10.32047%2fCWB.2022.27.1.2&partnerID=40&md5=25cbc1f2d207ede6261783eae61f96ee},
	abstract = {The construction sector is one of the branches of the economy with a significant impact on the environment. It uses a vast amount of different raw materials. Also, it produces substantial amounts of waste and emits high amounts of greenhouse gases into the atmosphere. Reducing the energy consumption and emissivity of buildings, decarbonizing existing energy sources, optimizing the use of renewable energy, and minimizing the carbon footprint of materials and construction works are imperative to counteract climate change. It is also a minimum plan for ensuring sustainable social development. The current environmental policy in the construction sector is insufficient and it results from the legal regulations currently in force. Assessment of construction products for the seventh basic requirement, sustainable use of natural resources, is voluntary and almost always neglected. Assessment tools, such as Type III Environmental Product Declarations [EPDs] for construction products, are not widely used. Moreover, these documents are poorly recognizable among consumers, proving that there is still insufficient environmental awareness. In addition, the emerging differences in environmental impact indicators values specified in environmental declarations, resulting from using differentiated approaches in setting system boundaries or the quality of available generic data, do not support the proper development of knowledge about the impact of construction products on the environment. In this work, an analysis of the environmental impact of cement, which is a component of adhesives used in the External Thermal Insulation Composite System [ETICS], was carried out. The study on four indicators, i.e., global warming potential [GWP], soil and water acidification potential [AP], eutrophication potential [EP], and tropospheric ozone formation potential [POCP], was performed. © 2022, Foundation Cement, Lime, Concrete. All rights reserved.},
	author_keywords = {cement; construction products; environmental impact; ETICS; global warming potential [GWP]; life cycle assessment [LCA]; sustainable building; Type III Environmental Product Declaration [EPD]},
	correspondence_address = {J. Michalak; Research and Development Center, Atlas sp. z o.o., Lodz, 2, Kilińskiego St., 91–421, Poland; email: jmichalak@atlas.com.pl},
	language = {English},
