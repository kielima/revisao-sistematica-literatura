	author = {Aman, Aan Mohammad Nusrat and Selvarajoo, Anurita and Lau, Teck Leong and Chen, Wei-Hsin},
	title = {Biochar as Cement Replacement to Enhance Concrete Composite Properties: A Review},
	year = {2022},
	journal = {Energies},
	volume = {15},
