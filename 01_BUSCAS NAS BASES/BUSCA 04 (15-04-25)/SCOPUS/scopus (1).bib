}

@ARTICLE{Hafez2023,
	author = {Hafez, Hisham and Teirelbar, Ahmed and Tošić, Nikola and Ikumi, Tai and de la Fuente, Albert},
	title = {Data-driven optimization tool for the functional, economic, and environmental properties of blended cement concrete using supplementary cementitious materials},
	year = {2023},
	journal = {Journal of Building Engineering},
	volume = {67},
	doi = {10.1016/j.jobe.2023.106022},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85147451540&doi=10.1016%2fj.jobe.2023.106022&partnerID=40&md5=8f801fe5b90afb3e4a1cd90d99f13df3},
	abstract = {The need to produce more sustainable concrete is proving imminent given the rising environmental concerns facing the industry. Blended cement concrete, based on any of the prominent supplementary cementitious materials (SCMs) such as fly ash, ground granulated blast-furnace slag, silica fume, calcined clay and limestone powder, have proven to be the best candidates for sustainable concrete mixes. However, a reliable sustainability measure includes not only the environmental impact, but also the economic and functional ones. Within these five SCMs, their environmental, economic and functional properties are found to be conflicting at times, making a clear judgement on what would be the optimum mix not a straightforward path. A recent framework and tool for concrete sustainability assessment ECO2, sets a reliable methodology for including the functional performance of a concrete mix depending on project-based specifications. Therefore, in this study, a recently published regression model, Pre-bcc was used to predict the functional properties of a wide grid search of potentially suitable blended cement concrete mixes. Hence, an open access novel genetic algorithm tool “Opt-bcc” was developed and used to optimize the sustainability score of these mixes based on a set selection of user-defined project-specific functional criteria. The optimized mixes using the Opt-bcc model for each strength class were compared against the mix design proposed by other optimization models from the literature and were found to be at least 70% cheaper and of 30% less environmental impact. © 2023 The Authors},
	author_keywords = {Blended cement concrete; Genetic algorithms; Life cycle assessment; Performance-based specifications; Sustainability optimization},
	keywords = {Blast furnaces; Cements; Concrete mixtures; Fly ash; Life cycle; Lime; Regression analysis; Silica fume; Slags; Specifications; Sustainable development; Blended cement; Blended cement concrete; Cement concrete; Environmental property; Functional properties; Life cycle assessment; Optimisations; Performance based specifications; Supplementary cementitious material; Sustainability optimization; Genetic algorithms},
	correspondence_address = {H. Hafez; Laboratory of Construction Materials, École Polytechnique Fédérale de Lausanne, EPFL STI IMX LMC, Lausanne, Station 12, CH-1015, Switzerland; email: hisham.hafez@epfl.ch},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 19; All Open Access, Green Open Access, Hybrid Gold Open Access}
}

