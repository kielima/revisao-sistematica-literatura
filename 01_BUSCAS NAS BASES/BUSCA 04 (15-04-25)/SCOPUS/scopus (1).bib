	author = {Menna Barreto, M.F.F. and Timm, J.F.G. and Passuello, A. and Dal Molin, D.C.C. and Masuero, J.R.},
	title = {Life cycle costs and impacts of massive slabs with varying concrete cover},
	year = {2021},
	journal = {Cleaner Engineering and Technology},
