@ARTICLE{Puettmann2021,
	author = {Puettmann, Maureen and Pierobon, Francesca and Ganguly, Indroneil and Gu, Hongmei and Chen, Cindy and Liang, Shaobo and Jones, Susan and Maples, Ian and Wishnie, Mark},
	title = {Comparative lcas of conventional and mass timber buildings in regions with potential for mass timber penetration},
	year = {2021},
	journal = {Sustainability (Switzerland)},
	volume = {13},
	number = {24},
	doi = {10.3390/su132413987},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85121557502&doi=10.3390%2fsu132413987&partnerID=40&md5=a493e11480e56785bd715949a45bc0ef},
	abstract = {Manufacturing of building materials and construction of buildings make up 11% of the global greenhouse gas emission by sector. Mass timber construction has the potential to reduce greenhouse gas emissions by moving wood into buildings with designs that have traditionally been dominated by steel and concrete. The environmental impacts of mass timber buildings were compared against those of functionally equivalent conventional buildings. Three pairs of buildings were designed for the Pacific Northwest, Northeast and Southeast regions in the United States to conform to mass timber building types with 8, 12, or 18 stories. Conventional buildings constructed with concrete and steel were designed for comparisons with the mass timber buildings. Over all regions and building heights, the mass timber buildings exhibited a reduction in the embodied carbon varying between 22% and 50% compared to the concrete buildings. Embodied carbon per unit of area increased with building height as the quantity of concrete, metals, and other nonrenewable materials increased. Total embodied energy to produce, transport, and construct A1–A5 materials was higher in all mass timber buildings compared to equivalent concrete. Further research is needed to predict the long-term carbon emissions and carbon mitigation potential of mass timber buildings to conventional building materials. © 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
	author_keywords = {Buildings; Embodied carbon; Embodied energy; Life cycle assessment; Mass timber; Northeast and Southeast; Pacific Northwest},
	keywords = {Pacific Northwest; United States; building; comparative study; concrete; emission control; greenhouse gas; timber},
	correspondence_address = {M. Puettmann; The Consortium for Research on Renewable Industrial Materials, Corvallis, 97330, United States; email: maureen@corrim.org},
	language = {English},
	type = {Article},
