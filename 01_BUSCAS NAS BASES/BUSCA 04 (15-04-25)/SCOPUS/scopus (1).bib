@ARTICLE{Rocha2022,
	author = {Rocha, Joaquin Humberto Aquino and de Siqueira, Andréia Arenari and de Oliveira, Marco Antonio Barbosa and Castro, Lucas da Silva and Caldas, Lucas Rosse and Monteiro, Nathalie Barbosa Reis and Toledo Filho, Romildo Dias},
	title = {Circular Bioeconomy in the Amazon Rainforest: Evaluation of Açaí Seed Ash as a Regional Solution for Partial Cement Replacement},
	year = {2022},
