	keywords = {Application programs; Carbon footprint; Concrete aggregates; Concrete mixtures; Environmental impact; Heavy metals; Life cycle; Light weight concrete; Mixtures; Recycling; Sand; Urban growth; Concrete design; Conventional concrete; Economic feasibilities; Financial assets; Fresh concrete; Mining process; Mining tailing; Reuse and recycling; Structural applications; Waste production; Compressive strength},
