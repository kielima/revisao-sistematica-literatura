@ARTICLE{Antypa2022,
	author = {Antypa, Despoina and Petrakli, Foteini and Gkika, Anastasia and Voigt, Pamela and Kahnt, Alexander and Böhm, Robert and Suchorzewski, Jan and Araújo, Andreia and Sousa, Susana and Koumoulos, Elias P.},
	title = {Life Cycle Assessment of Advanced Building Components towards NZEBs},
	year = {2022},
	journal = {Sustainability (Switzerland)},
	volume = {14},
	number = {23},
	doi = {10.3390/su142316218},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85143598646&doi=10.3390%2fsu142316218&partnerID=40&md5=ce3626087e7f1d81f40840eac96fd306},
	abstract = {The building sector accounts for 40% of the total energy consumed in Europe at annual basis, together with the relevant Greenhouse Gas (GHG) emissions. In order to mitigate these impacts, the concept and establishment of the Nearly Zero Energy Buildings (NZEBs) is under continuous and intensive research. In fact, as the energy used for buildings’ operation becomes more efficient, impacts resulting from the buildings’ embodied energy become of more importance. Therefore, the selection of building materials and components is of high significance, as these affect the energy performance and potential environmental impacts of the building envelopes. The objective of this study is to perform a preliminary Life Cycle Assessment (LCA) on advanced multifunctional building components, aiming to achieve lower embodied emissions in NZEBs. The advanced components analyzed are composite panels for facade elements of building envelopes, providing thermal efficiency. The design of sustainable building envelope systems is expected to upgrade the overall environmental performance of buildings, including the NZEBs. The findings of this study constitute unambiguous evidence on the need for further research on this topic, as substantial lack of data concerning embodied impacts is presented in literature, adding to the growing discussion on NZEBs at a whole life cycle perspective across Europe. This research has shown that the electricity required from the manufacturing phase of the examined building components is the main contributor to climate change impact and the other environmental categories assessed. Sensitivity analysis that has been performed indicated that the climate change impact is highly depended on the electricity grid energy mix across Europe. Taking into account the current green energy transition by the increase of the renewable energy sources in electricity production, as well as the future upgrade of the manufacturing processes, it is expected that this climate change impact will be mitigated. Finally, the comparison between the CLC thermal insulator and other foam concretes in literature showed that the materials of the building components examined do not present any diversions in terms of environmental impact. © 2022 by the authors.},
	author_keywords = {building components; Life Cycle Assessment; NZEB; sustainability; thermal insulation},
	keywords = {Europe; building construction; climate change; insulation; life cycle analysis; sustainability},
	correspondence_address = {E.P. Koumoulos; IRES—Innovation in Research Engineering Solutions, Wemmel, Rue Koningin Astridlaan 59B, 1780, Belgium; email: epk@innovation-res.eu},
