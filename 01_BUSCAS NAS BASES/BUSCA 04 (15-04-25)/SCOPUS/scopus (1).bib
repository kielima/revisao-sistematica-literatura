	keywords = {Bridge decks; Carbon; Concrete mixtures; Materials handling; Pavements; Repair; Bridge deck pavements; Carbon emissions; Case-studies; Deck pavements; Epoxy asphalt concrete; Epoxy asphalts; Jiangyin Yangtze River Highway Bridge; Life cycle assessment; Mastic asphalt mixture; Second Nanjing Yangtze River Bridge; Life cycle},
	correspondence_address = {J. Yang; School of Transportation, Southeast University, Nanjing, 211189, China; email: yangjun@seu.edu.cn},
	language = {English},
