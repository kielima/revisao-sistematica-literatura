@CONFERENCE{Younis2022SUS,
	author = {Younis, Adel and Dodoo, Ambrose},
	title = {COMPARATIVE CARBON-FOOTPRINT ANALYSIS OF RESIDENTIAL BUILDINGS WITH DIFFERENT STRUCTURAL MATERIALS},
