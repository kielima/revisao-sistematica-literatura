	keywords = {Electrolysis; Electrolytic cells; Emission control; Gas emissions; Gasoline; Greenhouse gases; Hydrogen production; Life cycle; Oxygen; Synthetic fuels; CO2 utilization; Emission reduction; Excess hydrogen; Greenhouse gas emissions; Life cycle assessment; Methanol to gasolines; Operational environments; Power; Power-to-X; Synthetic gasoline; Carbon dioxide},
