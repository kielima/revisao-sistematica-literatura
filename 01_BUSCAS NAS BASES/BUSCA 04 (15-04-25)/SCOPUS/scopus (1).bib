	author = {Eslami, Hooman and Yaghma, Alireza and Jayasinghe, Laddu Bhagya and Waldmann, Daniele},
	title = {INFLUENCE OF DIFFERENT END-OF-LIFE CYCLE SCENARIOS ON THE ENVIRONMENTAL IMPACTS OF TIMBER-CONCRETE COMPOSITE FLOOR SYSTEMS},
	year = {2023},
	journal = {13th World Conference on Timber Engineering, WCTE 2023},
	volume = {2},
