}

@ARTICLE{Shahzad2022198,
	author = {Shahzad, Qamar and Umair, Muhammad and Waqar, Saad},
	title = {Bibliographic analysis on 3D printing in the building and construction industry: Printing systems, material properties, challenges, and future trends},
	year = {2022},
	journal = {Journal of Sustainable Construction Materials and Technologies},
	volume = {7},
	number = {3},
