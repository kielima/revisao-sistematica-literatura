@ARTICLE{Buffenbarger202389,
	author = {Buffenbarger, Julie K. and Casilio, James M. and AzariJafari, Hessam and Szoke, Stephen S.},
	title = {Role of Mixture Overdesign in the Sustainability of Concrete: Current State and Future Perspective},
	year = {2023},
	journal = {ACI Structural Journal},
