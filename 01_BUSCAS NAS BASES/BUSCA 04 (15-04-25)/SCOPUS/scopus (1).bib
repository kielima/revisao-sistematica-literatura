	keywords = {Qatar; Climate change; Concrete mixtures; Construction industry; Economic and social effects; Environmental impact; Foundations; Gas emissions; Greenhouse gases; Life cycle; Recreation centers; Stadiums; Waste disposal; Alternative materials; Conventional concrete; Environmental and economic impacts; Environmental footprints; Environmental life cycle assessment; Material consumption; Raw material consumption; Sustainable construction; building construction; concrete structure; economic cycle; environmental economics; environmental impact; foundation; greenhouse gas; life cycle analysis; waste management; Sustainable development},
