@ARTICLE{Günkaya2023,
	author = {Günkaya, Zerrin and Eris, Zehra Gizem and Özkan, Aysun and Banar, Müfide},
	title = {Prioritization of upcycling and recycling applications for the management of waste printed circuit boards by using S-LCA and MCDM},
	year = {2023},
	journal = {Environmental Research and Technology},
