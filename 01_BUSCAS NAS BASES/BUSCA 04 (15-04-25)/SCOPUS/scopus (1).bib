	year = {2023},
	journal = {Lecture Notes in Mechanical Engineering},
	pages = {240 – 248},
	doi = {10.1007/978-3-031-28839-5_27},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85161462371&doi=10.1007%2f978-3-031-28839-5_27&partnerID=40&md5=92292fe3a9bcaebb7d9e17f9eda205b8},
	abstract = {Energy efficiency and resource economizing are the drivers for the development of new types of material-hybrid design approaches for machine tools. Polymer concrete has been used for machine beds in machine tool design for many years. The good thermal and dynamic properties of the material are particularly convincing in this context. The good damping properties for structural components are also interesting, as this reduces for example tool wear and at the same time the high damping compared to steel structures has a positive effect on the surface quality of the machined workpiece. Current research in the field of structural dynamics is dealing with the substitution of steel and cast components with hybrid, actively preloaded polymer concrete parts. This allows the use of the positive damping properties of polymer concrete and the positive tensile strengths of the integrated fiber-reinforced structures for dynamically loaded machine components such as machine arms or machine stands. The focus of the study is to replace the arm of a bed-type milling machine, which is currently a welded design, with a component made of prestressed carbon fiber-reinforced polymer concrete. Based on the first results of the volume ratios of the structures, conclusions are drawn about the life cycle assessment (cradle to gate) of the components. The results will contribute to a design recommendation for the carbon fiber reinforcement in the polymer concrete arm to achieve a better structural efficiency on the one hand and a better life cycle assessment on the other. © 2023, The Author(s).},
	author_keywords = {CO2 emission; Composite materials; Design optimization},
	keywords = {Bridge decks; Carbon dioxide; Carbon fiber reinforced plastics; Damping; Dynamic loads; Dynamics; Energy efficiency; Machine tools; Reinforced concrete; Steel fibers; Structural dynamics; Tensile strength; CO2 emissions; Composites material; Damping property; Design optimization; Fiber-reinforced polymers; Fibre reinforced polymers; Hybrid design; Machine element; Polymer concretes; Steel components; Life cycle},
	correspondence_address = {K.T. Werkle; Institute for Machine Tools, University of Stuttgart, Stuttgart, Holzgartenstr. 17, 70174, Germany; email: kim.werkle@ifw.uni-stuttgart.de},
