	keywords = {Additives; Binders; Carbon dioxide; Compressive strength; Concrete mixtures; Cost benefit analysis; Energy dispersive spectroscopy; Energy utilization; Gas emissions; Glass; Greenhouse gases; Life cycle; Microstructure; Mixtures; Portland cement; Recycling; Scanning electron microscopy; Silica; Solid wastes; Sustainable development; Thermogravimetric analysis; Water absorption; Cost analysis; Energy-consumption; Finely-powdered glass cullet; Glass cullet; Green concrete; High-proportion fly ash; Life-cycle assessment; Powdered glass; Strength property; Total energy; Fly ash},
	correspondence_address = {M. Amran; Department of Civil Engineering, College of Engineering, Prince Sattam Bin Abdulaziz University, Alkharj, 11942, Saudi Arabia; email: m.amran@psau.edu.sa},
	language = {English},
