	title = {DESIGN AND CRADLE-TO-GRAVE LIFE-CYCLE ASSESSMENT: FULL-SCALE SIX-STORY SHAKE-TABLE TEST BUILDING LATERAL SYSTEMS},
	year = {2023},
	journal = {13th World Conference on Timber Engineering, WCTE 2023},
	volume = {2},
