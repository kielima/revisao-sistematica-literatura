@ARTICLE{Jordan2021692,
	author = {Jordan, Nino David},
	title = {How coordinated sectoral responses to environmental policy increase the availability of product life cycle data},
	year = {2021},
	journal = {International Journal of Life Cycle Assessment},
	volume = {26},
