@ARTICLE{Eleftheriou2022,
	author = {Eleftheriou, Eleni and Lopez Muñoz, Luis Felipe and Habert, Guillaume and Zea Escamilla, Edwin},
	title = {Parametric Approach to Simplified Life Cycle Assessment of Social Housing Projects},
	year = {2022},
	journal = {Sustainability (Switzerland)},
	volume = {14},
	number = {12},
	doi = {10.3390/su14127409},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85132583408&doi=10.3390%2fsu14127409&partnerID=40&md5=a5e68867cfbd5ffaf28cd696d07025f5},
	abstract = {The provision of sustainable housing solutions is one of the main challenges in emerging economy countries. Furthermore, it is clear that a sustainable solution should be based on renewable bio-based materials. Scientific and practical evidence clearly suggests that the use of bamboo in the provision of housing solutions provides communities with both environmental and socio-economic benefits via this strategy. One barrier to the promotion of this type of solution is the lack of knowledge on structural design and environmental performance. Moreover, access to assessment tools and methodologies is limited. The use of simplified Life Cycle Assessment (LCA) has exhibited great potential to increase accessibility, but the generation of life cycle inventory data remains a major issue. In this paper, we describe the development of a methodological approach to use parametric design to generate the data required to carry out simplified LCA of social housing solutions. Moreover, we present a case study assessing a housing unit using cement bamboo frame technology developed by the Base Bahay Foundation in the Philippines. The main parameters for the LCA of the buildings were identified through sensitivity analysis. Moreover, they show that parametric design is a valid approach to overcome the challenges of data generation at early stages of design. The proposed approach would enable users without civil and/or engineering background to carry out simplified LCA calculations. Thus, through methodological approaches, it is possible to reduce significantly the complexity associated with LCA and open new avenues for it application. © 2022 by the authors. Licensee MDPI, Basel, Switzerland.},
	author_keywords = {bamboo; CO<sub>2</sub>; design; environmental impact; LCA},
	keywords = {Philippines; bamboo; environmental economics; environmental impact; life cycle analysis; project assessment; social housing; sustainable development},
