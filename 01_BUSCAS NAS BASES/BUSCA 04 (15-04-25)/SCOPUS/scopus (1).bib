@CONFERENCE{Caspeele202357,
	author = {Caspeele, R. and Botte, W.},
	title = {Bayesian assessment of existing concrete structures: Exploiting the full power of combined information},
	year = {2023},
	journal = {Life-Cycle of Structures and Infrastructure Systems - Proceedings of the 8th International Symposium on Life-Cycle Civil Engineering, IALCCE 2023},
	pages = {57 – 68},
