@ARTICLE{Morsi2022,
	author = {Morsi, Dalia M.A. and Ismaeel, Walaa S.E. and Ehab, Ahmed and Othman, Ayman A.E.},
	title = {BIM-based life cycle assessment for different structural system scenarios of a residential building},
	year = {2022},
	journal = {Ain Shams Engineering Journal},
	volume = {13},
