@ARTICLE{Georgiades2023,
	author = {Georgiades, Maria and Shah, Izhar Hussain and Steubing, Bernhard and Cheeseman, Christopher and Myers, Rupert J.},
	title = {Prospective life cycle assessment of European cement production},
	year = {2023},
	journal = {Resources, Conservation and Recycling},
	volume = {194},
	doi = {10.1016/j.resconrec.2023.106998},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85153228272&doi=10.1016%2fj.resconrec.2023.106998&partnerID=40&md5=4378171f675ab0bc7eed0aa10b9f36ea},
	abstract = {Various measures can be employed to decarbonise cement production, including clinker substitution, alternative fuels, kiln improvements, and carbon capture and storage. In this study, we quantify the CO2-eq. emissions mitigation potentials of these measures on typical cement production in Europe until 2050 using prospective life cycle assessment, including the influence of possible futures of socioeconomic development. We combined environmental product declaration data for cement production with a modified life cycle inventory database (based on ecoinvent v.3.6) that incorporates scenarios developed using the IMAGE (Integrated Model to Assess the Global Environment) integrated assessment model (IAM). The IAM translates socio-economic factors into environmental data that follow Shared Socioeconomic Pathways (e.g., SSP2) to consistently describe possible futures of socio-economic development and environmental change beyond cement production, i.e., the ‘background effects’. The results show that in 2050, cement can be produced with significant CO2-eq. emissions reductions using clinker substitution (42%), alternative fuels (25%), or improved kiln efficiency (12%) relative to 2020. When combined, these measures could reduce CO2-eq. emissions of cement production by ∼58% (excluding carbon capture and storage) and ∼88% (including carbon capture and storage) by 2050 relative to year 2020, which could lower CO2-eq. emissions to as low as 0.09 kg per kg cement by 2050. The effect of using future decarbonisation scenarios for the electricity mix on the results is an additional ∼10% reduction in CO2 -eq. emissions by 2050. Multiple credible pathways exist for the cement sector to achieve and surpass CO2-eq. emissions reductions consistent with global climate targets. © 2023 The Authors},
	author_keywords = {Alternative fuels; Carbon capture and storage; Cement; Decarbonisation; Prospective life cycle assessment; Supplementary cementitious materials},
	keywords = {Europe; Alternative fuels; Carbon capture; Carbon dioxide; Decarbonization; Digital storage; Economic and social effects; Economics; Fuel storage; Life cycle; carbon dioxide; cement; fossil fuel; fuel; Cement production; Decarbonisation; Emission reduction; Emissions mitigation; Integrated assessment models; Possible futures; Prospective life cycle assessment; Prospectives; Socio-economic development; Supplementary cementitious material; alternative fuel; carbon dioxide; carbon emission; carbon sequestration; cement (construction material); economic development; emission control; environmental change; global climate; life cycle analysis; Article; carbon capture; carbon capture and storage; carbon storage; climate change; electricity; electrolysis; European; global climate; greenhouse gas; life cycle; life cycle assessment; nonhuman; prospective study; reliability; socioeconomics; synergistic effect; Cements},
	correspondence_address = {R.J. Myers; Department of Civil and Environmental Engineering, Imperial College London, London, SW7 2AZ, United Kingdom; email: r.myers@imperial.ac.uk},
	language = {English},
