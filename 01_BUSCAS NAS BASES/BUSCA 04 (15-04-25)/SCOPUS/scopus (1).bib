@ARTICLE{Menegatti2022,
	author = {Menegatti, Lucas Caon and Castrillon Fernandez, Letícia Ikeda and Caldas, Lucas Rosse and Pepe, Marco and Pittau, Francesco and Zani, Giulio and Rampini, Marco Carlo and Michels, Julien and Toledo Filho, Romildo Dias and Martinelli, Enzo},
