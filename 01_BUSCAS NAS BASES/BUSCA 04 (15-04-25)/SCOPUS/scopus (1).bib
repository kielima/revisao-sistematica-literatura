@ARTICLE{Liang2021,
	author = {Liang, Shaobo and Gu, Hongmei and Bergman, Richard},
	title = {Environmental life-cycle assessment and life-cycle cost analysis of a high-rise mass timber building: A case study in pacific Northwestern United States},
	year = {2021},
