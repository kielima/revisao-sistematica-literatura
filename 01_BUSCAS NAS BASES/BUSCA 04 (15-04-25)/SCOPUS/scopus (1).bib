@ARTICLE{Esparham2023,
	author = {Esparham, Alireza and Vatin, Nikolai Ivanovich and Kharun, Makhmud and Hematibahar, Mohammad},
	title = {A Study of Modern Eco-Friendly Composite (Geopolymer) Based on Blast Furnace Slag Compared to Conventional Concrete Using the Life Cycle Assessment Approach},
	year = {2023},
	journal = {Infrastructures},
	volume = {8},
	number = {3},
	doi = {10.3390/infrastructures8030058},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85151146053&doi=10.3390%2finfrastructures8030058&partnerID=40&md5=18a4ad551aa7d621e8098fbe21ed1741},
	abstract = {By posing the question of what will be the definition of sustainable development in the future, it can almost be seen that the principle of “no waste” and the production of new materials with less of a negative environmental impact will have a high priority. To further develop environmentally friendly materials, it is necessary to know about the environmental drivers of new materials as well as to evaluate the environmental effects of conventional materials in construction. According to the definitions of sustainable development and sustainable materials, materials with characteristics such as having low energy consumption, sufficient durability, good physical and chemical properties, while simultaneously reducing pollution should be used. Geopolymer materials may be a reasonable option. In this research, two production processes based on blast furnace slag and ordinary concrete (Portland cement) for one cubic meter of geopolymer concrete have been investigated. To investigate, inputs (materials and energy) and outputs (relevant environmental pollutants) of both systems were determined and a life cycle assessment (LCA) was measured using the Center of Environmental Science of Leiden University (CML) and cumulative exergy demand (CED) quantification methods of SimaPro V.9 software. The results showed that the production system of one cubic meter of conventional concrete has maximum environmental effects in all classes except in the destruction of the ozone layer, and the system of producing one cubic meter of geopolymer concrete based on slag has much less environmental effects than the normal concrete system. It also consumes 62% less directly during its lifetime. As a result, geopolymer concrete may be a suitable alternative to traditional concrete as a sustainable material. © 2023 by the authors.},
	author_keywords = {energy consumption; geopolymer; greenhouse gases; life cycle assessment; sustainable development},
	correspondence_address = {A. Esparham; Department of Environmental Engineering, University of Tehran, Karaj, 999067, Iran; email: alireza.esparham@ut.ac.ir; N.I. Vatin; Institute of Civil Engineering, Head of Research Quarter of Peter the Great St. Petersburg Polytechnic University, St. Petersburg, 195251, Russian Federation; email: vatin@mail.ru},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10; All Open Access, Gold Open Access}
}

@ARTICLE{Nasr2023,
	author = {Nasr, Mohammed Salah and Salman, Awham Jumah and Ghayyib, Rusul Jaber and Shubbar, Ali and Al-Mamoori, Shahad and Al-khafaji, Zainab and Hashim, Tameem Mohammed and Hasan, Zaid Ali and Sadique, Monower},
	title = {Effect of Clay Brick Waste Powder on the Fresh and Hardened Properties of Self-Compacting Concrete: State-of-the-Art and Life Cycle Assessment},
	year = {2023},
	journal = {Energies},
	volume = {16},
	number = {12},
	doi = {10.3390/en16124587},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85163892182&doi=10.3390%2fen16124587&partnerID=40&md5=e45cd0e7d2ef6b86479f128f27523a66},
	abstract = {Sustainability and reducing environmental damage caused by CO2 emissions have become issues of interest to researchers in the construction sector around the world. Reducing the cement content in concrete by partially substituting it with by-products or waste falls within this field as the cement industry is responsible for 7% of global CO2 emissions. On the other hand, self-compacting concrete (SCC) is one of the special types of concrete that contains a large amount of powder (most of which is cement) to ensure its flow under the influence of its weight without separating its components. Therefore, to produce eco-friendly SCC, many researchers have replaced part of the cement with clay brick waste powder (CBWP) since brick units are among the most widely used building materials after concrete. Accordingly, this study aims to review previous research that included using CBWP in SCC. The effect of these wastes on the fresh, mechanical, durability and microstructural properties of cement was reviewed. Additionally, a comparison between the environmental impacts of SCCs with different CBWP contents has been conducted using the life cycle assessment (LCA) approach. It was found that the highest value of CBWP that can be used without negatively affecting the different properties of concrete is 10% by weight of cement. Moreover, regarding environmental impact, using CBWP as a substitute for cement reduces environmental damage, and the lowest environmental impact that can be achieved per strength unit (MPa) is 37.5%. © 2023 by the authors.},
	author_keywords = {clay brick waste powder; fresh properties; hardened properties; life cycle assessment; SCC},
	keywords = {Brick; Carbon dioxide; Cements; Construction industry; Environmental impact; Hardening; Self compacting concrete; Sustainable development; Clay brick waste powder; Clay-brick wastes; CO 2 emission; Concrete state; Environmental damage; Fresh and hardened properties; Fresh properties; Hardened properties; Life cycle assessment; State of the art; Life cycle},
	correspondence_address = {A. Shubbar; School of Civil Engineering and Built Environment, Liverpool John Moores University, Liverpool, L3 5UX, United Kingdom; email: a.a.shubbar@ljmu.ac.uk},
	language = {English},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9; All Open Access, Gold Open Access, Green Open Access}
}

