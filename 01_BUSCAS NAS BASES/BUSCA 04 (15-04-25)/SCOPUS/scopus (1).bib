	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85166200336&doi=10.52202%2f069179-0134&partnerID=40&md5=7c1d32763179816cd3edacdbd7e23d92},
	abstract = {Timber-concrete composite (TCC) floor systems attracted attention in the construction industry because of their low environmental impacts while demonstrating decent load-bearing capacity. However, the environmental impacts of possible end-of-life scenarios of TCC floors have not been extensively studied. To address this gap, a comprehensive life cycle assessment (LCA) study was conducted on three different slabs: a Reinforced concrete slab, a Steel concrete composite slab, and a CLT-concrete composite slab. The study revealed that the CLT-concrete composite slab has the lowest Global Warming Potential (GWP) among the three slabs. Subsequently, a more detailed LCA is performed on the CLT-concrete composite slab considering three different end-of-life scenarios of the CLT: 1. Energy recovery via incineration, 2. The prevailing scenario in Europe (a combination of energy recovery, recycling, and disposal), and 3. Reuse. The results show all three scenarios are beneficial in terms of GWP whereas the 3rd scenario is the most beneficial one. © (2023) WORLD CONFERENCE ON TIMBER ENGINEERING 2023 (WCTE 2023) All rights reserved.},
	author_keywords = {Environmental impact; Life cycle assessment; Reusable slab; Timber-concrete composite floor system},
	keywords = {Concrete slabs; Construction industry; Environmental impact; Floors; Forestry; Global warming; Reinforced concrete; Timber; Composite floor systems; Composite slab; Concrete composites; End of lives; Energy recovery; Global warming potential; Life cycle assessment; Reusable slab; Timber-concrete composite floor system; Timber-concrete composites; Life cycle},
	language = {English},
