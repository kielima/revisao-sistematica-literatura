	note = {Cited by: 18; All Open Access, Green Open Access, Hybrid Gold Open Access}
}

@ARTICLE{Sbahieh2022,
	author = {Sbahieh, Sami and Rabie, Mohamed and Ebead, Usama and Al-Ghamdi, Sami G.},
	title = {The Mechanical and Environmental Performance of Fiber-Reinforced Polymers in Concrete Structures: Opportunities, Challenges and Future Directions},
	year = {2022},
	journal = {Buildings},
	volume = {12},
	number = {9},
