@ARTICLE{Ruschi Mendes Saade2022,
	author = {Ruschi Mendes Saade, Marcella and Yahia, Ammar and Amor, Ben},
	title = {Is crushed concrete carbonation significant enough to be considered as a carbon mitigation strategy?},
	year = {2022},
	journal = {Environmental Research Letters},
	volume = {17},
	number = {10},
	doi = {10.1088/1748-9326/ac9490},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140081606&doi=10.1088%2f1748-9326%2fac9490&partnerID=40&md5=dc6487c46c14d208494df5e73cdfb767},
	abstract = {When addressing concrete carbonation as a carbon mitigation option, studies leave out the effect that a temporal difference between the CO2 emissions and uptake happening throughout concrete’s life cycle have on climate change. In this study, the role played by carbonation on concrete’s carbon mitigation potential is investigated through a dynamic life cycle assessment, to properly position CO2 uptake and release. The carbon balance in concrete structures built and demolished from 2018 to 2050 is modelled as a case study. The potential uptake due to crushed concrete carbonation is over 9% of the cumulative global warming effect of concrete manufacturing. It is comparable to the reduction potential of the most promising strategy, namely replacing clinker, totaling 12%. If stimulated in a wide scale, crushed concrete carbonation can push the industry towards meeting carbon mitigation targets faster. Future environmental impact assessments should rely on dynamic models to increasingly consider this phenomenon. © 2022 The Author(s). Published by IOP Publishing Ltd.},
